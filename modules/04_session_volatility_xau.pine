// ============================================================================
// بهبود ۴ : سشن تهران و فیلتر نوسان XAUUSD
// Pine Script v5
// ----------------------------------------------------------------------------
// input.session به‌همراه timezone صریح استفاده شده است؛ بنابراین نتیجه به
// timezone چارت وابسته نیست. xauVolOk عمداً شرط تکراری ندارد.
// ============================================================================

xauSessionString = input.session("0430-0830", "بازه سشن (Asia/Tehran)", group="NTS — فیلترها")
xauGoldenSessionString = input.session("0630-0830", "Golden Hour (Asia/Tehran)", group="NTS — فیلترها")
xauInSession = not useSessionFilter or not na(time(timeframe.period, xauSessionString, "Asia/Tehran"))
xauGoldenHour = not na(time(timeframe.period, xauGoldenSessionString, "Asia/Tehran"))

// در Auto-Tune از ATR نسبی استفاده می‌شود؛ در حالت دستی حداقل ATR٪ کاربر.
xauVolOk = autoTuneThisChart ? atrNorm >= 0.62 : volatilityRatio >= xauMinAtrPctEff
xauTradeOk = xauInSession and xauVolOk
ntsGoldenHourBonus = xauGoldenHour ? 8 : 0
