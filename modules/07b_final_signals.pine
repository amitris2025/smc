// ============================================================================
// بهبود ۷ (ب) : سیگنال‌های نهاییِ تأییدشده
// Pine Script v5
// ----------------------------------------------------------------------------
// آستانهٔ Confluence برای Final الزامی است. سیگنال‌های Extension بازگشتی باید
// جداگانه از continuation تعریف شوند و از ntsSellTrendOk عمومی استفاده نکنند.
// ============================================================================

finalBuySignal = barstate.isconfirmed and ntsCoreReady and ntsTrend == 1 and
     bullishConfirmation and bullishStructureConfirmation and kdBuySignal and
     revBuyOk and xauTradeOk and
     (inNtsBuyFibBand or ntsFibTouchBuy) and
     (not useDailyZoneFilter or inDailyDiscount) and ntsBuyConfluencePts >= ntsBuyThreshold
finalSellSignal = barstate.isconfirmed and ntsCoreReady and ntsTrend == -1 and
     bearishConfirmation and bearishStructureConfirmation and kdSellSignal and
     revSellOk and xauTradeOk and
     (inNtsSellFibBand or ntsFibTouchSell) and
     (not useDailyZoneFilter or inDailyPremium) and ntsSellConfluencePts >= ntsSellThreshold

// برای continuationهای 1.470/2.100 در کد اصلی، Hull و RSI turn نیز لازم هستند.
finalNtsBuy1470 = barstate.isconfirmed and showNtsExtensionSignals and showNtsFib1470 and
     buy1470 and hullBullish and (not ntsUseRsiTurn or ntsRsiTurnUp) and xauTradeOk
finalNtsSell1470 = barstate.isconfirmed and showNtsExtensionSignals and showNtsFib1470 and
     sell1470 and hullBearish and (not ntsUseRsiTurn or ntsRsiTurnDown) and xauTradeOk
