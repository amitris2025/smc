// ============================================================================
// بهبود ۷ (الف) : Premium / Discount از رنج روز قبل + حجم
// Pine Script v5
// ----------------------------------------------------------------------------
// dHighPrev و dLowPrev باید از [high[1], low[1]] تایم‌فریم D بیایند، نه از
// نیمهٔ روز جاری. این تعریف با نواحی رسم‌شده و فیلتر سیگنال یکسان است.
// ============================================================================

dailyZoneEdgePct = input.float(5.0, "عرض لبه روزانه (٪ رنج)", minval=0.0, maxval=25.0, step=0.5,
     group="NTS — فیلترها")
prevDayRange = dHighPrev - dLowPrev
eqLevel = not na(prevDayRange) and prevDayRange > 0 ? (dHighPrev + dLowPrev) / 2.0 : na
inDailyDiscount = not na(prevDayRange) and prevDayRange > 0 and
     close <= dLowPrev + prevDayRange * dailyZoneEdgePct / 100.0
inDailyPremium = not na(prevDayRange) and prevDayRange > 0 and
     close >= dLowPrev + prevDayRange * (1.0 - dailyZoneEdgePct / 100.0)
ntsVolBoost = na(volume) or na(ta.sma(volume, 20)) or volume > ta.sma(volume, 20) * 1.05
