// ============================================================================
// بهبود ۹ (الف) : تشخیص نوع نماد
// Pine Script v5
// ----------------------------------------------------------------------------
// کریپتو قبل از USD بررسی می‌شود تا BTCUSD/ETHUSD/SOLUSD به‌اشتباه Forex نشوند.
// ============================================================================

symU = str.upper(syminfo.ticker + " " + syminfo.basecurrency + " " + syminfo.currency)
autoSymbolType =
     str.contains(symU, "XAU") or str.contains(symU, "GOLD") ? "gold" :
     str.contains(symU, "XAG") ? "silver" :
     str.contains(symU, "BTC") or str.contains(symU, "ETH") or str.contains(symU, "SOL") ? "crypto" :
     (str.contains(symU, "USD") and not str.contains(symU, "USDT")) or
     str.contains(symU, "EUR") or str.contains(symU, "GBP") or str.contains(symU, "JPY") ? "forex" :
     "other"
autoPeriod = autoSymbolType == "gold" ? 10 : autoSymbolType == "silver" ? 12 :
     autoSymbolType == "forex" ? 8 : autoSymbolType == "crypto" ? 14 : 10
autoFactor = autoSymbolType == "gold" ? 3.5 : autoSymbolType == "silver" ? 4.0 :
     autoSymbolType == "forex" ? 3.0 : autoSymbolType == "crypto" ? 5.0 : 3.5
autoMinAtrPct = autoSymbolType == "gold" ? 0.06 : autoSymbolType == "silver" ? 0.08 :
     autoSymbolType == "forex" ? 0.05 : autoSymbolType == "crypto" ? 0.15 : 0.06
xauMinAtrPctEff = autoTuneThisChart ? autoMinAtrPct : xauMinAtrPct
