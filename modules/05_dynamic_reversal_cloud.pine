// ============================================================================
// بهبود ۵ : Reversal Cloud پویا با اعتبار تماس نزدیک
// Pine Script v5
// ----------------------------------------------------------------------------
// صرفِ تماس در ۱۲ کندل گذشته کافی نیست؛ فاصلهٔ فعلی قیمت تا cloudBasis نیز
// کنترل می‌شود تا فیلتر بعد از دورشدن قیمت بی‌دلیل فعال نماند.
// ============================================================================

bandDevFactor = 0.8 + atrNorm * 0.2
bandDev1Dynamic = bandDev1 * bandDevFactor
bandDev2Dynamic = bandDev2 * bandDevFactor
bandDev3Dynamic = bandDev3 * bandDevFactor
upperCloud1 = cloudBasis + cloudRange * bandDev1Dynamic
upperCloud2 = cloudBasis + cloudRange * bandDev2Dynamic
upperCloud3 = cloudBasis + cloudRange * bandDev3Dynamic
lowerCloud1 = cloudBasis - cloudRange * bandDev1Dynamic
lowerCloud2 = cloudBasis - cloudRange * bandDev2Dynamic
lowerCloud3 = cloudBasis - cloudRange * bandDev3Dynamic
inRevSellZone = high >= upperCloud1
inRevBuyZone = low <= lowerCloud1
inRevSellDeep = close >= upperCloud2
inRevBuyDeep = close <= lowerCloud2
revBuyBarsSince = ta.barssince(inRevBuyZone)
revSellBarsSince = ta.barssince(inRevSellZone)
revBuyRecent = not na(revBuyBarsSince) and revBuyBarsSince <= revCloudLookback
revSellRecent = not na(revSellBarsSince) and revSellBarsSince <= revCloudLookback
revBuyNear = close <= cloudBasis + cloudRange * revCloudProximity
revSellNear = close >= cloudBasis - cloudRange * revCloudProximity
revBuyOk = not useReversalCloudFilter or ((inRevBuyZone or revBuyRecent) and revBuyNear)
revSellOk = not useReversalCloudFilter or ((inRevSellZone or revSellRecent) and revSellNear)
