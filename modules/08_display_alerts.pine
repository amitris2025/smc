// ============================================================================
// بهبود ۸ : پنل و هشدارهای کامل NTS
// Pine Script v5
// ----------------------------------------------------------------------------
// هشدار هر گروه Extension مستقل است، اما جفت Buy/Sell هر گروه در یک
// alertcondition جهت‌دار ادغام شده است؛ زیرا هر alertcondition یک plot count
// مصرف می‌کند و سقف ۶۴ تایی TradingView خطای RE10140 («too many plots») می‌دهد.
// لیبل‌های روی چارت (plotshape) دست‌نخورده می‌مانند؛ فقط هشدارها تجمیع شدند.
// ============================================================================

alertcondition(smartDivBullConfirmed or smartDivBearConfirmed,
     title="Smart Divergence Confirmed",
     message="Confirmed divergence + BOS on {{ticker}} | Price: {{close}}")

plot(inDailyDiscount and not inDailyPremium ? 1 : inDailyPremium and not inDailyDiscount ? -1 : 0,
     title="DailyZone", display=display.data_window)
plot(ntsBuyConfluencePts, title="BuyPts", display=display.data_window)
plot(ntsSellConfluencePts, title="SellPts", display=display.data_window)

alertcondition(finalNtsBuy0300 or finalNtsSell0300 or finalNtsBuy1470 or finalNtsSell1470 or
     finalNtsBuy2100 or finalNtsSell2100,
     title="NTS Extension Continuation 0.300/1.470/2.100",
     message="NTS continuation on {{ticker}} | Price: {{close}}")
alertcondition(finalNtsBuy2618_3000 or finalNtsSell2618_3000,
     title="NTS Extension Reversal 2.618/3.000",
     message="NTS reversal 2.618/3.000 on {{ticker}} | Price: {{close}}")
alertcondition(finalNtsBuy4414_4764 or finalNtsSell4414_4764,
     title="NTS Extension Reversal 4.414/4.764",
     message="NTS reversal 4.414/4.764 on {{ticker}} | Price: {{close}}")
alertcondition(finalNtsBuy6618_8618 or finalNtsSell6618_8618,
     title="NTS Extension Reversal 6.618/8.618",
     message="NTS reversal 6.618/8.618 on {{ticker}} | Price: {{close}}")
alertcondition(finalNtsBuy10618 or finalNtsSell10618,
     title="NTS Extension Reversal 10.618",
     message="NTS reversal 10.618 on {{ticker}} | Price: {{close}}")
