// ============================================================================
// بهبود ۸ : پنل و هشدارهای کامل NTS
// Pine Script v5
// ----------------------------------------------------------------------------
// برای هر گروه Extension هشدار مستقل وجود دارد؛ این سیگنال‌ها با Final Trend
// Confluence یکی نیستند. Smart Divergence نیز candidate/confirmed هشدار جدا دارد.
// ============================================================================

alertcondition(smartDivBullConfirmed, title="Smart Confirmed Bullish Reversal",
     message="Confirmed bullish divergence + BOS on {{ticker}} | Price: {{close}}")
alertcondition(smartDivBearConfirmed, title="Smart Confirmed Bearish Reversal",
     message="Confirmed bearish divergence + BOS on {{ticker}} | Price: {{close}}")

plot(inDailyDiscount and not inDailyPremium ? 1 : inDailyPremium and not inDailyDiscount ? -1 : 0,
     title="DailyZone", display=display.data_window)
plot(ntsBuyConfluencePts, title="BuyPts", display=display.data_window)
plot(ntsSellConfluencePts, title="SellPts", display=display.data_window)

alertcondition(finalNtsBuy0300 or finalNtsBuy1470 or finalNtsBuy2100,
     title="NTS Extension Continuation Buy 0.300/1.470/2.100",
     message="NTS continuation BUY on {{ticker}} | Price: {{close}}")
alertcondition(finalNtsSell0300 or finalNtsSell1470 or finalNtsSell2100,
     title="NTS Extension Continuation Sell 0.300/1.470/2.100",
     message="NTS continuation SELL on {{ticker}} | Price: {{close}}")
alertcondition(finalNtsBuy2618_3000, title="NTS Extension Reversal Buy 2.618/3.000",
     message="NTS reversal BUY 2.618/3.000 on {{ticker}} | Price: {{close}}")
alertcondition(finalNtsSell2618_3000, title="NTS Extension Reversal Sell 2.618/3.000",
     message="NTS reversal SELL 2.618/3.000 on {{ticker}} | Price: {{close}}")
alertcondition(finalNtsBuy4414_4764, title="NTS Extension Reversal Buy 4.414/4.764",
     message="NTS reversal BUY 4.414/4.764 on {{ticker}} | Price: {{close}}")
alertcondition(finalNtsSell4414_4764, title="NTS Extension Reversal Sell 4.414/4.764",
     message="NTS reversal SELL 4.414/4.764 on {{ticker}} | Price: {{close}}")
alertcondition(finalNtsBuy6618_8618, title="NTS Extension Reversal Buy 6.618/8.618",
     message="NTS reversal BUY 6.618/8.618 on {{ticker}} | Price: {{close}}")
alertcondition(finalNtsSell6618_8618, title="NTS Extension Reversal Sell 6.618/8.618",
     message="NTS reversal SELL 6.618/8.618 on {{ticker}} | Price: {{close}}")
alertcondition(finalNtsBuy10618, title="NTS Extension Reversal Buy 10.618",
     message="NTS reversal BUY 10.618 on {{ticker}} | Price: {{close}}")
alertcondition(finalNtsSell10618, title="NTS Extension Reversal Sell 10.618",
     message="NTS reversal SELL 10.618 on {{ticker}} | Price: {{close}}")
