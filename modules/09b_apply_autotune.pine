// ============================================================================
// بهبود ۹ (ب) : Auto-Tune ترکیبی با حالت، TF پایه و رژیم
// Pine Script v5
// ----------------------------------------------------------------------------
// نسخهٔ قبلی autoPeriod/autoFactor را کامل جایگزین ntsPeriod می‌کرد. این نسخه
// وزن حالت تریدینگ و ضریب رژیم را حفظ می‌کند.
// ============================================================================

regimePeriodFactor = chopRegime ? 1.20 : trendRegime ? 0.85 : 1.0
regimeFactorFactor = chopRegime ? 1.10 : trendRegime ? 0.95 : 1.0
autoPeriodCombined = autoPeriod * math.max(0.50, math.min(2.0, basePeriod / 10.0)) * regimePeriodFactor
autoFactorCombined = autoFactor * math.max(0.60, math.min(1.80, baseFactor / 3.5)) * regimeFactorFactor
ntsPeriodFinal = autoTuneThisChart ? int(math.round(autoPeriodCombined)) : ntsPeriod
ntsPeriodFinal := math.max(4, math.min(40, ntsPeriodFinal))
ntsFactorFinal = autoTuneThisChart ? autoFactorCombined : ntsFactor
ntsFactorFinal := math.max(1.5, math.min(20.0, ntsFactorFinal))
