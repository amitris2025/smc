// ============================================================================
// بهبود ۲ : True Range و SMA واقعاً در تایم‌فریم پایه NTS
// Pine Script v5
// ----------------------------------------------------------------------------
// این بخش را جایگزین request.securityهای جداگانهٔ High/Low/Close کنید.
// نکتهٔ کلیدی: ta.sma(high - low, 14) داخل expression تایم‌فریم پایه است؛
// بنابراین روی چارت پایین‌تر، تکرار یک کندل HTF باعث خراب‌شدن SMA نمی‌شود.
// خروجی‌ها: ntsHigh, ntsLow, ntsClose, ntsHtfTime, ntsRangeSma,
//            ntsTrueRange, ntsGapUp, ntsGapDown, ntsGapAdjustment
// ============================================================================

ntsTicker = ticker.new(syminfo.prefix, syminfo.ticker)
[ntsHigh, ntsLow, ntsClose, ntsHtfTime, ntsRangeSma] = request.security(
     ntsTicker,
     ntsBaseTimeframe,
     [high, low, close, time, ta.sma(high - low, 14)],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

ntsPrevClose = ntsClose[1]
ntsRawRange = ntsHigh - ntsLow
ntsHiLo = math.min(ntsRawRange, 1.5 * nz(ntsRangeSma, ntsRawRange))
ntsHRef = not na(ntsPrevClose) ? math.abs(ntsHigh - ntsPrevClose) : ntsRawRange
ntsLRef = not na(ntsPrevClose) ? math.abs(ntsLow - ntsPrevClose) : ntsRawRange
ntsGapUp = not na(ntsHigh[1]) and ntsLow > ntsHigh[1]
ntsGapDown = not na(ntsLow[1]) and ntsHigh < ntsLow[1]
ntsGapAdjustment = ntsGapUp ? ntsLow - ntsHigh[1] : ntsGapDown ? ntsLow[1] - ntsHigh : 0.0
ntsTrueRangeRaw = ntsTrailType == "modified" ?
     math.max(ntsHiLo, math.max(ntsHRef, ntsLRef)) :
     math.max(ntsRawRange, math.max(ntsHRef, ntsLRef))
ntsTrueRange = nz(ntsTrueRangeRaw, nz(ntsRawRange, syminfo.mintick)) + ntsGapAdjustment * 0.5

// برای جلوگیری از آپدیت چندبارهٔ state در چارت پایین‌تر:
ntsCurrentTfSeconds = timeframe.in_seconds(timeframe.period)
ntsBaseTfSeconds = timeframe.in_seconds(ntsBaseTimeframe)
ntsSameOrHigher = not na(ntsCurrentTfSeconds) and not na(ntsBaseTfSeconds) and ntsCurrentTfSeconds >= ntsBaseTfSeconds
ntsOnBaseBar = ntsSameOrHigher or na(ntsHtfTime[1]) or (not na(ntsHtfTime) and ntsHtfTime != ntsHtfTime[1])
