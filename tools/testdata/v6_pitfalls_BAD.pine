//@version=6
indicator("x")
int myFlag = 0
float myVal = close
if myVal
    myFlag := 1
x = myFlag ? 1 : 2
y = myVal > 1 ? 3 : 4
z = na(myVal) ? 5 : 6
[pdH, pdL] = request.security(syminfo.tickerid, "D", [high[1], low[1]])
plot(close, offset = myFlag)
line.new(0,0,1,1, style = line.style_solid, style = line.style_dotted)
