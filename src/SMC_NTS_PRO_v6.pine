     tooltip   = "سطوح بسیار دور فقط کمرنگ رسم می‌شوند و سیگنال عملیاتی تولید نمی‌کنند.")
fibPenetrationAtr  = input.float(0.05, "حداقل نفوذ معتبر (× ATR)", minval = 0.0, maxval = 2.0, step = 0.01, group = gFib)
