cloudRecentBars    = input.int(6, "اعتبار تماس اخیر (کندل نمودار)", minval = 1, maxval = 40, group = gCloud)
cloudProximityAtr  = input.float(0.35, "حداکثر فاصله از مبنای ابر (× ATR)", minval = 0.0, maxval = 4.0, step = 0.05, group = gCloud)
cloudVolatilityAdj = input.bool(true, "تنظیم انحراف با نوسان جاری", group = gCloud)

// --- ۰۶ Hull ---
hullSrc            = input.source(close, "منبع Hull", group = gHull)
hullMode           = input.string("Hma", "نوع Hull", options = ["Hma", "Ehma", "Thma"], group = gHull)
hullLen            = input.int(34, "طول Hull", minval = 4, maxval = 300, group = gHull)
hullLenMult        = input.float(1.0, "ضریب طول Hull", minval = 0.5, maxval = 3.0, step = 0.1, group = gHull)
hullUseHtf         = input.bool(false, "تأیید Hull از تایم‌فریم بالاتر", group = gHull,
     tooltip   = "با lookahead_off مقدارِ کندل بسته‌شده تایم‌فریم بالاتر گرفته می‌شود؛ ری‌پینت ندارد.")
