     tooltip   = "موج جاری برای سیگنال عملیاتی؛ موج تکمیل‌شده فقط برای اهداف ثابت و رسم تاریخی.")
fibHistoryWaves    = input.int(2, "تعداد موج تاریخی رسم‌شده", minval = 0, maxval = 6, group = gFib)
