showFibExtB        = input.bool(true, "Ext B — Reversal 2.618 / 3.000", group = gFib, inline = "fb")
sigFibExtB         = input.bool(true, "سیگنال Ext B", group = gFib, inline = "fb")
showFibExtC        = input.bool(true, "Ext C — Reversal 4.414 / 4.764", group = gFib, inline = "fc")
