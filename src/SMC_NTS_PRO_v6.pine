// --- ۰۵ Reversal Cloud ---
cloudEmaLen        = input.int(50, "مبنای ابر (EMA)", minval = 5, maxval = 300, group = gCloud)
cloudAtrLen        = input.int(20, "ATR ابر", minval = 2, maxval = 200, group = gCloud)
