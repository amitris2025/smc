showFibDeepRetr    = input.bool(true, "نمایش Retracement عمیق −0.468 / −0.168", group = gFib, inline = "fg",
     tooltip   = "دو خط کمکی v5 که فقط رسم می‌شوند و سیگنال تولید نمی‌کنند.")
sigFibDeepRetr     = input.bool(false, "سیگنال Retracement عمیق", group = gFib, inline = "fg")
