//@version=6
// ============================================================================
//  SMC + NTS PRO — XAUUSD M15 Multi-Timeframe Confluence Engine
//  Pine Script v6 | نسخه نهایی، یکپارچه و بازنویسی‌شده
// ============================================================================
//
//  معماری (۳۱ ماژول، به ترتیب اجرا):
//    M01  ورودی‌ها و گروه‌بندی تنظیمات
//    M02  توابع کمکی، NaN Guard و مدیریت مرکزی آبجکت‌ها (Object Manager)
//    M03  تشخیص نماد و Auto-Tune ترکیبی
//    M04  دروازه‌های نمایش (Minimal / Standard / Full Analysis)
//    M05  هسته NTS و NTS Trail — کاملاً MTF داخل یک request.security واحد
//    M06  ساختار بازار: Pivot تأییدشده، CHoCH، BOS، Supply / Demand
//    M07  Premium / Equilibrium / Discount روزانه (یک منطق واحد)
//    M08  Reversal Cloud پویا
//    M09  نوسان‌نماهای واحد (RSI / Stoch / MACD / EMA / ATR نمودار)
//    M10  Hull Suite به‌عنوان فیلتر تأیید
//    M11  Smart Divergence با دو وضعیت Pending و Confirmed
//    M12  موتور واحد Fib: Retracement و Extension + واکنش قیمت و Cooldown
//    M13  Session Filter و Volume Filter
//    M14  سطوح مرجع SMC و تشخیص جاروی نقدینگی (Liquidity Sweep)
//    M15  ماتریس تأیید تایم‌فریم بالاتر (MTF Alignment)
//    M16  سیستم امتیازدهی Confluence (Buy و Sell مستقل و متقارن)
//    M17  موتور سیگنال: SETUP / CONFIRMED / PRO BUY / PRO SELL
//    M18  مدیریت ریسک و Trade Plan (Entry / SL / TP / RR)
//    M19  ساختار سشن‌های جهانی (London / New York)
//    M20  موتور خطوط روند خودکار و تاریخی (Price Action)
//    M21  لایه نمایش: پلات‌های Trail، Cloud، PD و Hull
//    M22  رسم سطوح Fib، ناحیه‌های S/D و لیبل سیگنال‌ها
//    M23  تصویرسازی موج NTS و نشانگرهای رویداد (Flip / TL Break)
//    M24  جدول لاگ سیگنال‌ها (اثبات عدم تکرار و عدم تناقض)
//    M25  پنل اطلاعات اصلی
//    M26  (پلات‌های Data Window حذف شد؛ اعداد در پنل نمایش داده می‌شوند)
//    M27  هشدارها: alert() پویا و alertcondition() های ثابت
//    M28  تکمیل پنل: ماتریس HTF، Trade Plan و وضعیت فیلترها
//    M29  آمار روزانه موتور سیگنال
//    M30  ردیف‌های تشخیصی پنل (جای‌گزین پلات‌های Data Window)
//    M31  خودآزمایی داخلی (Invariants) و گزارش وضعیت ضد ری‌پینت
//
//  قراردادهای قطعی این نسخه:
//    1) تمام داده‌های مؤثر بر سیگنال با barmerge.lookahead_off گرفته می‌شوند.
//       هیچ lookahead_on در مسیر سیگنال، Score، فیلتر یا هشدار وجود ندارد.
//    2) تمام سیگنال‌ها فقط روی کندل بسته‌شده (barstate.isconfirmed) صادر می‌شوند.
//    3) اگر تایم‌فریم نمودار پایین‌تر از تایم‌فریم پایه NTS باشد، سیگنال فقط روی
//       اولین کندلِ بعد از بسته‌شدن کندل NTS صادر می‌شود (ntsSampled) تا سیگنال
//       تکراری ساخته نشود.
//    4) قرارداد Fib دقیقاً همان نسخهٔ v5 اصلی است تا خطوط و شکل‌ها همان‌جا
//       قرار بگیرند که در فیلتر اول قرار داشتند:
//         Retracement : level = extreme + (trail - extreme) * ratio       (0..1)
//         Extension   : level = fib1 + dir * |trail - fib1| * (ratio - 1)
//       یعنی مرجع Extensionها سطح ۰٫۶۱۸ (fib1) است و ratio=1 خودِ fib1 است؛
//       0.300 یعنی ۰٫۷ واحد پشت fib1 و 2.618 یعنی ۱٫۶۱۸ واحد جلوی آن.
//       مجموعهٔ نسبت‌ها هم همان v5 است: 0.618/0.786/0.886، ادامه‌روندهای
//       0.300/1.470/2.100، بازگشتی‌های 2.618/3.000، 4.414/4.764، 6.618/8.618،
//       10.618 و دو Retracement عمیق −0.468/−0.168 (فقط رسم، بدون سیگنال).
//       نسبت‌های کمتر از ۱ و دستهٔ ۲ فقط واکنش هم‌جهت تولید می‌کنند و دسته‌های
//       ۴ و ۵ واکنش خلاف‌جهت (خستگی موج) که بدون تأیید ساختاری/واگرایی فعال
//       نمی‌شود.
//    5) برای هر رویداد حداکثر یک سیگنال و حداکثر یک هشدار صادر می‌شود.
//    6) هر line / label / box در استخر اختصاصی همان ماژول ثبت و بازیافت می‌شود؛
//       پاک‌سازی یک ماژول هرگز آبجکت ماژول دیگر را حذف نمی‌کند.
//    7) Period و Factor پویای NTS واقعاً روی محاسبه ATR و Trail اثر می‌گذارند
//       (نه فقط نمایش) و تغییر آن‌ها در هر کندل پایه محدود است.
//    8) Cooldown هر سطح Fib مستقل است و ورودی‌های fibCooldownRetr/Ext اجرایی
//       می‌شوند؛ واحدها به کندل پایه تبدیل می‌شوند تا در LTF درست عمل کنند.
// ============================================================================

// تعریف indicator دقیقاً مطابق فایل اصلی v5 شما (precision=0 و بدون پارامتر
// format) تا ظاهر و قالب نمایش اعداد روی چارت هیچ تغییری نکند.
// نکته: format.mintick در v6 برای پارامتر format تابع indicator() مجاز نیست
// (فقط inherit/price/volume/percent)؛ بنابراین مثل فایل اصلی اصلاً format
// نمی‌دهیم تا رفتار پیش‌فرض format.price با precision=0 حفظ شود.
indicator("SMC + NTS PRO — MTF Confluence Engine [v6]",
     shorttitle        = "NTS PRO v6",
     overlay           = true,
     precision         = 0,
     max_bars_back     = 5000,
     max_lines_count   = 500,
     max_labels_count  = 500,
     max_boxes_count   = 500)

// ============================================================================
//  ▍M01 — ورودی‌ها
// ============================================================================
gCore  = "۰۱ | هسته NTS و Trail (MTF)"
gFib   = "۰۲ | Fib Retracement و Extension"
gStr   = "۰۳ | ساختار بازار — CHoCH و BOS"
gPd    = "۰۴ | Premium / Equilibrium / Discount روزانه"
gCloud = "۰۵ | Reversal Cloud"
gHull  = "۰۶ | Hull Suite — فیلتر تأیید"
gDiv   = "۰۷ | Smart Divergence"
gTl    = "۰۸ | خطوط روند خودکار و تاریخی"
gSes   = "۰۹ | Session و Volume"
gScore = "۱۰ | سیستم امتیازدهی Confluence"
gSig   = "۱۱ | سیگنال‌ها و Cooldown"
gObj   = "۱۲ | مدیریت آبجکت‌ها"
gUi    = "۱۳ | نمایش، پنل و رنگ‌ها"
gAlert = "۱۴ | هشدارها"
gAuto  = "۱۵ | تنظیم خودکار نماد"

// --- ۰۱ هسته NTS ---
ntsTradingMode     = input.string("ترید روزانه", "حالت تریدینگ",
     options   = ["اسکالپینگ", "ترید روزانه", "سوینگ تریدینگ", "پوزیشن تریدینگ"],
     group     = gCore,
     tooltip   = "فقط وزن پیش‌فرض Period/Factor را تغییر می‌دهد؛ منطق ثابت است.")
ntsBaseTimeframe   = input.timeframe("15", "تایم‌فریم پایه NTS", group = gCore,
     tooltip   = "تمام محاسبات NTS (TR, ATR, Trail, Trend, ADX, DI, Regime) در این تایم‌فریم انجام می‌شود.")
ntsTrailType       = input.string("modified", "نوع True Range",
     options   = ["modified", "classic"], group = gCore,
     tooltip   = "modified = High-Low با سقف ۱.۵× میانگین رنج (مناسب گپ طلا)؛ classic = TR استاندارد.")
ntsAtrLen          = input.int(14, "طول Wilder ATR", minval = 2, maxval = 100, group = gCore)
ntsAdxLen          = input.int(14, "طول ADX / DI", minval = 2, maxval = 100, group = gCore)
ntsRangeSmaLen     = input.int(14, "طول میانگین رنج (برای TR اصلاح‌شده)", minval = 2, maxval = 100, group = gCore)
ntsReadyBars       = input.int(30, "کندل پایه لازم برای Warm-up", minval = 5, maxval = 300, group = gCore,
     tooltip   = "تا این تعداد کندل پایه، روند مقداردهی اولیه نمی‌شود و سیگنال صادر نمی‌گردد.")
ntsMildAdx         = input.float(18.0, "آستانه ADX — بازار رنج", minval = 5.0, maxval = 60.0, step = 0.5, group = gCore)
ntsStrongAdx       = input.float(26.0, "آستانه ADX — روند قوی", minval = 10.0, maxval = 80.0, step = 0.5, group = gCore)
ntsRegimeHyst      = input.float(2.0, "هیسترزیس رژیم (جلوگیری از نوسان ADX)", minval = 0.0, maxval = 10.0, step = 0.5, group = gCore)
ntsAtrNormLen      = input.int(100, "طول مرجع ATR نرمال‌شده", minval = 20, maxval = 400, group = gCore)
ntsMinPeriod       = input.int(5, "حداقل Period پویا", minval = 2, maxval = 40, group = gCore)
ntsMaxPeriod       = input.int(34, "حداکثر Period پویا", minval = 5, maxval = 80, group = gCore)
ntsMinFactor       = input.float(1.8, "حداقل Factor پویا", minval = 0.5, maxval = 10.0, step = 0.1, group = gCore)
ntsMaxFactor       = input.float(9.0, "حداکثر Factor پویا", minval = 1.0, maxval = 25.0, step = 0.1, group = gCore)
ntsPeriodDrift     = input.float(0.25, "حداکثر تغییر Period در هر کندل پایه", minval = 0.0, maxval = 2.0, step = 0.05, group = gCore,
     tooltip   = "پارامترهای Adaptive در هر کندل پایه حداکثر به این اندازه جابه‌جا می‌شوند؛ ناپایداری حذف می‌شود.")
ntsFactorDrift     = input.float(0.15, "حداکثر تغییر Factor در هر کندل پایه", minval = 0.0, maxval = 1.0, step = 0.05, group = gCore)
ntsMinWaveAtr      = input.float(1.2, "حداقل اندازه موج (× ATR)", minval = 0.0, maxval = 20.0, step = 0.1, group = gCore,
     tooltip   = "موج‌های کوچک‌تر از این حد معتبر نیستند و Fib از آن‌ها ساخته نمی‌شود.")

// --- ۰۲ Fib ---
fibRetr1           = input.float(0.618, "Retracement ۱", minval = 0.05, maxval = 0.95, step = 0.001, group = gFib)
fibRetr2           = input.float(0.786, "Retracement ۲", minval = 0.05, maxval = 0.98, step = 0.001, group = gFib)
