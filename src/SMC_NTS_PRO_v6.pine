     group     = gFib,
     tooltip   = "برای دسته‌های Deep و Extreme، وضعیت Pending به‌تنهایی کافی نیست.")

// --- ۰۳ ساختار بازار ---
structPivotLen     = input.int(5, "طول Pivot ساختار", minval = 2, maxval = 30, group = gStr)
