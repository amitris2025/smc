minSlopeATR = input.float(0.5, 'حداقل شیب کل خط (ضریب ATR) — ۰ = بدون فیلتر', minval = 0.0, maxval = 10.0,
     step = 0.1, group = gTL,
     tooltip = 'خط‌های تقریباً افقی در واقع «سطح» هستند نه خط روند. ' +
               'مثال: ۰.۵ یعنی اختلاف قیمتِ دو نقطه اتکا باید حداقل نیم ATR باشد.')
linesPerSide = input.int(1, 'تعداد خط برای هر جهت', minval = 1, maxval = 3, group = gTL,
     tooltip = 'خط اول معتبرترین خط است (بیشترین لمس + جدیدترین).')
basisMode = input.string('کلوز (Close) — استاندارد', 'مبنای اعتبارسنجی و شکست',
     options = ['کلوز (Close) — استاندارد', 'سایه (Wick) — سخت‌گیرانه'], group = gTL,
     tooltip = 'مبنای سنجشِ «نقض خط بین دو نقطه اتکا» و «شکست خط»:\n' +
               'کلوز (استاندارد): نفوذ سایه مجاز است، فقط بسته‌شدن کندل آن‌طرف خط مهم است.\n' +
               'سایه (سخت‌گیرانه): حتی سایه هم حق عبور از خط را ندارد.')
atrLen   = input.int(14, 'دوره ATR (مبنای تلورانس)', minval = 1, maxval = 200, group = gTL)
tolMult  = input.float(0.20, 'تلورانس لمس/شکست (ضریب ATR)', minval = 0.0, maxval = 2.0, step = 0.05, group = gTL,
     tooltip = '۰ = کاملاً دقیق. مقدار کوچک (۰.۱ تا ۰.۳) طبیعی‌ترین حالت برای بازار واقعی است.')
maxAnchors = input.int(6, 'حداکثر کاندیدا برای هر نقطه (سرعت اجرا)', minval = 2, maxval = 20, group = gTL)
showBroken  = input.bool(true,  'نمایش خطوط شکسته‌شده (خط‌چین)', group = gTL)
showChannel = input.bool(false, 'رسم کانال موازی', group = gTL)
showTLLabels = input.bool(true, 'نمایش برچسب روی خطوط روند', group = gTL)
showTouchMarks = input.bool(true, 'نشانه‌گذاری نقاط لمس روی خط اصلی', group = gTL)
// ===== اصلاح: اتصال ورودی updateOnClose به شرط به‌روزرسانی =====
updateOnClose = input.bool(true, 'به‌روزرسانی فقط در بسته‌شدن کندل', group = gTL,
     tooltip = 'برای سرعت بهتر روشن بماند. اگر می‌خواهی خط در حین تشکیل کندل هم حرکت کند، خاموش کن.')
showHistory = input.bool(true, 'نمایش خطوط روند گذشته (تاریخچه)', group = gHIST,
     tooltip = 'خطوطی که در گذشته بین دو سقف/کف معتبر شکل گرفته و سپس شکسته شده‌اند؛ ' +
               'هر خط دقیقاً تا کندل شکست کشیده می‌شود (امتداد ندارد).')
maxHistLines = input.int(3, 'تعداد خط گذشته برای هر جهت', minval = 0, maxval = 10, group = gHIST)
histMinGap = input.int(20, 'حداقل فاصله بین انتهای خطوط تاریخی (کندل)', minval = 0, maxval = 300, group = gHIST,
     tooltip = 'جلوگیری از شلوغی: دو خط تاریخی که انتهایشان به هم نزدیک‌تر از این مقدار باشد، همزمان رسم نمی‌شوند.')
histTransp = input.int(55, 'میزان کم‌رنگ بودن خطوط تاریخی', minval = 0, maxval = 90, group = gHIST)
showHistLabels = input.bool(true, 'برچسب روی خطوط تاریخی', group = gHIST)
showBreakMarks = input.bool(true, 'نمایش فلش شکست روی چارت', group = gBRK)
useConfluence = input.bool(true, 'فعال‌سازی سیگنال تلاقی (اختیاری)', group = gSIG,
     tooltip = 'خرید: لمس خط روند صعودی داخل ناحیه دیسکانت روز قبل\nفروش: لمس خط روند نزولی داخل ناحیه پریمیوم روز قبل')
confPremiumTop    = input.float(95.0, 'شروع ناحیه پریمیوم (٪ رنج روزانه)', minval = 50, maxval = 100, step = 0.5, group = gSIG)
confDiscountBottom = input.float(5.0, 'انتهای ناحیه دیسکانت (٪ رنج روزانه)', minval = 0, maxval = 50, step = 0.5, group = gSIG)
tlUpColor     = input.color(#089981, 'رنگ خط روند صعودی', group = gSTY)
tlDownColor   = input.color(#F23645, 'رنگ خط روند نزولی', group = gSTY)
brokenColor = input.color(#787B86, 'رنگ خط شکسته‌شده', group = gSTY)
showPanel   = input.bool(true, 'نمایش پنل اطلاعات', group = gSTY)
bool basisClose = basisMode == 'کلوز (Close) — استاندارد'
// ================================================================================================
// تعریف atrValue (اصلاح خطای کامپایلر)
// ================================================================================================
atrValue = ta.atr(atrLen)
// ================================================================================================
// 2. داده‌های پایه — اصلاح CE10052 با استفاده از array.from
// ================================================================================================
// ===== FIX: اضافه شدن time[0] (آغاز روز جاری) برای محاسبه درست لبه راستِ ناحیه دیروز =====
dailyHighs = request.security(syminfo.tickerid, "D",
     array.from(high[1], high[2], high[3], high[4], high[5], high[6], high[7], high[8], high[9], high[10],
                high[11], high[12], high[13], high[14], high[15], high[16], high[17], high[18], high[19], high[20]),
     lookahead=barmerge.lookahead_on)
dailyLows = request.security(syminfo.tickerid, "D",
     array.from(low[1], low[2], low[3], low[4], low[5], low[6], low[7], low[8], low[9], low[10],
                low[11], low[12], low[13], low[14], low[15], low[16], low[17], low[18], low[19], low[20]),
     lookahead=barmerge.lookahead_on)
dailyTimes = request.security(syminfo.tickerid, "D",
     array.from(time[1], time[2], time[3], time[4], time[5], time[6], time[7], time[8], time[9], time[10],
                time[11], time[12], time[13], time[14], time[15], time[16], time[17], time[18], time[19], time[20]),
     lookahead=barmerge.lookahead_on)
// آغاز روز جاری (برای لبه راستِ ناحیه دیروز وقتی extendZonesToCurrent=false)
todayDailyTime = request.security(syminfo.tickerid, "D", time, lookahead=barmerge.lookahead_on)
// FIX: pdHigh/pdLow قبلاً بالاتر (بخش ۳) تعریف شده‌اند — این تکرار حذف شد تا از بازنویسی جلوگیری شود
// ================================================================================================
// 3. ذخیره‌سازی گرافیکی
// ================================================================================================
var array<box>   premiumBoxes     = array.new<box>()
var array<box>   equilibriumBoxes = array.new<box>()
var array<box>   discountBoxes    = array.new<box>()
var array<line>  tlLines          = array.new<line>()
var array<label> allLabels        = array.new<label>()
// ================================================================================================
// 4. توابع کمکی (بدون نوع‌دهی)
// ================================================================================================
f_clearBoxes(boxesArray) =>
    if array.size(boxesArray) > 0
        for i = array.size(boxesArray) - 1 to 0
            box.delete(array.get(boxesArray, i))
        array.clear(boxesArray)
f_clearLines(linesArray) =>
    if array.size(linesArray) > 0
        for i = array.size(linesArray) - 1 to 0
            line.delete(array.get(linesArray, i))
        array.clear(linesArray)
f_clearLabels(labelsArray) =>
    if array.size(labelsArray) > 0
        for i = array.size(labelsArray) - 1 to 0
            label.delete(array.get(labelsArray, i))
        array.clear(labelsArray)
// ================================================================================================
// اصلاح خطای CE10272 — مقداردهی اولیه و به‌روزرسانی آرایه ATR
// ================================================================================================
var float[] atrHistArr = array.new_float()
if array.size(atrHistArr) == 0
    array.push(atrHistArr, 0.0)
array.push(atrHistArr, nz(atrValue))
if array.size(atrHistArr) > tlLookback + 60
    array.shift(atrHistArr)
// FIX: ایندکس تاریخی اصلاح شد — آرایه از قدیمی به جدید ذخیره می‌شود، offset=0 یعنی کندل جاری
f_atrAt(offset) =>
    int sz = array.size(atrHistArr)
    int idx = math.max(0, math.min(sz - 1, sz - 1 - offset))
    array.get(atrHistArr, idx)
f_tolAt(offset) =>
    f_atrAt(offset) * tolMult
// ================================================================================================
// 5. جستجوی خطوط روند معتبر (بدون var در حلقه)
// ================================================================================================
f_scanLines(bars, prices, isSupport) =>
    int[]   outA   = array.new_int()
    int[]   outB   = array.new_int()
    int[]   outT   = array.new_int()
    int[]   outBrk = array.new_int()
    float[] outS   = array.new_float()
    int   n       = array.size(bars)
    int   lastBar = bar_index
    if n >= 2
        int b = n - 1
        while b >= 1
            int bb   = array.get(bars, b)
            int ageB = lastBar - bb
            if ageB <= tlLookback
                int usedA = 0
                int a     = b - 1
                while a >= 0 and usedA < maxAnchors
                    int ba   = array.get(bars, a)
                    int ageA = lastBar - ba
                    if ageA > tlLookback
                        break
                    if bb - ba >= minSep
                        float pa = array.get(prices, a)
                        float pb = array.get(prices, b)
                        bool  dirOk  = isSupport ? pb > pa : pb < pa
                        float atrB   = f_atrAt(lastBar - bb)
                        bool  slopeOk = minSlopeATR <= 0.0 or math.abs(pb - pa) >= atrB * minSlopeATR
                        if dirOk and slopeOk
                            usedA += 1
                            float slope = (pb - pa) / math.max(1, bb - ba)
                            bool ok = true
                            int   k  = ba + 1
                            while ok and k < bb
                                int   off = lastBar - k
                                float lv  = pa + slope * (k - ba)
                                float tol = f_tolAt(off)
                                float ref = basisClose ? close[off] : (isSupport ? low[off] : high[off])
                                if isSupport
                                    if ref < lv - tol
                                        ok := false
                                else
                                    if ref > lv + tol
                                        ok := false
                                k += 1
                            if ok
                                int brk = na
                                int q   = bb + 1
                                while na(brk) and q <= lastBar
                                    int   offq = lastBar - q
                                    float lq   = pa + slope * (q - ba)
                                    float tolq = f_tolAt(offq)
                                    float rq   = basisClose ? close[offq] : (isSupport ? low[offq] : high[offq])
                                    if isSupport
                                        if rq < lq - tolq
                                            brk := q
                                    else
                                        if rq > lq + tolq
                                            brk := q
                                    q += 1
                                int   endBar = na(brk) ? lastBar : brk
                                int   t      = 0
                                int   m      = 0
                                while m < n
                                    int bm = array.get(bars, m)
                                    if bm >= ba and bm <= endBar
                                        float lm  = pa + slope * (bm - ba)
                                        float tlm = f_tolAt(lastBar - bm)
                                        if math.abs(array.get(prices, m) - lm) <= tlm
                                            t += 1
                                    m += 1
                                if t >= minTouches
                                    float sc = t * 1000.0
                                    if na(brk)
                                        sc += 500.0
                                    else
                                        sc += (1.0 - float(lastBar - brk) / math.max(1.0, float(tlLookback))) * 150.0
                                    sc += (bb - ba) / math.max(1.0, float(lastBar)) * 200.0
                                    sc += (1.0 - float(ageB) / math.max(1.0, float(tlLookback))) * 100.0
                                    array.push(outA,   a)
                                    array.push(outB,   b)
                                    array.push(outT,   t)
                                    array.push(outBrk, brk)
                                    array.push(outS,   sc)
                    a -= 1
            b -= 1
    [outA, outB, outT, outBrk, outS]
// ================================================================================================
// 6. انتخاب N خط برتر
// ================================================================================================
f_pickTop(scores, bs, cbrk, count, allowBroken) =>
    int[] picks = array.new_int()
    int   total = array.size(scores)
    int   c     = 0
    while c < count and c < total
        int   bestI = na
        float bestS = na
        int   i     = 0
        while i < total
            if not array.includes(picks, i)
                bool usable = allowBroken or na(array.get(cbrk, i))
                if usable
                    bool dup = false
                    int   u  = 0
                    while u < array.size(picks) and not dup
                        int pu = array.get(picks, u)
                        if array.get(bs, pu) == array.get(bs, i)
                            dup := true
                        u += 1
                    if not dup
                        float s = array.get(scores, i)
                        if na(bestS) or s > bestS
                            bestS := s
                            bestI := i
            i += 1
        if na(bestI)
            c := count
        else
            array.push(picks, bestI)
        c += 1
    picks
// ================================================================================================
// 6b. انتخاب خطوط تاریخی
// ================================================================================================
f_pickHistory(ca, cb, cbrk, scores, chosen, maxCount, minGap) =>
    int[] picks = array.new_int()
    int[] used  = array.copy(chosen)
    int   total = array.size(scores)
    int   c     = 0
    while c < maxCount and c < total
        int   bestI = na
        float bestS = na
        int   i     = 0
        while i < total
            if not array.includes(used, i)
                int brkI = array.get(cbrk, i)
                if not na(brkI)
                    bool okGap = true
                    int   u    = 0
                    while u < array.size(used) and okGap
                        int pu = array.get(used, u)
                        if array.get(ca, pu) == array.get(ca, i) or array.get(cb, pu) == array.get(cb, i)
                            okGap := false
                        else
                            int brkU = array.get(cbrk, pu)
                            if not na(brkU) and math.abs(brkU - brkI) < minGap
                                okGap := false
                        u += 1
                    if okGap
                        float s = array.get(scores, i)
                        if na(bestS) or s > bestS
                            bestS := s
                            bestI := i
            i += 1
        if na(bestI)
            c := maxCount
        else
            array.push(picks, bestI)
            array.push(used,  bestI)
        c += 1
    picks
// ================================================================================================
// 7. رسم خطوط یک جهت
// ================================================================================================
f_drawSet(isSupport, picks, ca, cb, ct, cbrk, bars, prices, oppBars, oppPrices) =>
    int   cnt     = array.size(picks)
    int   lastBar = bar_index
    color baseCol = isSupport ? tlUpColor : tlDownColor
    int p = 0
    while p < cnt
        int ci     = array.get(picks, p)
        int ai     = array.get(ca, ci)
        int bi     = array.get(cb, ci)
        int ba     = array.get(bars, ai)
        int bb     = array.get(bars, bi)
        float pa   = array.get(prices, ai)
        float pb   = array.get(prices, bi)
        int   tch  = array.get(ct, ci)
        int   brk  = array.get(cbrk, ci)
        bool  brok = not na(brk)
        float slope = (pb - pa) / math.max(1, bb - ba)
        int   x2    = brok ? brk : lastBar
        float y2    = pa + slope * (x2 - ba)
        bool  isPrimary = p == 0
        color lcol = brok ? brokenColor : baseCol
        line ln = line.new(
             x1     = ba,
             y1     = pa,
             x2     = x2,
             y2     = y2,
             xloc   = xloc.bar_index,
             extend = brok ? extend.none : extend.right,
             color  = color.new(lcol, brok ? 30 : 0),
             style  = brok ? line.style_dashed : line.style_solid,
             width  = isPrimary ? 2 : 1)
        array.push(tlLines, ln)
        if showChannel and isPrimary and not brok
            int   ob = na
            float op = na
            int   mi = array.size(oppBars) - 1
            while na(ob) and mi >= 0
                int mb = array.get(oppBars, mi)
                if mb >= ba and mb <= lastBar
                    ob := mb
                    op := array.get(oppPrices, mi)
                mi -= 1
            if not na(ob)
                line lc = line.new(
                     x1 = ob,
                     y1 = op,
                     x2 = lastBar,
                     y2 = op + slope * (lastBar - ob),
                     xloc   = xloc.bar_index,
                     extend = extend.right,
                     color  = color.new(baseCol, 55),
                     style  = line.style_dotted,
                     width  = 1)
                array.push(tlLines, lc)
        if showTouchMarks and isPrimary
            int m = 0
            while m < array.size(bars)
                int bm = array.get(bars, m)
                if bm >= ba and bm <= lastBar
                    float lm  = pa + slope * (bm - ba)
                    float tlm = f_tolAt(lastBar - bm)
                    if math.abs(array.get(prices, m) - lm) <= tlm
                        label lt = label.new(
                             x      = bm,
                             y      = lm,
                             text   = '●',
                             xloc   = xloc.bar_index,
                             yloc   = yloc.price,
                             style  = label.style_label_center,
                             color  = color.new(color.black, 100),
                             textcolor = lcol,
                             size   = size.tiny)
                        array.push(allLabels, lt)
                m += 1
        if showTLLabels
            string txt = (isSupport ? 'صعودی' : 'نزولی') + ' | ' + str.tostring(tch) + ' لمس' +
                 (brok ? ' | شکسته' : '')
            label lb = label.new(
                 x      = x2,
                 y      = y2,
                 text   = txt,
                 xloc   = xloc.bar_index,
                 yloc   = yloc.price,
                 style  = label.style_label_left,
                 color  = color.new(brok ? color.gray : (isSupport ? tlUpColor : tlDownColor), 0),
                 textcolor = color.white,
                 size   = size.tiny)
            array.push(allLabels, lb)
        p += 1
    cnt
// ================================================================================================
// 7b. رسم خطوط روند گذشته
// ================================================================================================
f_drawHistory(isSupport, picks, ca, cb, ct, cbrk, bars, prices) =>
    int   cnt     = array.size(picks)
    int   lastBar = bar_index
    color baseCol = isSupport ? tlUpColor : tlDownColor
    int p = 0
    while p < cnt
        int   ci   = array.get(picks, p)
        int   ai   = array.get(ca, ci)
        int   bi   = array.get(cb, ci)
        int   ba   = array.get(bars, ai)
        int   bb   = array.get(bars, bi)
        float pa   = array.get(prices, ai)
        float pb   = array.get(prices, bi)
        int   brk  = array.get(cbrk, ci)
        int   tch  = array.get(ct, ci)
        float slope = (pb - pa) / math.max(1, bb - ba)
        float yEnd  = pa + slope * (brk - ba)
        line lh = line.new(
             x1     = ba,
             y1     = pa,
             x2     = brk,
             y2     = yEnd,
             xloc   = xloc.bar_index,
             extend = extend.none,
             color  = color.new(baseCol, histTransp),
             style  = line.style_dashed,
             width  = 1)
        array.push(tlLines, lh)
        if showHistLabels
            label lb = label.new(
                 x      = brk,
                 y      = yEnd,
                 text   = 'گذشته | ' + str.tostring(tch) + ' لمس',
                 xloc   = xloc.bar_index,
                 yloc   = yloc.price,
                 style  = label.style_label_left,
                 color  = color.new(baseCol, 70),
                 textcolor = color.white,
                 size   = size.tiny)
            array.push(allLabels, lb)
        p += 1
    cnt
// ================================================================================================
// 8. رسم نواحی روزانه — ===== FIX: رفع CE10156 + باگ لبه راست =====
// ================================================================================================
f_drawDailyZones() =>
    f_clearBoxes(premiumBoxes)
    f_clearBoxes(equilibriumBoxes)
    f_clearBoxes(discountBoxes)
    // ===== FIX 1: اعلام rightTime یک‌بار، قبل از حلقه (جلوگیری از CE10156) =====
    int rightTime = na
    for index = 0 to daysCount - 1
        float previousHigh = array.get(dailyHighs, index)
        float previousLow  = array.get(dailyLows, index)
        int   dayStartTime = array.get(dailyTimes, index)
        // ===== FIX 2: محاسبه درست لبه راست =====
        //   • اگر امتداد تا کندل فعلی: last_bar_time
        //   • برای دیروز (index=0): آغاز روز جاری (todayDailyTime) — قبلاً به‌اشتباه dailyTimes[0]
        //     بود که آغاز همان روز دیروز است و باکس صفر عرض می‌ساخت.
        //   • برای N روز قبل (index>=1): آغاز روز ِبعدیِ نزدیک‌تر به اکنون = dailyTimes[index-1]
        if extendZonesToCurrent
            rightTime := last_bar_time
        else
            rightTime := index == 0 ? todayDailyTime : array.get(dailyTimes, index - 1)
        if not na(previousHigh) and not na(previousLow) and previousHigh > previousLow
            float dailyRange = previousHigh - previousLow
            float premiumTop    = previousHigh
            float premiumBottom = previousLow + dailyRange * 0.95
            float equilibriumTop    = previousLow + dailyRange * 0.525
            float equilibriumBottom = previousLow + dailyRange * 0.475
            float equilibriumMid    = math.avg(previousHigh, previousLow)
            float discountTop    = previousLow + dailyRange * 0.05
            float discountBottom = previousLow
            array.push(premiumBoxes, box.new(
                 left = dayStartTime, top = premiumTop, right = rightTime, bottom = premiumBottom,
                 xloc = xloc.bar_time, bgcolor = premiumColor,
                 border_color = color.new(premiumColor, borderTransparency)))
            array.push(equilibriumBoxes, box.new(
                 left = dayStartTime, top = equilibriumTop, right = rightTime, bottom = equilibriumBottom,
                 xloc = xloc.bar_time, bgcolor = equilibriumColor,
                 border_color = color.new(equilibriumColor, borderTransparency)))
            array.push(discountBoxes, box.new(
                 left = dayStartTime, top = discountTop, right = rightTime, bottom = discountBottom,
                 xloc = xloc.bar_time, bgcolor = discountColor,
                 border_color = color.new(discountColor, borderTransparency)))
            if showZoneLabels
                string dayText = index == 0 ? 'Previous Day' : str.format('{0} Days Ago', index + 1)
                label lp = label.new(
                     x = rightTime, y = premiumTop, text = dayText + ' Premium',
                     xloc = xloc.bar_time, style = label.style_label_down,
                     color = color.new(color.black, 100), textcolor = color.new(premiumColor, 0), size = size.tiny)
                array.push(allLabels, lp)
                label le = label.new(
                     x = rightTime, y = equilibriumMid, text = dayText + ' EQ',
                     xloc = xloc.bar_time, style = label.style_label_left,
                     color = color.new(color.black, 100), textcolor = color.new(equilibriumColor, 0), size = size.tiny)
                array.push(allLabels, le)
                label ld = label.new(
                     x = rightTime, y = discountBottom, text = dayText + ' Discount',
                     xloc = xloc.bar_time, style = label.style_label_up,
                     color = color.new(color.black, 100), textcolor = color.new(discountColor, 0), size = size.tiny)
                array.push(allLabels, ld)
// ================================================================================================
// 9. جمع‌آوری سقف‌ها و کف‌ها
// ================================================================================================
var int[]   pivBar   = array.new_int()
var float[] pivPrice = array.new_float()
var bool[]  pivIsHigh = array.new_bool()
float phValue = ta.pivothigh(swingLeft, swingRight)
float plValue = ta.pivotlow(swingLeft, swingRight)
if not na(phValue)
    array.push(pivBar, bar_index - swingRight)
    array.push(pivPrice, phValue)
    array.push(pivIsHigh, true)
if not na(plValue)
    array.push(pivBar, bar_index - swingRight)
    array.push(pivPrice, plValue)
    array.push(pivIsHigh, false)
while array.size(pivBar) > 0 and bar_index - array.get(pivBar, 0) > math.max(tlLookback, 500)
    array.shift(pivBar)
    array.shift(pivPrice)
    array.shift(pivIsHigh)
// ================================================================================================
// 10. وضعیت خطوط (برای هشدار و سیگنال)
// ================================================================================================
var int   supAnchorBar   = na
var float supAnchorPrice = na
var float supSlope       = na
var int   supTouches     = na
var bool  supBroken      = false
var int   resAnchorBar   = na
var float resAnchorPrice = na
var float resSlope       = na
var int   resTouches     = na
var bool  resBroken      = false
var int   histCount      = 0
// ================================================================================================
// 11. اجرای اصلی (با اعمال updateOnClose)
// ================================================================================================
// FIX: رسم فقط آخرین کندل + فقط در صورت بسته‌شدن وقتی updateOnClose روشن است
bool doRedraw = barstate.islast and (not updateOnClose or barstate.isconfirmed)
if barstate.islast and not showZones and array.size(premiumBoxes) > 0
    f_clearBoxes(premiumBoxes)
    f_clearBoxes(equilibriumBoxes)
    f_clearBoxes(discountBoxes)
if doRedraw
    f_clearLabels(allLabels)
    f_clearLines(tlLines)
    if showZones
        f_drawDailyZones()
    int   pivCount = array.size(pivBar)
    int   markFrom = math.max(0, pivCount - maxSwingMarks)
    float lastH    = na
    float lastL    = na
    int   mi2      = 0
    while mi2 < pivCount
        int   sb  = array.get(pivBar, mi2)
        float sp  = array.get(pivPrice, mi2)
        bool  sh  = array.get(pivIsHigh, mi2)
        string stxt = ''
        color  scol = sh ? (na(lastH) ? color.gray : (sp > lastH ? tlUpColor : tlDownColor)) :
                           (na(lastL) ? color.gray : (sp > lastL ? tlUpColor : tlDownColor))
        stxt := sh ? (na(lastH) ? 'H' : (sp > lastH ? 'HH' : 'LH')) :
                     (na(lastL) ? 'L' : (sp > lastL ? 'HL' : 'LL'))
        if sh
            lastH := sp
        else
            lastL := sp
        if mi2 >= markFrom and (showSwings or showStructure)
            label lm = label.new(
                 x      = sb,
                 y      = sp,
                 text   = showStructure ? stxt : (sh ? '▲' : '▼'),
                 xloc   = xloc.bar_index,
                 yloc   = yloc.price,
                 style  = sh ? label.style_label_upper_left : label.style_label_lower_left,
                 color  = color.new(color.black, 100),
                 textcolor = scol,
                 size   = size.tiny)
            array.push(allLabels, lm)
        mi2 += 1
    int[]   highBars   = array.new_int()
    float[] highPrices = array.new_float()
    int[]   lowBars    = array.new_int()
    float[] lowPrices  = array.new_float()
    int si = 0
    while si < pivCount
        if array.get(pivIsHigh, si)
            array.push(highBars, array.get(pivBar, si))
            array.push(highPrices, array.get(pivPrice, si))
        else
            array.push(lowBars, array.get(pivBar, si))
            array.push(lowPrices, array.get(pivPrice, si))
        si += 1
    [supA, supB, supT, supBrk, supS] = f_scanLines(lowBars, lowPrices, true)
    [resA, resB, resT, resBrk, resS] = f_scanLines(highBars, highPrices, false)
    int[] supPicks = f_pickTop(supS, supB, supBrk, linesPerSide, showBroken)
    int[] resPicks = f_pickTop(resS, resB, resBrk, linesPerSide, showBroken)
    f_drawSet(true,  supPicks, supA, supB, supT, supBrk, lowBars,  lowPrices,  highBars, highPrices)
    f_drawSet(false, resPicks, resA, resB, resT, resBrk, highBars, highPrices, lowBars,  lowPrices)
    int[] supHist = array.new_int()
    int[] resHist = array.new_int()
    if showHistory and maxHistLines > 0
        supHist := f_pickHistory(supA, supB, supBrk, supS, supPicks, maxHistLines, histMinGap)
        resHist := f_pickHistory(resA, resB, resBrk, resS, resPicks, maxHistLines, histMinGap)
        f_drawHistory(true,  supHist, supA, supB, supT, supBrk, lowBars,  lowPrices)
        f_drawHistory(false, resHist, resA, resB, resT, resBrk, highBars, highPrices)
    histCount := array.size(supHist) + array.size(resHist)
    if array.size(supPicks) > 0
        int   ci  = array.get(supPicks, 0)
        int   ai  = array.get(supA, ci)
        int   bi  = array.get(supB, ci)
        int   ba  = array.get(lowBars, ai)
        int   bb  = array.get(lowBars, bi)
        float pa  = array.get(lowPrices, ai)
        float pb  = array.get(lowPrices, bi)
        supAnchorBar   := ba
        supAnchorPrice := pa
        supSlope       := (pb - pa) / math.max(1, bb - ba)
        supTouches     := array.get(supT, ci)
        supBroken      := not na(array.get(supBrk, ci))
    else
        supAnchorBar   := na
        supAnchorPrice := na
        supSlope       := na
        supTouches     := na
        supBroken      := false
    if array.size(resPicks) > 0
        int   ci2 = array.get(resPicks, 0)
        int   ai2 = array.get(resA, ci2)
        int   bi2 = array.get(resB, ci2)
        int   ba2 = array.get(highBars, ai2)
        int   bb2 = array.get(highBars, bi2)
        float pa2 = array.get(highPrices, ai2)
        float pb2 = array.get(highPrices, bi2)
        resAnchorBar   := ba2
        resAnchorPrice := pa2
        resSlope       := (pb2 - pa2) / math.max(1, bb2 - ba2)
        resTouches     := array.get(resT, ci2)
        resBroken      := not na(array.get(resBrk, ci2))
    else
        resAnchorBar   := na
        resAnchorPrice := na
        resSlope       := na
        resTouches     := na
        resBroken      := false
// ================================================================================================
// 12. محاسبه موقعیت فعلی خطوط، لمس و شکست
// ================================================================================================
float tolLive = nz(atrValue) * tolMult
float supNow = na(supAnchorBar) ? float(na) : supAnchorPrice + nz(supSlope) * (bar_index - supAnchorBar)
float resNow = na(resAnchorBar) ? float(na) : resAnchorPrice + nz(resSlope) * (bar_index - resAnchorBar)
bool supTouchNow = not na(supNow) and not supBroken and low  <= supNow + tolLive and low  >= supNow - tolLive and close >= supNow
bool resTouchNow = not na(resNow) and not resBroken and high <= resNow + tolLive and high >= resNow - tolLive and close <= resNow
bool supBreakNow = not na(supNow) and not supBroken and close < supNow - tolLive
bool resBreakNow = not na(resNow) and not resBroken and close > resNow + tolLive
var bool prevSupBreak = false
var bool prevResBreak = false
var bool prevSupTouch = false
var bool prevResTouch = false
bool supBreakEvent = supBreakNow and not prevSupBreak
bool resBreakEvent = resBreakNow and not prevResBreak
bool supTouchEvent = supTouchNow and not prevSupTouch
bool resTouchEvent = resTouchNow and not prevResTouch
prevSupBreak := supBreakNow
prevResBreak := resBreakNow
prevSupTouch := supTouchNow
prevResTouch := resTouchNow
// ================================================================================================
// 13. سیگنال تلاقی خط روند + ناحیه پریمیوم / دیسکانت
// ================================================================================================
float pdRange = pdHigh - pdLow
bool  zoneOk  = not na(pdHigh) and not na(pdLow) and pdRange > 0
bool  inPremium  = zoneOk and close >= pdLow + pdRange * (confPremiumTop / 100.0)
bool  inDiscount = zoneOk and close <= pdLow + pdRange * (confDiscountBottom / 100.0)
bool bullConf = useConfluence and supTouchEvent and inDiscount
bool bearConf = useConfluence and resTouchEvent and inPremium
if barstate.isconfirmed and showBreakMarks and supBreakEvent
    label.new(bar_index, low - atrValue * 0.4, "▼", style = label.style_none,
         color = color.new(color.black, 100), textcolor = tlDownColor, size = size.tiny)
if barstate.isconfirmed and showBreakMarks and resBreakEvent
    label.new(bar_index, high + atrValue * 0.4, "▲", style = label.style_none,
         color = color.new(color.black, 100), textcolor = tlUpColor, size = size.tiny)
if barstate.isconfirmed and bullConf
    label.new(bar_index, low - atrValue * 0.6, "▲", style = label.style_none,
         color = color.new(color.black, 100), textcolor = color.new(#089981, 0), size = size.small)
if barstate.isconfirmed and bearConf
    label.new(bar_index, high + atrValue * 0.6, "▼", style = label.style_none,
         color = color.new(color.black, 100), textcolor = color.new(#F23645, 0), size = size.small)
// ================================================================================================
// 14. هشدارها
// ================================================================================================
alertcondition(supBreakEvent, title = 'شکست خط روند صعودی',
     message = '{{ticker}} | شکست خط روند صعودی ({{interval}}) | قیمت: {{close}}')
alertcondition(resBreakEvent, title = 'شکست خط روند نزولی',
     message = '{{ticker}} | شکست خط روند نزولی ({{interval}}) | قیمت: {{close}}')
alertcondition(bullConf, title = 'تلاقی خرید: خط صعودی + دیسکانت',
     message = '{{ticker}} | لمس خط روند صعودی داخل دیسکانت روز قبل | قیمت: {{close}}')
alertcondition(bearConf, title = 'تلاقی فروش: خط نزولی + پریمیوم',
     message = '{{ticker}} | لمس خط روند نزولی داخل پریمیوم روز قبل | قیمت: {{close}}')
// ================================================================================================
// 15. پنل اطلاعات
// ================================================================================================
var table panel = table.new(position.bottom_right, 2, 7, border_width = 1, frame_width = 1,
     frame_color = color.new(color.gray, 60), border_color = color.new(color.gray, 70))
f_cell(col, row, txt, txtcol) =>
    table.cell(panel, col, row, txt, text_color = txtcol, text_size = size.small,
         bgcolor = color.new(color.black, 20))
if showPanel and barstate.islast
    string zoneTxt = not zoneOk ? '—' : (inPremium ? 'PREMIUM' : (inDiscount ? 'DISCOUNT' : 'EQUILIBRIUM'))
    color  zoneCol = not zoneOk ? color.gray : (inPremium ? tlDownColor : (inDiscount ? tlUpColor : color.gray))
    f_cell(0, 0, 'PD Zones + Trendlines', color.white)
    f_cell(1, 0, syminfo.ticker, color.gray)
    f_cell(0, 1, 'PDH / PDL', color.gray)
    f_cell(1, 1, str.tostring(pdHigh, format.mintick) + '  /  ' + str.tostring(pdLow, format.mintick), color.white)
    f_cell(0, 2, 'ناحیه فعلی', color.gray)
    f_cell(1, 2, zoneTxt, zoneCol)
    f_cell(0, 3, 'خط صعودی', color.gray)
    f_cell(1, 3, na(supAnchorBar) ? 'یافت نشد' :
         str.tostring(supTouches) + ' لمس' + (supBroken ? ' | شکسته' : ' | فعال'),
         supBroken ? brokenColor : tlUpColor)
    f_cell(0, 4, 'خط نزولی', color.gray)
    f_cell(1, 4, na(resAnchorBar) ? 'یافت نشد' :
         str.tostring(resTouches) + ' لمس' + (resBroken ? ' | شکسته' : ' | فعال'),
         resBroken ? brokenColor : tlDownColor)
    f_cell(0, 5, 'خطوط گذشته', color.gray)
    f_cell(1, 5, str.tostring(histCount) + ' خط تاریخی', color.new(color.white, 0))
    f_cell(0, 6, 'ATR(' + str.tostring(atrLen) + ')', color.gray)
    f_cell(1, 6, str.tostring(atrValue, format.mintick), color.white)
else
    if barstate.islast
        table.clear(panel, 0, 0, 1, 6)
//#endregion ======================== 4. PD Zones + PA Trendlines (ادغام‌شده) ========================
