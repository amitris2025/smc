fill(p_ntsTrail, p_ntsFib3, color=ntsTrend == 1 ? fillColorLong : fillColorShort, display=showNtsMain ? display.all : display.none)
plot(showNtsMain ? ntsFib1 : na, color=colorFib1, linewidth=2, title="NTS Fib 1 auto", style=plot.style_line)
plot(showNtsMain ? ntsFib2 : na, color=colorFib2, linewidth=2, title="NTS Fib 2 auto", style=plot.style_line)
// ============================================================================
// Ichimoku Multi-Timeframe
// ============================================================================
[conversionLine, baseLine, leadLine1, leadLine2] = request.security(
     syminfo.tickerid,
     higherTimeframe,
     [
         donchianMidpoint(conversionPeriods),
         donchianMidpoint(basePeriods),
         math.avg(donchianMidpoint(conversionPeriods), donchianMidpoint(basePeriods)),
         donchianMidpoint(leadingSpanBPeriods)
     ],
     lookahead=barmerge.lookahead_off)
currentTfSeconds = timeframe.in_seconds(timeframe.period)
higherTfSeconds = timeframe.in_seconds(higherTimeframe)
timeframeMultiplier = currentTfSeconds > 0 ?
     higherTfSeconds / currentTfSeconds :
     1
adjustedDisplacement = int(displacement * timeframeMultiplier)
plot(showIchimoku ? conversionLine : na, color=ichiTenkanColor, linewidth=1, title="Tenkan-sen", offset=adjustedDisplacement)
plot(showIchimoku ? baseLine : na, color=ichiKijunColor, linewidth=1, title="Kijun-sen", offset=adjustedDisplacement)
p_leadLine1 = plot(showIchimoku ? leadLine1 : na, color=ichiSpanAColor, linewidth=1, title="Senkou A", offset=adjustedDisplacement)
p_leadLine2 = plot(showIchimoku ? leadLine2 : na, color=ichiSpanBColor, linewidth=1, title="Senkou B", offset=adjustedDisplacement)
fill(p_leadLine1, p_leadLine2, color=leadLine1 > leadLine2 ? ichiCloudBullColor : ichiCloudBearColor, display=showIchimoku ? display.all : display.none)
// ============================================================================
// Smart Auto Divergence Engine
// ============================================================================
smartDivTfSeconds = timeframe.in_seconds(timeframe.period)
smartDivBasePivot =
     smartDivTfSeconds <= 300 ? 3 :
     smartDivTfSeconds <= 900 ? 4 :
     smartDivTfSeconds <= 3600 ? 5 :
     smartDivTfSeconds <= 14400 ? 6 :
     7
smartDivAtr = ta.atr(14)
smartDivAtrPct = close != 0 ? smartDivAtr / close * 100 : 0.0
[smartDivPlusDI, smartDivMinusDI, smartDivAdx] = ta.dmi(14, 14)
smartDivVolAdjust =
     smartDivAtrPct > 3.0 ? 2 :
     smartDivAtrPct > 1.5 ? 1 :
     0
smartDivTrendAdjust =
     smartDivAdx > 35 ? 2 :
     smartDivAdx > 25 ? 1 :
     0
smartDivPivotLeft = math.min(8, math.max(3, smartDivBasePivot + smartDivVolAdjust + smartDivTrendAdjust))
smartDivPivotRight = math.min(5, math.max(2, smartDivBasePivot - 1))
smartDivMinBars = smartDivPivotLeft + smartDivPivotRight + 2
smartDivMaxBars = smartDivTfSeconds <= 900 ? 70 : 120
smartDivRsi = ta.rsi(close, 14)
[smartDivMacd, smartDivMacdSignal, smartDivMacdHist] = ta.macd(close, 12, 26, 9)
smartDivEma50 = ta.ema(close, 50)
smartDivEma200 = ta.ema(close, 200)
smartDivEma20 = ta.ema(close, 20)
smartDivVolumeMA = ta.sma(volume, 20)
smartDivStoch = ta.stoch(close, high, low, 14)
smartDivStochD = ta.sma(smartDivStoch, 3)
smartDivAtrFast = ta.atr(5)
smartDivAtrExhaust = smartDivAtrFast < smartDivAtrFast[1] and smartDivAtrFast[1] >= smartDivAtr
smartDivRsiTurningUp = smartDivRsi > smartDivRsi[1] and smartDivRsi[1] <= smartDivRsi[2]
smartDivRsiTurningDown = smartDivRsi < smartDivRsi[1] and smartDivRsi[1] >= smartDivRsi[2]
smartDivBullTrend =
     close > smartDivEma50 and
     smartDivEma50 > smartDivEma200 and
     smartDivPlusDI > smartDivMinusDI
smartDivBearTrend =
     close < smartDivEma50 and
     smartDivEma50 < smartDivEma200 and
     smartDivMinusDI > smartDivPlusDI
smartDivPricePivotLow = ta.pivotlow(
     low,
     smartDivPivotLeft,
     smartDivPivotRight)
smartDivPricePivotHigh = ta.pivothigh(
     high,
     smartDivPivotLeft,
     smartDivPivotRight)
smartDivPivotBar = bar_index - smartDivPivotRight
smartDivLowAtPivot = low[smartDivPivotRight]
smartDivHighAtPivot = high[smartDivPivotRight]
smartDivRsiAtPivot = smartDivRsi[smartDivPivotRight]
smartDivMacdAtPivot = smartDivMacd[smartDivPivotRight]
smartDivBullBosLenG = math.min(12, smartDivPivotLeft + smartDivPivotRight + 3)
smartDivBullBosLevelG = ta.highest(high, smartDivBullBosLenG)[smartDivPivotRight]
smartDivBearBosLenG = math.min(12, smartDivPivotLeft + smartDivPivotRight + 3)
smartDivBearBosLevelG = ta.lowest(low, smartDivBearBosLenG)[smartDivPivotRight]
smartDivBody(offsetValue) =>
    math.abs(close[offsetValue] - open[offsetValue])
smartDivRange(offsetValue) =>
    high[offsetValue] - low[offsetValue]
smartDivBullishRejection(offsetValue) =>
    body = smartDivBody(offsetValue)
    candleRange = smartDivRange(offsetValue)
    lowerWick = math.min(open[offsetValue], close[offsetValue]) - low[offsetValue]
    upperWick = high[offsetValue] - math.max(open[offsetValue], close[offsetValue])
    bullishBody = close[offsetValue] > open[offsetValue]
    strongBullBody = candleRange > 0 and body / candleRange >= 0.55 and bullishBody
    hammer = lowerWick > body * 1.5 and lowerWick > upperWick * 1.25
    engulfing =
         offsetValue < bar_index and
         close[offsetValue] > open[offsetValue] and
         close[offsetValue] > open[offsetValue + 1] and
         open[offsetValue] <= close[offsetValue + 1]
    strongBullBody or hammer or engulfing
smartDivBearishRejection(offsetValue) =>
    body = smartDivBody(offsetValue)
    candleRange = smartDivRange(offsetValue)
    upperWick = high[offsetValue] - math.max(open[offsetValue], close[offsetValue])
    lowerWick = math.min(open[offsetValue], close[offsetValue]) - low[offsetValue]
    bearishBody = close[offsetValue] < open[offsetValue]
    strongBearBody = candleRange > 0 and body / candleRange >= 0.55 and bearishBody
    shootingStar = upperWick > body * 1.5 and upperWick > lowerWick * 1.25
    engulfing =
         offsetValue < bar_index and
         close[offsetValue] < open[offsetValue] and
         close[offsetValue] < open[offsetValue + 1] and
         open[offsetValue] >= close[offsetValue + 1]
    strongBearBody or shootingStar or engulfing
smartDivPriceDiffPercent(oldPrice, newPrice) =>
    oldPrice != 0 ? math.abs(newPrice - oldPrice) / math.abs(oldPrice) * 100 : 0.0
smartDivDistanceValid(oldBar, newBar) =>
    barsDistance = newBar - oldBar
    barsDistance >= smartDivMinBars and barsDistance <= smartDivMaxBars
var int smartDivPrevLowBar = na
var float smartDivPrevLowPrice = na
var float smartDivPrevLowRsi = na
var float smartDivPrevLowMacd = na
var int smartDivPrevHighBar = na
var float smartDivPrevHighPrice = na
var float smartDivPrevHighRsi = na
var float smartDivPrevHighMacd = na
var bool smartDivBullPending = false
var int smartDivBullPivotBar = na
var float smartDivBullPivotPrice = na
var float smartDivBullStructureLevel = na
var float smartDivBullScore = na
var int smartDivBullExpireBar = na
var bool smartDivBearPending = false
var int smartDivBearPivotBar = na
var float smartDivBearPivotPrice = na
var float smartDivBearStructureLevel = na
var float smartDivBearScore = na
var int smartDivBearExpireBar = na
var int smartDivLastBullDrawBar = na
var int smartDivLastBearDrawBar = na
var int smartDivLastBullConfirmBar = na
var int smartDivLastBearConfirmBar = na
bool smartDivBullCandidate = false
bool smartDivBearCandidate = false
bool smartDivBullConfirmed = false
bool smartDivBearConfirmed = false
float smartDivBullCandidateScore = na
float smartDivBearCandidateScore = na
// FIX: امتیاز مؤثر برای نمایش واگرایی‌های متوسط
smartDivEffectiveMinScore = smartDivShowMinor ? math.max(40, smartDivMinScore - 15) : smartDivMinScore
// FIX: مدیریت لیبل‌های Smart Divergence (جلوگیری از پر شدن سقف لیبل)
var array<label> smartDivLabels = array.new_label()
if not na(smartDivPricePivotLow)
    if not na(smartDivPrevLowBar) and smartDivDistanceValid(smartDivPrevLowBar, smartDivPivotBar)
        smartDivPriceMovePct = smartDivPriceDiffPercent(
             smartDivPrevLowPrice,
             smartDivLowAtPivot)
        smartDivRsiMove = smartDivRsiAtPivot - smartDivPrevLowRsi
        smartDivMacdMove = smartDivMacdAtPivot - smartDivPrevLowMacd
        smartDivLowerLow = smartDivLowAtPivot < smartDivPrevLowPrice
        smartDivRsiHigherLow = smartDivRsiMove > 1.8
        smartDivMacdHigherLow = smartDivMacdMove > 0
        smartDivRsiBullDiv = smartDivLowerLow and smartDivRsiHigherLow
        smartDivMacdBullDiv = smartDivLowerLow and smartDivMacdHigherLow
        smartDivMinPriceMove =
             smartDivAtrPct > 2 ? 0.35 :
             smartDivAtrPct > 1 ? 0.20 :
             0.10
        smartDivPriceMoveValid = smartDivPriceMovePct >= smartDivMinPriceMove
        smartDivBelowEma20 = smartDivLowAtPivot < smartDivEma20[smartDivPivotRight]
        smartDivBelowEma50 = smartDivLowAtPivot < smartDivEma50[smartDivPivotRight]
        smartDivBelowEma200 = smartDivLowAtPivot < smartDivEma200[smartDivPivotRight]
        smartDivMacdMomentumTurn =
             smartDivMacdHist[smartDivPivotRight] > smartDivMacdHist[smartDivPivotRight + 1]
        smartDivRsiOversold = smartDivRsiAtPivot <= 38
        smartDivStochOversold = smartDivStoch[smartDivPivotRight] <= 28
        smartDivStretchBull = (smartDivEma20[smartDivPivotRight] - smartDivLowAtPivot) >= nz(smartDivAtr[smartDivPivotRight]) * 0.35
        smartDivBullRejection = smartDivBullishRejection(smartDivPivotRight)
        smartDivTwistHitsBull =
             (smartDivRsiOversold ? 1 : 0) +
             (smartDivStochOversold ? 1 : 0) +
             (smartDivStretchBull ? 1 : 0) +
             ((smartDivBullRejection or smartDivAtrExhaust or inRevBuyZone) ? 1 : 0)
        smartDivTwistBull = smartDivTwistHitsBull >= 2
        smartDivHighVolume =
             not na(smartDivVolumeMA) and
             volume[smartDivPivotRight] > smartDivVolumeMA[smartDivPivotRight] * 1.15
        smartDivBullScoreNow = 0.0
        smartDivBullScoreNow += smartDivRsiBullDiv ? 28 : 0
        smartDivBullScoreNow += smartDivMacdBullDiv ? 18 : 0
        smartDivBullScoreNow += smartDivRsiBullDiv and smartDivMacdBullDiv ? 16 : 0
        smartDivBullScoreNow += smartDivPriceMoveValid ? 8 : 0
        smartDivBullScoreNow += smartDivRsiOversold ? 8 : 0
        smartDivBullScoreNow += smartDivStochOversold ? 6 : 0
        smartDivBullScoreNow += smartDivTwistBull ? 12 : 0
        smartDivBullScoreNow += smartDivBelowEma50 ? 4 : 0
        smartDivBullScoreNow += smartDivBelowEma200 ? 4 : 0
        smartDivBullScoreNow += smartDivBullRejection ? 6 : 0
        smartDivBullScoreNow += smartDivMacdMomentumTurn ? 4 : 0
        smartDivBullScoreNow += smartDivHighVolume ? 3 : 0
        smartDivBullScoreNow += smartDivAtrExhaust ? 3 : 0
        // FIX: استفاده از smartDivBullTrend
        smartDivBullScoreNow += smartDivBullTrend ? 4 : 0
        smartDivBullCandidate :=
             smartDivLowerLow and
             smartDivPriceMoveValid and
             smartDivRsiBullDiv and
             (not smartDivStrongOnly or smartDivMacdBullDiv) and
             (not smartDivRequireTwist or smartDivTwistBull)
        smartDivBullCandidateScore := smartDivBullScoreNow
        smartDivBullBosLevel = smartDivBullBosLevelG
        if smartDivBullCandidate and smartDivBullScoreNow >= smartDivEffectiveMinScore
            smartDivBullPending := true
            smartDivBullPivotBar := smartDivPivotBar
            smartDivBullPivotPrice := smartDivLowAtPivot
            smartDivBullStructureLevel := smartDivBullBosLevel
            smartDivBullScore := smartDivBullScoreNow
            smartDivBullExpireBar := bar_index + math.max(15, smartDivPivotLeft * 5)
            if smartDivEnabled and smartDivLastBullDrawBar != smartDivPivotBar
                smartDivLineColor =
                     smartDivBullScoreNow >= 80 ? color.new(color.aqua, 5) :
                     color.new(color.lime, 15)
                line.new(
                     smartDivPrevLowBar,
                     smartDivPrevLowPrice,
                     smartDivPivotBar,
                     smartDivLowAtPivot,
                     xloc=xloc.bar_index,
                     color=smartDivLineColor,
                     style=line.style_solid,
                     width=smartDivBullScoreNow >= 80 ? 3 : 2)
                if smartDivShowZones
                    box.new(
                         smartDivPrevLowBar,
                         smartDivLowAtPivot - nz(smartDivAtr) * 0.15,
                         bar_index,
                         math.min(smartDivPrevLowPrice, smartDivLowAtPivot) + nz(smartDivAtr) * 0.35,
                         xloc=xloc.bar_index,
                         bgcolor=color.new(color.lime, 88),
                         border_color=color.new(color.lime, 50),
                         border_width=1,
                         text="TWIST LOW",
                         text_size=size.tiny,
                         text_color=color.lime)
                smartDivLastBullDrawBar := smartDivPivotBar
    smartDivPrevLowBar := smartDivPivotBar
    smartDivPrevLowPrice := smartDivLowAtPivot
    smartDivPrevLowRsi := smartDivRsiAtPivot
    smartDivPrevLowMacd := smartDivMacdAtPivot
if not na(smartDivPricePivotHigh)
    if not na(smartDivPrevHighBar) and smartDivDistanceValid(smartDivPrevHighBar, smartDivPivotBar)
        smartDivPriceMovePct = smartDivPriceDiffPercent(
             smartDivPrevHighPrice,
             smartDivHighAtPivot)
        smartDivRsiMove = smartDivPrevHighRsi - smartDivRsiAtPivot
        smartDivMacdMove = smartDivPrevHighMacd - smartDivMacdAtPivot
        smartDivHigherHigh = smartDivHighAtPivot > smartDivPrevHighPrice
        smartDivRsiLowerHigh = smartDivRsiMove > 1.8
        smartDivMacdLowerHigh = smartDivMacdMove > 0
        smartDivRsiBearDiv = smartDivHigherHigh and smartDivRsiLowerHigh
        smartDivMacdBearDiv = smartDivHigherHigh and smartDivMacdLowerHigh
        smartDivMinPriceMove =
             smartDivAtrPct > 2 ? 0.35 :
             smartDivAtrPct > 1 ? 0.20 :
             0.10
        smartDivPriceMoveValid = smartDivPriceMovePct >= smartDivMinPriceMove
        smartDivAboveEma20 = smartDivHighAtPivot > smartDivEma20[smartDivPivotRight]
        smartDivAboveEma50 = smartDivHighAtPivot > smartDivEma50[smartDivPivotRight]
        smartDivAboveEma200 = smartDivHighAtPivot > smartDivEma200[smartDivPivotRight]
        smartDivMacdMomentumTurn =
             smartDivMacdHist[smartDivPivotRight] < smartDivMacdHist[smartDivPivotRight + 1]
        smartDivRsiOverbought = smartDivRsiAtPivot >= 62
        smartDivStochOverbought = smartDivStoch[smartDivPivotRight] >= 72
        smartDivStretchBear = (smartDivHighAtPivot - smartDivEma20[smartDivPivotRight]) >= nz(smartDivAtr[smartDivPivotRight]) * 0.35
        smartDivBearRejection = smartDivBearishRejection(smartDivPivotRight)
        smartDivTwistHitsBear =
             (smartDivRsiOverbought ? 1 : 0) +
             (smartDivStochOverbought ? 1 : 0) +
             (smartDivStretchBear ? 1 : 0) +
             ((smartDivBearRejection or smartDivAtrExhaust or inRevSellZone) ? 1 : 0)
        smartDivTwistBear = smartDivTwistHitsBear >= 2
        smartDivHighVolume =
             not na(smartDivVolumeMA) and
             volume[smartDivPivotRight] > smartDivVolumeMA[smartDivPivotRight] * 1.15
        smartDivBearScoreNow = 0.0
        smartDivBearScoreNow += smartDivRsiBearDiv ? 28 : 0
        smartDivBearScoreNow += smartDivMacdBearDiv ? 18 : 0
        smartDivBearScoreNow += smartDivRsiBearDiv and smartDivMacdBearDiv ? 16 : 0
        smartDivBearScoreNow += smartDivPriceMoveValid ? 8 : 0
        smartDivBearScoreNow += smartDivRsiOverbought ? 8 : 0
        smartDivBearScoreNow += smartDivStochOverbought ? 6 : 0
        smartDivBearScoreNow += smartDivTwistBear ? 12 : 0
        smartDivBearScoreNow += smartDivAboveEma50 ? 4 : 0
        smartDivBearScoreNow += smartDivAboveEma200 ? 4 : 0
        smartDivBearScoreNow += smartDivBearRejection ? 6 : 0
        smartDivBearScoreNow += smartDivMacdMomentumTurn ? 4 : 0
        smartDivBearScoreNow += smartDivHighVolume ? 3 : 0
        smartDivBearScoreNow += smartDivAtrExhaust ? 3 : 0
        // FIX: استفاده از smartDivBearTrend
        smartDivBearScoreNow += smartDivBearTrend ? 4 : 0
        smartDivBearCandidate :=
             smartDivHigherHigh and
             smartDivPriceMoveValid and
             smartDivRsiBearDiv and
             (not smartDivStrongOnly or smartDivMacdBearDiv) and
             (not smartDivRequireTwist or smartDivTwistBear)
        smartDivBearCandidateScore := smartDivBearScoreNow
        smartDivBearBosLevel = smartDivBearBosLevelG
        if smartDivBearCandidate and smartDivBearScoreNow >= smartDivEffectiveMinScore
            smartDivBearPending := true
            smartDivBearPivotBar := smartDivPivotBar
            smartDivBearPivotPrice := smartDivHighAtPivot
            smartDivBearStructureLevel := smartDivBearBosLevel
            smartDivBearScore := smartDivBearScoreNow
            smartDivBearExpireBar := bar_index + math.max(15, smartDivPivotLeft * 5)
            if smartDivEnabled and smartDivLastBearDrawBar != smartDivPivotBar
                smartDivLineColor =
                     smartDivBearScoreNow >= 80 ? color.new(color.fuchsia, 5) :
                     color.new(color.red, 15)
                line.new(
                     smartDivPrevHighBar,
                     smartDivPrevHighPrice,
                     smartDivPivotBar,
                     smartDivHighAtPivot,
                     xloc=xloc.bar_index,
                     color=smartDivLineColor,
                     style=line.style_solid,
                     width=smartDivBearScoreNow >= 80 ? 3 : 2)
                if smartDivShowZones
                    box.new(
                         smartDivPrevHighBar,
                         math.max(smartDivPrevHighPrice, smartDivHighAtPivot) - nz(smartDivAtr) * 0.35,
                         bar_index,
                         smartDivHighAtPivot + nz(smartDivAtr) * 0.15,
                         xloc=xloc.bar_index,
                         bgcolor=color.new(color.red, 88),
                         border_color=color.new(color.red, 50),
                         border_width=1,
                         text="TWIST HIGH",
                         text_size=size.tiny,
                         text_color=color.red)
                smartDivLastBearDrawBar := smartDivPivotBar
    smartDivPrevHighBar := smartDivPivotBar
    smartDivPrevHighPrice := smartDivHighAtPivot
    smartDivPrevHighRsi := smartDivRsiAtPivot
    smartDivPrevHighMacd := smartDivMacdAtPivot
smartDivBullBos =
     smartDivBullPending and
     bar_index <= smartDivBullExpireBar and
     close > smartDivBullStructureLevel and
     close[1] <= smartDivBullStructureLevel
smartDivBullBodyOk = (high - low) > 0 and math.abs(close - open) / (high - low) >= 0.28
smartDivBullMomentumConfirm =
     close > open and
     smartDivBullBodyOk and
     (smartDivRsi > smartDivRsi[1] or smartDivMacdHist > smartDivMacdHist[1])
smartDivBullConfirmed :=
     smartDivEnabled and
     smartDivBullBos and
     smartDivBullMomentumConfirm and
     smartDivBullScore >= smartDivMinScore
smartDivBearBos =
     smartDivBearPending and
     bar_index <= smartDivBearExpireBar and
     close < smartDivBearStructureLevel and
     close[1] >= smartDivBearStructureLevel
smartDivBearBodyOk = (high - low) > 0 and math.abs(close - open) / (high - low) >= 0.28
smartDivBearMomentumConfirm =
     close < open and
     smartDivBearBodyOk and
     (smartDivRsi < smartDivRsi[1] or smartDivMacdHist < smartDivMacdHist[1])
smartDivBearConfirmed :=
     smartDivEnabled and
     smartDivBearBos and
     smartDivBearMomentumConfirm and
     smartDivBearScore >= smartDivMinScore
if smartDivBullPending and bar_index > smartDivBullExpireBar
    smartDivBullPending := false
if smartDivBearPending and bar_index > smartDivBearExpireBar
    smartDivBearPending := false
if smartDivBullConfirmed
    smartDivBullPending := false
if smartDivBearConfirmed
    smartDivBearPending := false
if smartDivBullConfirmed and smartDivShowLabels and smartDivLastBullConfirmBar != bar_index
    smartDivStrength =
         smartDivBullScore >= 80 ? "EXTREME" :
         smartDivBullScore >= 70 ? "STRONG" :
         "CONFIRMED"
    sdLblBullConf = label.new(
         bar_index,
         low,
         "★ " + smartDivStrength + "\nBULLISH REVERSAL" +
         "\nDivergence + BOS" +
         "\nScore: " + str.tostring(math.round(smartDivBullScore)),
         style=label.style_label_up,
         color=smartDivBullScore >= 70 ? color.aqua : color.green,
         textcolor=color.black,
         size=smartDivBullScore >= 70 ? size.normal : size.small)
    array.push(smartDivLabels, sdLblBullConf)
    if array.size(smartDivLabels) > 120
        label.delete(array.get(smartDivLabels, 0))
        array.shift(smartDivLabels)
    smartDivLastBullConfirmBar := bar_index
if smartDivBearConfirmed and smartDivShowLabels and smartDivLastBearConfirmBar != bar_index
    smartDivStrength =
         smartDivBearScore >= 80 ? "EXTREME" :
         smartDivBearScore >= 70 ? "STRONG" :
         "CONFIRMED"
    sdLblBearConf = label.new(
         bar_index,
         high,
         "★ " + smartDivStrength + "\nBEARISH REVERSAL" +
         "\nDivergence + BOS" +
         "\nScore: " + str.tostring(math.round(smartDivBearScore)),
         style=label.style_label_down,
         color=smartDivBearScore >= 70 ? color.fuchsia : color.red,
         textcolor=color.white,
         size=smartDivBearScore >= 70 ? size.normal : size.small)
    array.push(smartDivLabels, sdLblBearConf)
    if array.size(smartDivLabels) > 120
        label.delete(array.get(smartDivLabels, 0))
        array.shift(smartDivLabels)
    smartDivLastBearConfirmBar := bar_index
if smartDivEnabled and smartDivBullCandidate and smartDivBullCandidateScore >= smartDivEffectiveMinScore
    sdLblBullCand = label.new(
         smartDivPivotBar,
         smartDivLowAtPivot,
         "•",
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=label.style_circle,
         color=color.new(color.lime, 35),
         textcolor=color.white,
         size=size.tiny)
    array.push(smartDivLabels, sdLblBullCand)
    if array.size(smartDivLabels) > 120
        label.delete(array.get(smartDivLabels, 0))
        array.shift(smartDivLabels)
if smartDivEnabled and smartDivBearCandidate and smartDivBearCandidateScore >= smartDivEffectiveMinScore
    sdLblBearCand = label.new(
         smartDivPivotBar,
         smartDivHighAtPivot,
         "•",
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=label.style_circle,
         color=color.new(color.red, 35),
         textcolor=color.white,
         size=size.tiny)
    array.push(smartDivLabels, sdLblBearCand)
    if array.size(smartDivLabels) > 120
        label.delete(array.get(smartDivLabels, 0))
        array.shift(smartDivLabels)
if smartDivBullConfirmed
    sdLblBullTri = label.new(bar_index, low, "▲", style=label.style_label_up, color=color.aqua, textcolor=color.black, size=size.small)
    array.push(smartDivLabels, sdLblBullTri)
    if array.size(smartDivLabels) > 120
        label.delete(array.get(smartDivLabels, 0))
        array.shift(smartDivLabels)
if smartDivBearConfirmed
    sdLblBearTri = label.new(bar_index, high, "▼", style=label.style_label_down, color=color.fuchsia, textcolor=color.white, size=size.small)
    array.push(smartDivLabels, sdLblBearTri)
    if array.size(smartDivLabels) > 120
        label.delete(array.get(smartDivLabels, 0))
        array.shift(smartDivLabels)
// ============================================================================
// هشدارهای NTS (اصلاح‌شده: فیلترهای xauTradeOk و کول‌دان اضافه شد)
// ============================================================================
// هشدارهای قدیمی حذف شدند - فقط هشدارهای مبتنی بر سیگنال نهایی فیلترشده استفاده می‌شوند.
alertcondition(finalNtsFib1Buy or finalNtsFib2Buy or finalNtsFib3Buy, title="NTS Fib 1-3 Buy", message="NTS Fib 1-3 Buy Signal on {{ticker}}")
alertcondition(finalNtsFib1Sell or finalNtsFib2Sell or finalNtsFib3Sell, title="NTS Fib 1-3 Sell", message="NTS Fib 1-3 Sell Signal on {{ticker}}")
alertcondition(
     smartDivBullConfirmed,
     title="Smart Confirmed Bullish Reversal",
     message="Confirmed Bullish Reversal: Divergence + Structure Break + Momentum on {{ticker}} | Price: {{close}}")
alertcondition(
     smartDivBearConfirmed,
     title="Smart Confirmed Bearish Reversal",
     message="Confirmed Bearish Reversal: Divergence + Structure Break + Momentum on {{ticker}} | Price: {{close}}")
alertcondition(
     smartDivBullCandidate and smartDivBullCandidateScore >= smartDivEffectiveMinScore,
     title="Bullish Divergence Candidate",
     message="Bullish divergence candidate detected on {{ticker}} | Awaiting structure confirmation.")
alertcondition(
     smartDivBearCandidate and smartDivBearCandidateScore >= smartDivEffectiveMinScore,
     title="Bearish Divergence Candidate",
     message="Bearish divergence candidate detected on {{ticker}} | Awaiting structure confirmation.")
//#endregion ======================== 1. هسته اصلی (Premium Lux Algo) ========================

//#region ======================== 2. لایه تأیید از KD System (فقط Hull Suite) ========================
// ============================================================================
// توابع KD System
// ============================================================================
hullSrc     = input.source(close, "منبع محاسبه Hull",      group=grp_HULL)
hullMode    = input.string("Hma", "نوع Hull",   options=["Hma","Thma","Ehma"], group=grp_HULL)
hullLen     = input.int(34, "طول دوره",                 group=grp_HULL)
hullLenMult = input.float(2.0, "ضریب طول",   group=grp_HULL)
hullUseHTF  = input.bool(false, "نمایش Hull از تایم‌فریم بالاتر", group=grp_HULL)
hullHTF     = input.timeframe("240", "تایم‌فریم بالاتر",     group=grp_HULL)
hullTransp  = input.int(80, "شفافیت باند",      group=grp_HULL)
HMA_f(s, l)  => ta.wma(2 * ta.wma(s, l / 2) - ta.wma(s, l), math.round(math.sqrt(l)))
EHMA_f(s, l) => ta.ema(2 * ta.ema(s, l / 2) - ta.ema(s, l), math.round(math.sqrt(l)))
THMA_f(s, l) => ta.wma(ta.wma(s, l / 3) * 3 - ta.wma(s, l / 2) - ta.wma(s, l), l)
HullCalc(m, s, l) =>
    switch m
        "Hma"  => HMA_f(s, l)
        "Ehma" => EHMA_f(s, l)
        "Thma" => THMA_f(s, l / 2)
_hullRaw = HullCalc(hullMode, hullSrc, int(hullLen * hullLenMult))
// FIX: برای HTF از مقدار کامل‌شدهٔ کندل قبلی استفاده می‌شود (کاهش ری‌پینت در کندل زنده)
HULL      = hullUseHTF ? request.security(syminfo.tickerid, hullHTF, _hullRaw[1], barmerge.gaps_off, barmerge.lookahead_on) : _hullRaw
MHULL     = HULL
SHULL     = HULL[2]
hullLineTransp = math.max(0, math.min(100, hullTransp - 35))
hullFillTransp = math.max(0, math.min(100, hullTransp))

// تعریف hullBullish و hullBearish بر اساس منطق جدید (کاهش نویز)
hullBullish =
     not na(HULL[4]) and
     HULL > HULL[3] and
     HULL[1] > HULL[4] and
     HULL > HULL[1]

hullBearish =
     not na(HULL[4]) and
     HULL < HULL[3] and
     HULL[1] < HULL[4] and
     HULL < HULL[1]

hullColor =
     hullBullish
     ? color.new(upColor, hullLineTransp)
     : hullBearish
     ? color.new(downColor, hullLineTransp)
     : color.new(midColor, hullLineTransp)

hullFillColor =
     hullBullish
     ? color.new(upColor, hullFillTransp)
     : hullBearish
     ? color.new(downColor, hullFillTransp)
     : color.new(midColor, hullFillTransp)

// Hull Ribbon
hullLineCol =
     hullBullish ? upColor :
     hullBearish ? downColor :
     midColor

hullBandCol =
     hullBullish ? color.new(upColor, 70) :
     hullBearish ? color.new(downColor, 70) :
     color.new(midColor, 80)

p_mhull = plot(showHullRibbon ? MHULL : na, title="MHULL", color=hullLineCol, linewidth=2)
p_shull = plot(showHullRibbon ? SHULL : na, title="SHULL", color=hullLineCol, linewidth=2)
fill(p_mhull, p_shull, title="Hull Band", color=hullBandCol, display=showHullRibbon ? display.all : display.none)
// FIX: هشدارهای Hull فقط بعد از بسته‌شدن کندل (کاهش ری‌پینت/هشدار کاذب)
alertcondition(barstate.isconfirmed and ta.crossover(MHULL, SHULL), title="Hull Up", message="Hull trending up")
alertcondition(barstate.isconfirmed and ta.crossover(SHULL, MHULL), title="Hull Down", message="Hull trending down")
//#endregion ======================== 2. لایه تأیید از KD System (فقط Hull Suite) ========================

//#region ======================== 3. منطق ترکیب نهایی ========================
// ============================================================================
// تعریف متغیرهای تأیید از KD System (hullBullish و hullBearish قبلاً تعریف شده‌اند)
// ============================================================================
// تأیید روند فقط بر اساس Hull Suite
bullishConfirmation = hullBullish
bearishConfirmation = hullBearish

// هماهنگی همه اجزا روی Fib 61.8 / 78.6 / 88.6
ntsFibBandTop = not na(ntsFib1) and not na(ntsFib2) and not na(ntsFib3) ? math.max(ntsFib1, math.max(ntsFib2, ntsFib3)) : na
ntsFibBandBot = not na(ntsFib1) and not na(ntsFib2) and not na(ntsFib3) ? math.min(ntsFib1, math.min(ntsFib2, ntsFib3)) : na
inNtsBuyFibBand = ntsTrend == 1 and not na(ntsFib1) and not na(ntsFibBandTop) and not na(ntsFibBandBot) and low <= ntsFibBandTop + ntsMinReact and close >= ntsFibBandBot - ntsMinReact
inNtsSellFibBand = ntsTrend == -1 and not na(ntsFib1) and not na(ntsFibBandTop) and not na(ntsFibBandBot) and high >= ntsFibBandBot - ntsMinReact and close <= ntsFibBandTop + ntsMinReact
ntsFibTouchBuy = fib1BuyReaction or fib2BuyReaction or fib3BuyReaction
ntsFibTouchSell = fib1SellReaction or fib2SellReaction or fib3SellReaction
ntsDivBuy = smartDivBullPending or smartDivBullConfirmed
ntsDivSell = smartDivBearPending or smartDivBearConfirmed
ntsSwingKaf = low <= low[1] and low <= low[2] and close > open and close > low + (high - low) * 0.45
ntsSwingSaghf = high >= high[1] and high >= high[2] and close < open and close < high - (high - low) * 0.45
ntsVolBoost = volume > ta.sma(volume, 20) * 1.05

// ============================================================================
// سیستم امتیازدهی Confluence
// ============================================================================
// FIX: یکسان‌سازی ناحیه Premium/Discount — مبنای روز قبل (PDH/PDL)، هماهنگ با بخش ۴
[pdHigh, pdLow] = request.security(syminfo.tickerid, "D", [high[1], low[1]], barmerge.gaps_off, barmerge.lookahead_on)
prevDayRange = not na(pdHigh) and not na(pdLow) ? pdHigh - pdLow : na
eqLevel = not na(prevDayRange) and prevDayRange > 0 ? (pdHigh + pdLow) / 2 : na
inDailyDiscount = not na(prevDayRange) and prevDayRange > 0 and close <= pdLow + prevDayRange * 0.05
inDailyPremium  = not na(prevDayRange) and prevDayRange > 0 and close >= pdLow + prevDayRange * 0.95

// ===== رفع هشدار ta.crossover/ta.crossunder در بخش امتیازدهی =====
gNtsCrossUpFib1Temp = ta.crossover(close, ntsFib1)
gNtsCrossUpFib2Temp = ta.crossover(close, ntsFib2)
gNtsCrossDnFib1Temp = ta.crossunder(close, ntsFib1)
gNtsCrossDnFib2Temp = ta.crossunder(close, ntsFib2)
gNtsCrossUpFib1 = not na(ntsFib1) and gNtsCrossUpFib1Temp
gNtsCrossUpFib2 = not na(ntsFib2) and gNtsCrossUpFib2Temp
gNtsCrossDnFib1 = not na(ntsFib1) and gNtsCrossDnFib1Temp
gNtsCrossDnFib2 = not na(ntsFib2) and gNtsCrossDnFib2Temp
gNtsCrossUpFib = gNtsCrossUpFib1 or gNtsCrossUpFib2
gNtsCrossDnFib = gNtsCrossDnFib1 or gNtsCrossDnFib2

ntsBuyConfluencePts =
     (ntsFibTouchBuy ? 32 : inNtsBuyFibBand ? 14 : 0) +
     (revBuyOk ? 14 : 0) +
     (ntsDivBuy ? 18 : ntsRsiNow <= 35 ? 11 : 0) +
     (bullishConfirmation ? 14 : 0) +
     (ntsBuyTrendOk ? 8 : 0) +
     (ntsSwingKaf ? 10 : 0) +
     (ntsVolBoost ? 4 : 0)
ntsBuyConfluencePts += 
     (inDailyDiscount ? 10 : 0) +
     (ntsGoldenHourBonus != 0 ? 8 : 0) +
     (ntsTrend == 1 and adxForNts >= ntsStrongAdx ? 6 : 0) +
     (close > ntsFib1 and close > ntsFib2 ? 5 : 0) +
     (gNtsCrossUpFib ? 8 : 0)
ntsSellConfluencePts =
     (ntsFibTouchSell ? 32 : inNtsSellFibBand ? 14 : 0) +
     (revSellOk ? 14 : 0) +
     (ntsDivSell ? 18 : ntsRsiNow >= 65 ? 11 : 0) +
     (bearishConfirmation ? 14 : 0) +
     (ntsSellTrendOk ? 8 : 0) +
     (ntsSwingSaghf ? 10 : 0) +
     (ntsVolBoost ? 4 : 0)
ntsSellConfluencePts += 
     (inDailyPremium ? 10 : 0) +
     (ntsGoldenHourBonus != 0 ? 8 : 0) +
     (ntsTrend == -1 and adxForNts >= ntsStrongAdx ? 6 : 0) +
     (close < ntsFib1 and close < ntsFib2 ? 5 : 0) +
     (gNtsCrossDnFib ? 8 : 0)
ntsBuyThreshold = 
     ntsTradingMode == "اسکالپینگ" ? 55 :
     ntsTradingMode == "ترید روزانه" ? 58 :
     ntsTradingMode == "سوینگ تریدینگ" ? 62 :
     65
ntsSellThreshold = 
     ntsTradingMode == "اسکالپینگ" ? 55 :
     ntsTradingMode == "ترید روزانه" ? 58 :
     ntsTradingMode == "سوینگ تریدینگ" ? 62 :
     65

// اصلاح KAF و SAGHF با شرایط هم‌جهت و خلاف‌روند
ntsKafSignal =
     xauTradeOk and
     ntsFibTouchBuy and
     ntsSwingKaf and
     ntsBuyConfluencePts >= ntsBuyThreshold and
     (
         (
             ntsTrend == 1 and
             bullishConfirmation
         ) or
         (
             ntsTrend == -1 and
             ntsRsiNow <= 32 and
             revBuyOk and
             (smartDivBullPending or smartDivBullConfirmed or ntsBullishChoch)
         )
     )

ntsSaghfSignal =
     xauTradeOk and
     ntsFibTouchSell and
     ntsSwingSaghf and
     ntsSellConfluencePts >= ntsSellThreshold and
     (
         (
             ntsTrend == -1 and
             bearishConfirmation
         ) or
         (
             ntsTrend == 1 and
             ntsRsiNow >= 68 and
             revSellOk and
             (smartDivBearPending or smartDivBearConfirmed or ntsBearishChoch)
         )
     )

// FIX: آستانه Confluence به سیگنال‌های نهایی «خرید قوی / فروش قوی» اضافه شد
finalBuySignal = 
     ntsTrend == 1 and
     bullishConfirmation and
     revBuyOk and
     xauTradeOk and
     (inNtsBuyFibBand or ntsFibTouchBuy) and
     inDailyDiscount and
     ntsBuyConfluencePts >= ntsBuyThreshold
finalSellSignal = 
     ntsTrend == -1 and
     bearishConfirmation and
     revSellOk and
     xauTradeOk and
     (inNtsSellFibBand or ntsFibTouchSell) and
     inDailyPremium and
     ntsSellConfluencePts >= ntsSellThreshold
if finalBuySignal
    label.new(bar_index, low, "خرید قوی", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
if finalSellSignal
    label.new(bar_index, high, "فروش قوی", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
var int lastNtsKafBar = na
var int lastNtsSaghfBar = na
ntsKafShow = ntsKafSignal and (na(lastNtsKafBar) or bar_index - lastNtsKafBar > int(math.round(8 * ntsCdScale)))
ntsSaghfShow = ntsSaghfSignal and (na(lastNtsSaghfBar) or bar_index - lastNtsSaghfBar > int(math.round(8 * ntsCdScale)))
if ntsKafShow
    lastNtsKafBar := bar_index
    label.new(bar_index, low, "کف  " + (fib1BuyReaction ? "61.8" : fib2BuyReaction ? "78.6" : "88.6"), style=label.style_label_up, color=color.new(#00c853, 0), textcolor=color.white, size=size.small)
if ntsSaghfShow
    lastNtsSaghfBar := bar_index
    label.new(bar_index, high, "سقف  " + (fib1SellReaction ? "61.8" : fib2SellReaction ? "78.6" : "88.6"), style=label.style_label_down, color=color.new(#d50000, 0), textcolor=color.white, size=size.small)
alertcondition(ntsKafShow, title="NTS KAF (Bottom Fib)", message="NTS bottom confluence on {{ticker}}")
alertcondition(ntsSaghfShow, title="NTS SAGHF (Top Fib)", message="NTS top confluence on {{ticker}}")
// ============================================================================
// نمایش نهایی روی چارت (plot سراسری — مخفی با na)
// ============================================================================
// ============================================================================
// بهبود ۸: نمایش بهتر اطلاعات و هشدارهای دقیق‌تر
// ============================================================================
// پنل تنظیم خودکار
var table autoTunePanel = na
if showAutoTunePanel and barstate.islast
    if na(autoTunePanel)
        autoTunePanel := table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 25), border_color=color.new(color.gray, 40), border_width=1)
    ntsRegTxt = chopRegime ? "رنج" : trendRegime ? "روند قوی" : "روند معمولی"
    table.cell(autoTunePanel, 0, 0, "AUTO", text_color=color.white, text_size=size.small, bgcolor=autoTuneThisChart ? color.new(color.teal, 20) : color.new(color.red, 40))
    table.cell(autoTunePanel, 1, 0, autoTuneThisChart ? "روشن — این چارت" : "خاموش — دستی", text_color=color.white, text_size=size.small)
    table.cell(autoTunePanel, 0, 1, "نماد", text_color=color.gray, text_size=size.tiny)
    table.cell(autoTunePanel, 1, 1, syminfo.ticker + "  " + timeframe.period, text_color=color.white, text_size=size.tiny)
    table.cell(autoTunePanel, 0, 2, "حالت", text_color=color.gray, text_size=size.tiny)
    table.cell(autoTunePanel, 1, 2, ntsTradingMode + " / " + ntsBaseTimeframe, text_color=color.white, text_size=size.tiny)
    table.cell(autoTunePanel, 0, 3, "رژیم", text_color=color.gray, text_size=size.tiny)
    table.cell(autoTunePanel, 1, 3, ntsRegTxt + "  ADX " + str.tostring(adxSmooth, "#.0"), text_color=color.white, text_size=size.tiny)
    table.cell(autoTunePanel, 0, 4, "Period", text_color=color.gray, text_size=size.tiny)
    table.cell(autoTunePanel, 1, 4, str.tostring(ntsPeriod), text_color=color.white, text_size=size.tiny)
    table.cell(autoTunePanel, 0, 5, "Factor", text_color=color.gray, text_size=size.tiny)
    table.cell(autoTunePanel, 1, 5, str.tostring(dynamicFactor, "#.00"), text_color=color.white, text_size=size.tiny)
    table.cell(autoTunePanel, 0, 6, "ATR٪", text_color=color.gray, text_size=size.tiny)
    table.cell(autoTunePanel, 1, 6, str.tostring(volatilityRatio, "#.000") + "  rel " + str.tostring(atrNorm, "#.00"), text_color=color.white, text_size=size.tiny)
    table.cell(autoTunePanel, 0, 7, "سشن", text_color=color.gray, text_size=size.tiny)
    table.cell(autoTunePanel, 1, 7, xauTradeOk ? "مجاز" : "فیلتر", text_color=xauTradeOk ? color.lime : color.orange, text_size=size.tiny)
    table.cell(autoTunePanel, 0, 8, "کف/سقف", text_color=color.gray, text_size=size.tiny)
    table.cell(autoTunePanel, 1, 8, "B " + str.tostring(ntsBuyConfluencePts, "#") + "  S " + str.tostring(ntsSellConfluencePts, "#"), text_color=color.white, text_size=size.tiny)
    table.cell(autoTunePanel, 0, 9, "Buy Pts", text_color=color.gray, text_size=size.tiny)
    table.cell(autoTunePanel, 1, 9, str.tostring(ntsBuyConfluencePts, "#") + " / " + str.tostring(ntsBuyThreshold, "#"), text_color=ntsBuyConfluencePts >= ntsBuyThreshold ? color.lime : color.orange, text_size=size.tiny)
    table.cell(autoTunePanel, 0, 10, "Sell Pts", text_color=color.gray, text_size=size.tiny)
    table.cell(autoTunePanel, 1, 10, str.tostring(ntsSellConfluencePts, "#") + " / " + str.tostring(ntsSellThreshold, "#"), text_color=ntsSellConfluencePts >= ntsSellThreshold ? color.red : color.orange, text_size=size.tiny)
    table.cell(autoTunePanel, 0, 11, "Daily Zone", text_color=color.gray, text_size=size.tiny)
    table.cell(autoTunePanel, 1, 11, inDailyDiscount ? "Discount" : inDailyPremium ? "Premium" : "EQ", text_color=inDailyDiscount ? color.green : inDailyPremium ? color.red : color.gray, text_size=size.tiny)
alertcondition(finalBuySignal, title="Final Confirmed BUY (Premium/Discount Filtered)", message="Final BUY on {{ticker}} at {{close}} | Zone: Discount")
alertcondition(finalSellSignal, title="Final Confirmed SELL (Premium/Discount Filtered)", message="Final SELL on {{ticker}} at {{close}} | Zone: Premium")
