// ================================================================================================
// ترکیب Premium Lux Algo + Ultimate Auto Trendlines (هسته اصلی) + KD (Hull Suite فقط برای تأیید)
// ================================================================================================
// پروفایل اختصاصی: XAUUSD (طلا) — تایم‌فریم هدف M15 — ترید روزانه
// هسته NTS + ابر ریورسال به‌عنوان فیلتر کیفیت + واگرایی قوی
// ================================================================================================
// ============================================================================
// نسخه ادغام‌شده (MERGED): بخش ۴ اضافه شد
//   Previous Daily Premium / Discount Zones  +  Price Action Auto Trendlines
//   (نواحی پریمیوم/اکوییلیبریوم/دیسکانت روزهای قبل + سقف/کف فرکتال + خطوط روند خودکار)
//   منطق رسم خط روند دقیقاً مطابق فایل اصلی حفظ شده است.
// ============================================================================
// اصلاحات اعمال‌شده بر اساس بررسی:
//   - رفع شرط xauVolOk (افزونگی حذف شد)
//   - اصلاح رسم نواحی روزانه (rightTime) ← رفع CE10156 + باگ لبه راست
//   - اتصال ورودی updateOnClose به شرط به‌روزرسانی
//   - حذف کدهای مرده (wildMa, getHigherResolution)
//   - اصلاح هشدارهای ntsFibBuy/Sell با فیلترهای xauTradeOk و کول‌دان
//   - تغییر فیلتر سشن به بازه ۰۴:۳۰-۰۸:۳۰ تهران با استفاده از input.session
//   - رفع هشدارهای ta.crossover/ta.crossunder با محاسبه خارج از شرط
// ============================================================================
// اصلاحات جدید (بررسی فنی و کاربری):
//   ۱) f_atrAt() — ایندکس تاریخی ATR اصلاح شد (old→new → برای offset=-0)
//   ۲) doRedraw — بازترسیم خطوط/لیبل‌ها فقط روی آخرین کندل بسته‌شده
//   ۳) autoTuneThisChart — با حالت تریدینگ/تایم‌فریم ترکیب می‌شود (دیگر کامل بی‌اثر نیست)
//   ۴) autoSymbolType — تشخیص کریپتو (BTC/ETH/SOL) قبل از forex
//   ۵) NTS MTF — sma(high-low, 14) داخل request.security محاسبه می‌شود
//   ۶) Hull HTF — از مقدار بسته‌شدهٔ کندل بالاتر استفاده می‌شود؛ هشدارها با barstate.isconfirmed
//   ۷) finalBuy/finalSell — آستانه Confluence الزامی شد
//   ۸) Premium/Discount — تعریف نهایی بر اساس رنج روز قبل (PDH/PDL) یکسان‌سازی شد
//   ۹) Smart Divergence — smartDivShowMinor/مؤثر، smartDivTrendAdjust و smartDivTrend فعال شدند
//   ۱۰) مدیریت لیبل — پول Smart Divergence + محدودسازی لیبل‌های پرتکرار
// ============================================================================
//#region ======================== 1. هسته اصلی (Premium Lux Algo) ========================
indicator(
     "Premium Lux Algo + Ultimate Auto Trendlines + KD (Hull) + PD & PA Trendlines",
     shorttitle = "LuxAlgo+AutoTL+KD(Hull)+PD",
     overlay=true,
     precision=0,
     explicit_plot_zorder=true,
     max_labels_count=500,
     max_lines_count=500,
     max_boxes_count=500,
     max_polylines_count=100,
     max_bars_back=5000)
// ============================================================================
// گروه‌بندی تنظیمات
// ============================================================================
groupTheme      = "🔹 1. تم و ظاهر کلی"
groupReversal   = "🔹 2. Reversal Cloud (ابر برگشتی)"
groupNTS        = "🔹 3. NTS - تنظیمات کلی"
groupNtsDisplay = "🔹 4. NTS - نمایش فیبوناچی اکستنشن"
groupNtsSignals = "🔹 5. NTS - سیگنال‌های خرید و فروش"
groupIchimoku   = "🔹 6. ایچیموکو (چند تایم‌فریم)"
groupStyle      = "🔹 7. رنگ‌ها و ظاهر (هسته اصلی)"
groupSmartDiv   = "🔹 8. واگرایی هوشمند (Smart Divergence)"
grp_HULL        = "🔶 9. KD - هال ساوت (Hull Suite)"
upColor         = input.color(color.green, "رنگ صعودی (KD)", group="🔶 10. KD - رنگ‌های روند")
downColor       = input.color(color.red, "رنگ نزولی (KD)", group="🔶 10. KD - رنگ‌های روند")
midColor        = input.color(color.gray, "رنگ خنثی (KD)", group="🔶 10. KD - رنگ‌های روند")
showHullRibbon  = input.bool(false, "نمایش Hull Ribbon (KD)", group="🔶 11. KD - نمایش عناصر روی چارت")
showKdConfirmLabels = input.bool(false, "نمایش لیبل KD BUY/SELL", group="🔶 11. KD - نمایش عناصر روی چارت")
