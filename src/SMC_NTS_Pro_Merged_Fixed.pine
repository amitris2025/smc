     group=groupIchimoku)
// ============================================================================
// تنظیمات RSI (فقط برای NTS و توابع مرتبط)
// ============================================================================
rsiLengthInput = input.int(
     10,
     "RSI Length",
     minval=1,
     group=groupNtsSignals,
     tooltip="طول RSI برای تأیید چرخش در سیگنال‌های NTS.")
// ============================================================================
// تنظیمات Smart Auto Divergence
// ============================================================================
smartDivEnabled = input.bool(
     true,
     "فعال‌سازی واگرایی هوشمند",
     group=groupSmartDiv)
smartDivShowMinor = input.bool(
     false,
     "نمایش واگرایی‌های متوسط",
     group=groupSmartDiv,
     tooltip="اگر خاموش باشد فقط واگرایی قوی (Score بالا + پیچش قیمت) خط می‌کشد.")
smartDivShowZones = input.bool(
     false,
     "نمایش ناحیه پیچش / برگشت",
     group=groupSmartDiv)
smartDivShowLabels = input.bool(
     true,
     "نمایش لیبل تأیید برگشت",
     group=groupSmartDiv)
smartDivStrongOnly = input.bool(
     true,
     "فقط واگرایی قوی",
     group=groupSmartDiv,
     tooltip="الزام RSI+MACD با هم، ناحیه پیچش، و امتیاز حداقل.")
smartDivMinScore = input.int(
     55,
     "حداقل امتیاز واگرایی قوی",
     minval=40,
     maxval=90,
     group=groupSmartDiv)
smartDivRequireTwist = input.bool(
     true,
     "الزام ناحیه پیچش قیمت",
     group=groupSmartDiv,
     tooltip="پیوت باید در افراط RSI/Stoch با کشیدگی از میانگین و نشانه رد قیمت باشد.")
// ============================================================================
// تنظیمات رنگ‌ها و استایل
// ============================================================================
colorFib1 = input.color(
     color.white,
     "رنگ خط Fib 61.8",
     group=groupStyle)
colorFib2 = input.color(
     color.orange,
     "رنگ خط Fib 78.6",
     group=groupStyle)
colorFib3 = input.color(
     color.lime,
     "رنگ خط Fib 88.6",
     group=groupStyle)
colorTrail = input.color(
     color.rgb(120, 123, 134),
     "رنگ خط NTS Trail",
     group=groupStyle)
fillColorLong = input.color(
     color.new(color.green, 12),
     "رنگ Fill صعودی NTS",
     group=groupStyle)
fillColorShort = input.color(
     color.new(color.red, 12),
     "رنگ Fill نزولی NTS",
     group=groupStyle)
labelTextColor = input.color(
     color.white,
     "رنگ متن برچسب‌ها",
     group=groupStyle)
ichiTenkanColor = input.color(
     #2962FF,
     "رنگ Tenkan-sen",
     group=groupStyle,
     inline="ichiColor1")
ichiKijunColor = input.color(
     #B71C1C,
     "رنگ Kijun-sen",
     group=groupStyle,
     inline="ichiColor1")
ichiSpanAColor = input.color(
     #A5D6A7,
     "رنگ Senkou Span A",
     group=groupStyle,
     inline="ichiColor2")
ichiSpanBColor = input.color(
     #EF9A9A,
     "رنگ Senkou Span B",
     group=groupStyle,
     inline="ichiColor2")
ichiCloudBullColor = input.color(
     color.new(#43A047, 88),
     "رنگ ابر صعودی",
     group=groupStyle,
     inline="ichiColor3")
ichiCloudBearColor = input.color(
     color.new(#F44336, 88),
     "رنگ ابر نزولی",
     group=groupStyle,
     inline="ichiColor3")
// ============================================================================
// توابع کمکی (حذف wildMa و getHigherResolution چون استفاده نشده‌اند)
// ============================================================================
kamaFunc(sourcePrice, periodValue) =>
    value = 0.0
    priceChange = math.abs(sourcePrice - sourcePrice[periodValue])
    priceVolatility = math.sum(math.abs(sourcePrice - sourcePrice[1]), periodValue)
    efficiencyRatio = priceVolatility != 0 ? priceChange / priceVolatility : 0.0
    smoothingConstant = math.pow(efficiencyRatio * (0.288 - 0.0666) + 0.0666, 2)
    value := nz(value[1]) + smoothingConstant * (sourcePrice - nz(value[1]))
    value
donchianMidpoint(periodValue) =>
    math.avg(ta.lowest(periodValue), ta.highest(periodValue))
labelSizeFromText(sizeText) =>
    switch sizeText
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        "huge"   => size.huge
        => size.normal
// ============================================================================
// Reversal Cloud
// ============================================================================
cloudRange = kamaFunc(ta.tr, bandLength)
cloudBasis = kamaFunc(close, bandLength)
upperCloud1 = cloudBasis + cloudRange * bandDev1
upperCloud2 = cloudBasis + cloudRange * bandDev2
upperCloud3 = cloudBasis + cloudRange * bandDev3
lowerCloud1 = cloudBasis - cloudRange * bandDev1
lowerCloud2 = cloudBasis - cloudRange * bandDev2
lowerCloud3 = cloudBasis - cloudRange * bandDev3
inRevSellZone = high >= upperCloud1
inRevBuyZone  = low  <= lowerCloud1
inRevSellDeep = close >= upperCloud2
inRevBuyDeep  = close <= lowerCloud2
revBuyRecent  = ta.lowest(low, 12)  <= lowerCloud1
revSellRecent = ta.highest(high, 12) >= upperCloud1
revBuyOk  = not useReversalCloudFilter or inRevBuyZone or revBuyRecent
revSellOk = not useReversalCloudFilter or inRevSellZone or revSellRecent
u1 = plot(showReversalCloud and not compactMode ? upperCloud1 : na, "Cloud Upper 1", color=color.new(color.white, 25))
u2 = plot(showReversalCloud and not compactMode ? upperCloud2 : na, "Cloud Upper 2", color=color.new(color.white, 45))
u3 = plot(showReversalCloud and not compactMode ? upperCloud3 : na, "Cloud Upper 3", color=color.new(color.white, 65))
l1 = plot(showReversalCloud and not compactMode ? lowerCloud1 : na, "Cloud Lower 1", color=color.new(color.white, 25))
l2 = plot(showReversalCloud and not compactMode ? lowerCloud2 : na, "Cloud Lower 2", color=color.new(color.white, 45))
l3 = plot(showReversalCloud and not compactMode ? lowerCloud3 : na, "Cloud Lower 3", color=color.new(color.white, 65))
fill(u1, u2, color=color.new(bearColor, 82), display=showReversalCloud ? display.all : display.none)
fill(u2, u3, color=color.new(bearColor, 91), display=showReversalCloud ? display.all : display.none)
fill(l1, l2, color=color.new(bullColor, 82), display=showReversalCloud ? display.all : display.none)
fill(l2, l3, color=color.new(bullColor, 91), display=showReversalCloud ? display.all : display.none)
// ============================================================================
// NTS Core (هوشمند با حالت‌های آماده و تایم‌فریم انتخابی)
// ============================================================================
ntsResolution = ntsBaseTimeframe
// --- محاسبه دوره و ضریب پایه (از حالت تریدینگ) ---
basePeriod = 
     ntsTradingMode == "اسکالپینگ" ? 5 :
     ntsTradingMode == "ترید روزانه" ? 10 :
     ntsTradingMode == "سوینگ تریدینگ" ? 15 :
     20
baseFactor = 
     ntsTradingMode == "اسکالپینگ" ? 2.0 :
     ntsTradingMode == "ترید روزانه" ? 3.5 :
     ntsTradingMode == "سوینگ تریدینگ" ? 5.0 :
     7.0
ntsBasePeriod = 
     ntsBaseTimeframe == "1" ? 3 :
     ntsBaseTimeframe == "3" ? 5 :
     ntsBaseTimeframe == "5" ? 7 :
     ntsBaseTimeframe == "15" ? 10 :
     ntsBaseTimeframe == "30" ? 12 :
     ntsBaseTimeframe == "60" ? 15 :
     ntsBaseTimeframe == "240" ? 20 :
     10
ntsBaseFactor = 
     ntsBaseTimeframe == "1" ? 1.5 :
     ntsBaseTimeframe == "3" ? 2.0 :
     ntsBaseTimeframe == "5" ? 2.5 :
     ntsBaseTimeframe == "15" ? 3.5 :
     ntsBaseTimeframe == "30" ? 4.0 :
     ntsBaseTimeframe == "60" ? 5.0 :
     ntsBaseTimeframe == "240" ? 6.0 :
     3.5
ntsTfWeight = 
     (ntsTradingMode == "اسکالپینگ" and ntsBaseTimeframe == "5") or
     (ntsTradingMode == "ترید روزانه" and ntsBaseTimeframe == "15") or
     (ntsTradingMode == "سوینگ تریدینگ" and ntsBaseTimeframe == "30") or
     (ntsTradingMode == "پوزیشن تریدینگ" and ntsBaseTimeframe == "60") ? 0.7 : 0.4
ntsPeriod = int(math.round(basePeriod * ntsTfWeight + ntsBasePeriod * (1 - ntsTfWeight)))
ntsPeriod := math.max(4, math.min(40, ntsPeriod))
ntsFactor = baseFactor * ntsTfWeight + ntsBaseFactor * (1 - ntsTfWeight)
ntsFactor := math.max(1.5, math.min(20.0, ntsFactor))
// ============================================================================
// تنظیم خودکار کامل بر اساس نماد و تایم‌فریم
// ============================================================================
symU = str.upper(syminfo.ticker + " " + syminfo.basecurrency + " " + syminfo.currency)
autoSymbolType = 
     str.contains(symU, "XAU") or str.contains(symU, "GOLD") ? "gold" :
     str.contains(symU, "XAG") ? "silver" :
     str.contains(symU, "BTC") or
     str.contains(symU, "ETH") or
     str.contains(symU, "SOL") ? "crypto" :
     str.contains(symU, "USD") and not str.contains(symU, "USDT") ? "forex" :
     "other"
autoPeriod = 
     autoSymbolType == "gold" ? 10 :
     autoSymbolType == "silver" ? 12 :
     autoSymbolType == "forex" ? 8 :
     autoSymbolType == "crypto" ? 14 :
     10
autoFactor = 
     autoSymbolType == "gold" ? 3.5 :
     autoSymbolType == "silver" ? 4.0 :
     autoSymbolType == "forex" ? 3.0 :
     autoSymbolType == "crypto" ? 5.0 :
     3.5
autoMinAtrPct = 
     autoSymbolType == "gold" ? 0.06 :
     autoSymbolType == "silver" ? 0.08 :
     autoSymbolType == "forex" ? 0.05 :
     autoSymbolType == "crypto" ? 0.15 :
     0.06
xauMinAtrPctEff = autoTuneThisChart ? autoMinAtrPct : xauMinAtrPct
if autoTuneThisChart
    // FIX: ترکیب Auto-Tune با حالت تریدینگ / تایم‌فریم پایه (به‌جای نادیده‌گرفتن کامل تنظیمات کاربر)
    ntsPeriod := int(math.round(math.max(4.0, math.min(40.0, autoPeriod * (basePeriod / 10.0)))))
    ntsFactor := math.max(1.5, math.min(20.0, autoFactor * (baseFactor / 3.5)))
// --- ادامه محاسبات NTS ---
ntsCurrentTfSeconds = timeframe.in_seconds(timeframe.period)
ntsBaseTfSeconds = timeframe.in_seconds(ntsBaseTimeframe)
ntsTfRaw = ntsBaseTfSeconds > 0 and ntsCurrentTfSeconds > 0 ? ntsBaseTfSeconds / ntsCurrentTfSeconds : 1.0
ntsTfMultiplier = math.max(0.45, math.min(6.0, ntsTfRaw))
[diPlusNts, diMinusNts, adxForNts] = ta.dmi(14, 14)
atrSeed = ta.atr(14)
atrMean = ta.sma(atrSeed, 80)
atrNorm = atrMean > 0 ? atrSeed / atrMean : 1.0
atrNorm := math.max(0.50, math.min(2.20, atrNorm))
adxSmooth = ta.sma(adxForNts, 5)
chopRegime = adxSmooth < ntsMildAdx and atrNorm < 1.2
trendRegime = adxSmooth >= ntsStrongAdx or (adxSmooth >= ntsMildAdx and atrNorm >= 1.5)
if chopRegime
    ntsPeriod := math.max(4, int(ntsPeriod * 1.2))
else if trendRegime
    ntsPeriod := math.max(4, int(ntsPeriod * 0.85))
ntsPeriod := math.max(4, math.min(40, ntsPeriod))
atrForNts = ta.atr(14)
volatilityRatio = close > 0 ? atrForNts / close * 100 : 0.0
// ===== اصلاح سشن با time() =====
xauInSession = not xauSessionFilter or not na(time(timeframe.period, xauSessionString, "Asia/Tehran"))
xauGoldenHour = not na(time(timeframe.period, xauGoldenSessionString, "Asia/Tehran"))
// ===== اصلاح xauVolOk =====
xauVolOk = autoTuneThisChart ? atrNorm >= 0.62 : volatilityRatio >= xauMinAtrPctEff
xauTradeOk = xauInSession and xauVolOk
ntsGoldenHourBonus = xauGoldenHour ? 8 : 0
dynamicFactor = 
     volatilityRatio < 0.3 ? ntsFactor * 1.3 :
     volatilityRatio < 0.5 ? ntsFactor * 1.2 :
     volatilityRatio < 1.0 ? ntsFactor * 1.1 :
     volatilityRatio < 2.0 ? ntsFactor * 1.0 :
     volatilityRatio < 3.0 ? ntsFactor * 0.9 :
     ntsFactor * 0.8
dynamicFactor := 
     adxForNts > 40 ? dynamicFactor * 0.9 :
     adxForNts > 30 ? dynamicFactor * 0.95 :
     adxForNts > 20 ? dynamicFactor * 1.0 :
     adxForNts > 15 ? dynamicFactor * 1.1 :
     dynamicFactor * 1.2
dynamicFactor := math.max(1.5, math.min(20.0, dynamicFactor))
ntsCandleRange = high - low
ntsBodyPct = ntsCandleRange > 0 ? math.abs(close - open) / ntsCandleRange : 0.0
ntsAvgBodyPct = ta.sma(ntsBodyPct, 40)
ntsDynBody = ntsHighBodyThreshold * (0.78 + ntsAvgBodyPct)
ntsDynBody := math.max(0.30, math.min(0.58, ntsDynBody))
ntsDynBody := autoTuneThisChart ? ntsDynBody : ntsHighBodyThreshold
ntsMinReact = math.max(atrForNts * 0.10, syminfo.mintick * 8)
ntsCdScale = math.max(0.55, math.min(3.20, (900.0 / math.max(60.0, ntsCurrentTfSeconds)) * (0.80 + 0.25 * atrNorm)))
ntsCdScale := chopRegime ? ntsCdScale * 1.25 : ntsCdScale
ntsCdScale := autoTuneThisChart ? ntsCdScale : 1.0
ntsTicker = ticker.new(syminfo.prefix, syminfo.ticker)
// ===== FIX: MTF — محاسبه کامل (شامل SMA) داخل request.security =====
[ntsHigh, ntsLow, ntsClose, ntsHtfTime, ntsRangeSma] =
     request.security(
          ntsTicker,
          ntsResolution,
          [
               high,
               low,
               close,
               time,
               ta.sma(high - low, 14)
          ],
          barmerge.gaps_off,
          barmerge.lookahead_off)
ntsHiLo = math.min(
     ntsHigh - ntsLow,
     1.5 * nz(ntsRangeSma))
ntsHRef = ntsLow <= ntsHigh[1] ?
     ntsHigh - ntsClose[1] :
     ntsHigh - ntsClose[1] - 0.5 * (ntsLow - ntsHigh[1])
ntsLRef = ntsHigh >= ntsLow[1] ?
     ntsClose[1] - ntsLow :
     ntsClose[1] - ntsLow - 0.5 * (ntsLow[1] - ntsHigh)
ntsGapUp = ntsLow > ntsHigh[1]
ntsGapDown = ntsHigh < ntsLow[1]
ntsGapAdjustment = ntsGapUp ? ntsLow - ntsHigh[1] : ntsGapDown ? ntsLow[1] - ntsHigh : 0.0
ntsTrueRange = ntsTrailType == "modified" ?
     math.max(ntsHiLo, math.max(ntsHRef, ntsLRef)) :
     math.max(
         ntsHigh - ntsLow,
         math.max(
             math.abs(ntsHigh - ntsClose[1]),
             math.abs(ntsLow - ntsClose[1])))
ntsTrueRange := ntsTrueRange + ntsGapAdjustment * 0.5
ntsOnHtfBar = ntsCurrentTfSeconds >= ntsBaseTfSeconds or na(ntsHtfTime[1]) or ntsHtfTime != ntsHtfTime[1]
var float ntsWild = na
if ntsOnHtfBar
    ntsWild := nz(ntsWild) + (ntsTrueRange - nz(ntsWild)) / ntsPeriod
ntsLoss = dynamicFactor * nz(ntsWild, ntsTrueRange)
ntsUp = ntsClose - ntsLoss
ntsDown = ntsClose + ntsLoss
var float ntsTrendUp = na
var float ntsTrendDown = na
var int ntsTrend = 1
if ntsOnHtfBar
    ntsTrendUp := ntsClose[1] > nz(ntsTrendUp[1], ntsUp) ? math.max(ntsUp, nz(ntsTrendUp[1], ntsUp)) : ntsUp
    ntsTrendDown := ntsClose[1] < nz(ntsTrendDown[1], ntsDown) ? math.min(ntsDown, nz(ntsTrendDown[1], ntsDown)) : ntsDown
    ntsTrend := ntsClose > nz(ntsTrendDown[1], ntsDown) ? 1 : ntsClose < nz(ntsTrendUp[1], ntsUp) ? -1 : nz(ntsTrend[1], 1)
ntsTrail = ntsTrend == 1 ? ntsTrendUp : ntsTrendDown
crossoverNts = ntsTrend == 1 and ntsTrend[1] == -1
crossunderNts = ntsTrend == -1 and ntsTrend[1] == 1
var float ntsExtreme = na
ntsExtreme := crossoverNts ? ntsHigh :
     crossunderNts ? ntsLow :
     ntsTrend == 1 ?
         math.max(nz(ntsExtreme[1], ntsHigh), ntsHigh) :
         math.min(nz(ntsExtreme[1], ntsLow), ntsLow)
var float ntsSwingPull = na
var float ntsR1 = 0.618
var float ntsR2 = 0.786
var float ntsR3 = 0.886
var array<float> ntsRetrArr = array.new<float>()
ntsTrendChanged = crossoverNts or crossunderNts
if ntsOnHtfBar and ntsTrendChanged and not na(ntsExtreme[1]) and not na(ntsTrail[1]) and not na(ntsSwingPull)
    ntsSwingRng = math.abs(ntsExtreme[1] - ntsTrail[1])
    if ntsSwingRng > syminfo.mintick * 4
        ntsRetrNow = ntsTrend[1] == 1 ? (ntsExtreme[1] - ntsSwingPull) / ntsSwingRng : (ntsSwingPull - ntsExtreme[1]) / ntsSwingRng
        ntsRetrNow := math.max(0.40, math.min(0.93, ntsRetrNow))
        array.push(ntsRetrArr, ntsRetrNow)
        if array.size(ntsRetrArr) > 8
            array.shift(ntsRetrArr)
        ntsRetrTmp = array.copy(ntsRetrArr)
        array.sort(ntsRetrTmp)
        ntsRetrN = array.size(ntsRetrTmp)
        if ntsRetrN >= 2
            ntsMed = array.get(ntsRetrTmp, int((ntsRetrN - 1) * 0.50))
            ntsP70 = array.get(ntsRetrTmp, int((ntsRetrN - 1) * 0.72))
            ntsP88 = array.get(ntsRetrTmp, int((ntsRetrN - 1) * 0.90))
            ntsR1 := ntsR1 * 0.65 + ntsMed * 0.35
            ntsR2 := ntsR2 * 0.65 + math.max(ntsR1 + 0.04, ntsP70) * 0.35
            ntsR3 := ntsR3 * 0.65 + math.max(ntsR2 + 0.03, ntsP88) * 0.35
            ntsR1 := math.max(0.45, math.min(0.72, ntsR1))
            ntsR2 := math.max(ntsR1 + 0.05, math.min(0.86, ntsR2))
            ntsR3 := math.max(ntsR2 + 0.03, math.min(0.93, ntsR3))
if ntsOnHtfBar
    if ntsTrendChanged or na(ntsSwingPull)
        ntsSwingPull := ntsTrend == 1 ? ntsLow : ntsHigh
    else
        ntsSwingPull := ntsTrend == 1 ? math.min(ntsSwingPull, ntsLow) : math.max(ntsSwingPull, ntsHigh)
ntsFib1 = ntsExtreme + (ntsTrail - ntsExtreme) * ntsR1
ntsFib2 = ntsExtreme + (ntsTrail - ntsExtreme) * ntsR2
ntsFib3 = ntsExtreme + (ntsTrail - ntsExtreme) * ntsR3
ntsFibZoneHigh = math.max(ntsFib1, ntsFib2)
ntsFibZoneLow = math.min(ntsFib1, ntsFib2)
priceWasInNtsZone = not na(ntsFibZoneLow[1]) and not na(ntsFibZoneHigh[1]) and close[1] >= ntsFibZoneLow[1] and close[1] <= ntsFibZoneHigh[1]
// ===== رفع هشدار ta.crossover/ta.crossunder با محاسبه خارج از شرط =====
crossOverNtsZoneTemp = ta.crossover(close, ntsFibZoneHigh)
crossUnderNtsZoneTemp = ta.crossunder(close, ntsFibZoneLow)
crossOverNtsZone = not na(ntsFibZoneHigh) and crossOverNtsZoneTemp
crossUnderNtsZone = not na(ntsFibZoneLow) and crossUnderNtsZoneTemp
ntsFibBuy = showNtsFib12Signals and ntsTrend == 1 and priceWasInNtsZone and crossOverNtsZone
ntsFibSell = showNtsFib12Signals and ntsTrend == -1 and priceWasInNtsZone and crossUnderNtsZone
ntsTrendChange = ta.change(ntsTrend) != 0
var array<float> savedFib1Values = array.new_float()
var array<float> savedTrailValues = array.new_float()
var array<int> savedStartBars = array.new_int()
var array<int> savedDirections = array.new_int()
var float activeFib1 = na
var float activeTrail = na
var int activeDirection = 0
if ntsTrendChange
    currentDirection = ntsTrend == 1 ? 1 : -1
    activeFib1 := ntsFib1
    activeTrail := ntsTrail
    activeDirection := currentDirection
    array.push(savedFib1Values, ntsFib1)
    array.push(savedTrailValues, ntsTrail)
    array.push(savedStartBars, bar_index)
    array.push(savedDirections, currentDirection)
    if array.size(savedFib1Values) > 50
        array.shift(savedFib1Values)
        array.shift(savedTrailValues)
        array.shift(savedStartBars)
        array.shift(savedDirections)
// ============================================================================
// NTS Fib Extensions (رسم خطوط فیبوناچی اضافی و خطوط پایه 61.8% و 100%)
// ============================================================================
var array<float> extensionLevels = array.from(
     -0.468,
     -0.168,
     0.300,
     1.470,
     2.100,
     2.618,
     3.000,
     4.414,
     4.764,
     6.618,
     8.618,
     10.618)
var array<color> extensionColors = array.from(
     color.aqua,
     color.aqua,
     color.yellow,
     color.lime,
     color.lime,
     color.fuchsia,
     color.fuchsia,
     color.orange,
     color.orange,
     color.red,
     color.red,
     color.purple)
var array<line> extensionLines = array.new_line()
var array<label> extensionLabels = array.new_label()
var array<line> baseFibLines = array.new_line()
if barstate.islast
    if array.size(extensionLines) > 0
        for lineIndex = 0 to array.size(extensionLines) - 1
            line.delete(array.get(extensionLines, lineIndex))
        array.clear(extensionLines)
    if array.size(extensionLabels) > 0
        for labelIndex = 0 to array.size(extensionLabels) - 1
            label.delete(array.get(extensionLabels, labelIndex))
        array.clear(extensionLabels)
    if array.size(baseFibLines) > 0
        for baseIndex = 0 to array.size(baseFibLines) - 1
            line.delete(array.get(baseFibLines, baseIndex))
        array.clear(baseFibLines)
    extensionDirectionAllowed = (ntsTrend == 1 and showNtsLongExt) or
         (ntsTrend == -1 and showNtsShortExt)
    if showNtsExtensions and not compactMode and ntsShowBaseFib
        baseMatchingIndices = array.new_int()
        if array.size(savedDirections) > 0
            for histIndex = 0 to array.size(savedDirections) - 1
                if array.get(savedDirections, histIndex) == ntsTrend
                    array.push(baseMatchingIndices, histIndex)
        baseMatchingCount = array.size(baseMatchingIndices)
        baseEventsToDraw = math.min(ntsHistoryCount, baseMatchingCount)
        baseHistoryStartIndex = baseMatchingCount - baseEventsToDraw
        if baseEventsToDraw > 0
            for baseHistoryIndex = baseHistoryStartIndex to baseMatchingCount - 1
                histIndex = array.get(baseMatchingIndices, baseHistoryIndex)
                histStartBar = array.get(savedStartBars, histIndex)
                histFib1 = array.get(savedFib1Values, histIndex)
                histTrail = array.get(savedTrailValues, histIndex)
                if not na(histStartBar) and not na(histFib1) and not na(histTrail)
                    baseLine1 = line.new(
                         histStartBar,
                         histFib1,
                         bar_index,
                         histFib1,
                         xloc=xloc.bar_index,
                         extend=extend.right,
                         color=color.new(colorFib1, math.min(ntsLineTransparency + 15, 90)),
                         style=line.style_dotted,
                         width=1)
                    array.push(baseFibLines, baseLine1)
                    baseLine2 = line.new(
                         histStartBar,
                         histTrail,
                         bar_index,
                         histTrail,
                         xloc=xloc.bar_index,
                         extend=extend.right,
                         color=color.new(colorTrail, math.min(ntsLineTransparency + 15, 90)),
                         style=line.style_dotted,
                         width=1)
                    array.push(baseFibLines, baseLine2)
                    if showNtsLabels
                        baseLabel = label.new(
                             histStartBar,
                             histTrail,
                             "Fib 100%",
                             xloc=xloc.bar_index,
                             yloc=yloc.price,
                             style=label.style_label_left,
                             color=color.new(colorTrail, ntsLabelTransparency + 20),
                             textcolor=labelTextColor,
                             size=size.tiny)
                        array.push(extensionLabels, baseLabel)
    if showNtsExtensions and not compactMode and extensionDirectionAllowed
        matchingIndices = array.new_int()
        if array.size(savedDirections) > 0
            for indexValue = 0 to array.size(savedDirections) - 1
                if array.get(savedDirections, indexValue) == ntsTrend
                    array.push(matchingIndices, indexValue)
        matchingCount = array.size(matchingIndices)
        eventsToDraw = math.min(ntsHistoryCount, matchingCount)
        historyStartIndex = matchingCount - eventsToDraw
        if eventsToDraw > 0
            for historyIndex = historyStartIndex to matchingCount - 1
                savedIndex = array.get(matchingIndices, historyIndex)
                savedFib1 = array.get(savedFib1Values, savedIndex)
                savedTrail = array.get(savedTrailValues, savedIndex)
                savedStartBar = array.get(savedStartBars, savedIndex)
                savedDirection = array.get(savedDirections, savedIndex)
                waveSize = math.abs(savedTrail - savedFib1)
                for fibIndex = 0 to array.size(extensionLevels) - 1
                    fibLevel = array.get(extensionLevels, fibIndex)
                    fibColor = array.get(extensionColors, fibIndex)
                    priceLevel = savedFib1 + savedDirection * waveSize * (fibLevel - 1)
                    ntsLineWidth = fibLevel >= 4.414 ? 2 : 1
                    lineStyleValue = fibLevel >= 4.414 ? line.style_solid : line.style_dashed
                    createdLine = line.new(
                         savedStartBar,
                         priceLevel,
                         bar_index,
                         priceLevel,
                         xloc=xloc.bar_index,
                         extend=extend.right,
                         color=color.new(fibColor, ntsLineTransparency),
                         style=lineStyleValue,
                         width=ntsLineWidth)
                    array.push(extensionLines, createdLine)
                    if showNtsLabels
                        int selectedX = bar_index
                        selectedStyle = label.style_label_left
                        if ntsLabelPosition == "left"
                            selectedX := savedStartBar
                            selectedStyle := label.style_label_right
                        else if ntsLabelPosition == "center"
                            selectedX := int(math.round((savedStartBar + bar_index) / 2))
                            selectedStyle := label.style_label_center
                        else
                            selectedX := bar_index + ntsLabelOffset
                            selectedStyle := label.style_label_left
                        createdLabel = label.new(
                             selectedX,
                             priceLevel,
                             str.tostring(fibLevel, "#.###"),
                             xloc=xloc.bar_index,
                             yloc=yloc.price,
                             style=selectedStyle,
                             color=color.new(fibColor, ntsLabelTransparency),
                             textcolor=labelTextColor,
                             size=labelSizeFromText(ntsLabelSize))
                        array.push(extensionLabels, createdLabel)
// ============================================================================
// NTS Extension Signals (فوق دقیق - با تأیید کلوز بعد از لمس سطح)
// ============================================================================
activeWaveSize = na(activeFib1) ? na : math.abs(activeTrail - activeFib1)
level0300 = na(activeWaveSize) ? na : activeFib1 + activeDirection * activeWaveSize * (0.300 - 1)
level1470 = na(activeWaveSize) ? na : activeFib1 + activeDirection * activeWaveSize * (1.470 - 1)
level2100 = na(activeWaveSize) ? na : activeFib1 + activeDirection * activeWaveSize * (2.100 - 1)
level2618 = na(activeWaveSize) ? na : activeFib1 + activeDirection * activeWaveSize * (2.618 - 1)
level3000 = na(activeWaveSize) ? na : activeFib1 + activeDirection * activeWaveSize * (3.000 - 1)
level4414 = na(activeWaveSize) ? na : activeFib1 + activeDirection * activeWaveSize * (4.414 - 1)
level4764 = na(activeWaveSize) ? na : activeFib1 + activeDirection * activeWaveSize * (4.764 - 1)
level6618 = na(activeWaveSize) ? na : activeFib1 + activeDirection * activeWaveSize * (6.618 - 1)
level8618 = na(activeWaveSize) ? na : activeFib1 + activeDirection * activeWaveSize * (8.618 - 1)
level10618 = na(activeWaveSize) ? na : activeFib1 + activeDirection * activeWaveSize * (10.618 - 1)
priceBrokeAbove(level) =>
    not na(level) and high >= level
priceBrokeBelow(level) =>
    not na(level) and low <= level
hasRejectionWick(side) =>
    bodySize = math.abs(close - open)
    upperWick = high - math.max(open, close)
    lowerWick = math.min(open, close) - low
    if bodySize <= 0
        false
    else
        if side == -1
            upperWick > bodySize * 0.8 and upperWick > lowerWick * 1.2
        else
            lowerWick > bodySize * 0.8 and lowerWick > upperWick * 1.2
rsiTurnConfirmation(side) =>
    currentRsi = ta.rsi(close, rsiLengthInput)
    if side == -1
        currentRsi < currentRsi[1]
    else
        currentRsi > currentRsi[1]
g_rsiTurnSell = rsiTurnConfirmation(-1)
g_rsiTurnBuy  = rsiTurnConfirmation(1)
preciseSellReaction(level, bodyThreshold) =>
    if na(level)
        false
    else
        body = math.abs(close - open)
        rangeCandle = high - low
        bodyRatio = rangeCandle > 0 ? body / rangeCandle : 0
        upperWick = high - math.max(open, close)
        brokeAbove = priceBrokeAbove(level)
        closeBelowLevel = close < level
        bearishCandle = close < open
        strongBody = bodyRatio >= bodyThreshold
        upperWickAboveLevel = high - level
        engulfedLevel = open > level and close < level
        rejectionEvidence = upperWickAboveLevel > body * 0.5 or engulfedLevel
        rsiOK = not ntsUseRsiTurn or g_rsiTurnSell
        brokeAbove and closeBelowLevel and bearishCandle and strongBody and rejectionEvidence and rsiOK
preciseBuyReaction(level, bodyThreshold) =>
    if na(level)
        false
    else
        body = math.abs(close - open)
        rangeCandle = high - low
        bodyRatio = rangeCandle > 0 ? body / rangeCandle : 0
        lowerWick = math.min(open, close) - low
        brokeBelow = priceBrokeBelow(level)
        closeAboveLevel = close > level
        bullishCandle = close > open
        strongBody = bodyRatio >= bodyThreshold
        lowerWickBelowLevel = level - low
        engulfedLevel = open < level and close > level
        rejectionEvidence = lowerWickBelowLevel > body * 0.5 or engulfedLevel
        rsiOK = not ntsUseRsiTurn or g_rsiTurnBuy
        brokeBelow and closeAboveLevel and bullishCandle and strongBody and rejectionEvidence and rsiOK
simplePreciseSellReaction(level, bodyThreshold) =>
    if na(level)
        false
    else
        body = math.abs(close - open)
        candleRange = high - low
        bodyRatio = candleRange > 0 ? body / candleRange : 0.0
        priceTouched = high >= level
        closeBackBelow = close < level
        bearishCandle = close < open
        strongBody = bodyRatio >= bodyThreshold
        priceTouched and closeBackBelow and bearishCandle and strongBody
simplePreciseBuyReaction(level, bodyThreshold) =>
    if na(level)
        false
    else
        body = math.abs(close - open)
        candleRange = high - low
        bodyRatio = candleRange > 0 ? body / candleRange : 0.0
        priceTouched = low <= level
        closeBackAbove = close > level
        bullishCandle = close > open
        strongBody = bodyRatio >= bodyThreshold
        priceTouched and closeBackAbove and bullishCandle and strongBody
sell0300_reaction = simplePreciseSellReaction(level0300, 0.30)
buy0300_reaction  = simplePreciseBuyReaction(level0300, 0.30)
sell1470_reaction = simplePreciseSellReaction(level1470, 0.30)
buy1470_reaction  = simplePreciseBuyReaction(level1470, 0.30)
sell2100_reaction = simplePreciseSellReaction(level2100, 0.30)
buy2100_reaction  = simplePreciseBuyReaction(level2100, 0.30)
sell2618_reaction = preciseSellReaction(level2618, ntsDynBody)
sell3000_reaction = preciseSellReaction(level3000, ntsDynBody)
buy2618_reaction  = preciseBuyReaction(level2618, ntsDynBody)
buy3000_reaction  = preciseBuyReaction(level3000, ntsDynBody)
sell4414_reaction = preciseSellReaction(level4414, ntsDynBody + 0.05)
sell4764_reaction = preciseSellReaction(level4764, ntsDynBody + 0.05)
buy4414_reaction  = preciseBuyReaction(level4414, ntsDynBody + 0.05)
buy4764_reaction  = preciseBuyReaction(level4764, ntsDynBody + 0.05)
sell6618_reaction = preciseSellReaction(level6618, ntsDynBody + 0.10)
sell8618_reaction = preciseSellReaction(level8618, ntsDynBody + 0.10)
buy6618_reaction  = preciseBuyReaction(level6618, ntsDynBody + 0.10)
buy8618_reaction  = preciseBuyReaction(level8618, ntsDynBody + 0.10)
sell10618_reaction = preciseSellReaction(level10618, ntsDynBody + 0.15)
buy10618_reaction  = preciseBuyReaction(level10618, ntsDynBody + 0.15)
recentSwingHigh = ta.highest(high, ntsChochLookback)[1]
recentSwingLow = ta.lowest(low, ntsChochLookback)[1]
bullishChoch = (
     not na(recentSwingHigh) and
     close > recentSwingHigh and
     close[1] <= recentSwingHigh
)
bearishChoch = (
     not na(recentSwingLow) and
     close < recentSwingLow and
     close[1] >= recentSwingLow
)
ntsBullishChoch = (
     ntsTrend == 1 and
     bullishChoch
)
ntsBearishChoch = (
     ntsTrend == -1 and
     bearishChoch
)
var int barsSinceWaveStart = 0
if ntsTrendChange
    barsSinceWaveStart := 0
else
    barsSinceWaveStart := barsSinceWaveStart + 1
isEarlyWave = barsSinceWaveStart <= 30
var bool fib1470PullbackTouched = false
var bool fib2100PullbackTouched = false
if ntsTrendChange
    fib1470PullbackTouched := false
    fib2100PullbackTouched := false
if activeDirection == 1
    if not na(level1470) and low <= level1470
        fib1470PullbackTouched := true
    if not na(level2100) and low <= level2100
        fib2100PullbackTouched := true
if activeDirection == -1
    if not na(level1470) and high >= level1470
        fib1470PullbackTouched := true
    if not na(level2100) and high >= level2100
        fib2100PullbackTouched := true
sell0300 = 
     activeDirection == -1 and
     ntsTrend == -1 and
     isEarlyWave and
     not na(level0300) and
     sell0300_reaction

buy0300 = 
     activeDirection == 1 and
     ntsTrend == 1 and
     isEarlyWave and
     not na(level0300) and
     buy0300_reaction

sell1470 = (
     activeDirection == -1 and
     ntsTrend == -1 and
     isEarlyWave and
     fib1470PullbackTouched and
     not na(level1470) and
     sell1470_reaction and
     (not ntsRequireChoch or ntsBearishChoch)
)

buy1470 = (
     activeDirection == 1 and
     ntsTrend == 1 and
     isEarlyWave and
     fib1470PullbackTouched and
     not na(level1470) and
     buy1470_reaction and
     (not ntsRequireChoch or ntsBullishChoch)
)

sell2100 = (
     activeDirection == -1 and
     ntsTrend == -1 and
     isEarlyWave and
     fib2100PullbackTouched and
     not na(level2100) and
     sell2100_reaction and
     (not ntsRequireChoch or ntsBearishChoch)
)

buy2100 = (
     activeDirection == 1 and
     ntsTrend == 1 and
     isEarlyWave and
     fib2100PullbackTouched and
     not na(level2100) and
     buy2100_reaction and
     (not ntsRequireChoch or ntsBullishChoch)
)

sell2618 = 
     activeDirection == 1 and 
     not na(level2618) and 
     sell2618_reaction
sell3000 = 
     activeDirection == 1 and 
     not na(level3000) and 
     sell3000_reaction
buy2618 = 
     activeDirection == -1 and 
     not na(level2618) and 
     buy2618_reaction
buy3000 = 
     activeDirection == -1 and 
     not na(level3000) and 
     buy3000_reaction
sell4414 = 
     activeDirection == 1 and 
     not na(level4414) and 
     sell4414_reaction
sell4764 = 
     activeDirection == 1 and 
     not na(level4764) and 
     sell4764_reaction
buy4414 = 
     activeDirection == -1 and 
     not na(level4414) and 
     buy4414_reaction
buy4764 = 
     activeDirection == -1 and 
     not na(level4764) and 
     buy4764_reaction
sell6618 = 
     activeDirection == 1 and 
     not na(level6618) and 
     sell6618_reaction
sell8618 = 
     activeDirection == 1 and 
     not na(level8618) and 
     sell8618_reaction
buy6618 = 
     activeDirection == -1 and 
     not na(level6618) and 
     buy6618_reaction
buy8618 = 
     activeDirection == -1 and 
     not na(level8618) and 
     buy8618_reaction
sell10618 = 
     activeDirection == 1 and 
     not na(level10618) and 
     sell10618_reaction
buy10618 = 
     activeDirection == -1 and 
     not na(level10618) and 
     buy10618_reaction
signalSell0300 = sell0300
signalBuy0300  = buy0300
signalSell1470 = sell1470
signalBuy1470  = buy1470
signalSell2100 = sell2100
signalBuy2100  = buy2100
signalSell2618_3000 = sell2618 or sell3000
signalBuy2618_3000  = buy2618  or buy3000
signalSell4414_4764 = sell4414 or sell4764
signalBuy4414_4764  = buy4414  or buy4764
signalSell6618_8618 = sell6618 or sell8618
signalBuy6618_8618  = buy6618  or buy8618
signalSell10618 = sell10618
signalBuy10618  = buy10618
fib1SellReaction =
     not na(ntsFib1) and
     high >= ntsFib1 and
     close < ntsFib1 and
     close < open and
     ntsBodyPct >= ntsDynBody * 0.75 and
     (ntsFib1 - close) >= ntsMinReact * 0.25
fib2SellReaction =
     not na(ntsFib2) and
     high >= ntsFib2 and
     close < ntsFib2 and
     close < open and
     ntsBodyPct >= ntsDynBody * 0.75 and
     (ntsFib2 - close) >= ntsMinReact * 0.25
fib3SellReaction =
     not na(ntsFib3) and
     high >= ntsFib3 and
     close < ntsFib3 and
     close < open and
     ntsBodyPct >= ntsDynBody * 0.75 and
     (ntsFib3 - close) >= ntsMinReact * 0.25
fib1BuyReaction =
     not na(ntsFib1) and
     low <= ntsFib1 and
     close > ntsFib1 and
     close > open and
     ntsBodyPct >= ntsDynBody * 0.75 and
     (close - ntsFib1) >= ntsMinReact * 0.25
fib2BuyReaction =
     not na(ntsFib2) and
     low <= ntsFib2 and
     close > ntsFib2 and
     close > open and
     ntsBodyPct >= ntsDynBody * 0.75 and
     (close - ntsFib2) >= ntsMinReact * 0.25
fib3BuyReaction =
     not na(ntsFib3) and
     low <= ntsFib3 and
     close > ntsFib3 and
     close > open and
     ntsBodyPct >= ntsDynBody * 0.75 and
     (close - ntsFib3) >= ntsMinReact * 0.25
cooldownPassed(lastBar, cooldown) =>
    cooldown == 0 or na(lastBar) or (bar_index - lastBar > cooldown)
var int lastNtsBuy0300Bar = na
var int lastNtsSell0300Bar = na
var int lastNtsBuy1470Bar = na
var int lastNtsSell1470Bar = na
var int lastNtsBuy2100Bar = na
var int lastNtsSell2100Bar = na
var int lastNtsBuy2618_3000Bar = na
var int lastNtsSell2618_3000Bar = na
var int lastNtsBuy4414_4764Bar = na
var int lastNtsSell4414_4764Bar = na
var int lastNtsBuy6618_8618Bar = na
var int lastNtsSell6618_8618Bar = na
var int lastNtsBuy10618Bar = na
var int lastNtsSell10618Bar = na
var int lastNtsBuyFib1Bar = na
var int lastNtsSellFib1Bar = na
var int lastNtsBuyFib2Bar = na
var int lastNtsSellFib2Bar = na
var int lastNtsBuyFib3Bar = na
var int lastNtsSellFib3Bar = na
ntsBuy0300CooldownPassed  = cooldownPassed(lastNtsBuy0300Bar,  int(math.round(ntsCooldown0300 * ntsCdScale)))
ntsSell0300CooldownPassed = cooldownPassed(lastNtsSell0300Bar, int(math.round(ntsCooldown0300 * ntsCdScale)))
ntsBuy1470CooldownPassed  = cooldownPassed(lastNtsBuy1470Bar,  int(math.round(ntsCooldown1470 * ntsCdScale)))
ntsSell1470CooldownPassed = cooldownPassed(lastNtsSell1470Bar, int(math.round(ntsCooldown1470 * ntsCdScale)))
ntsBuy2100CooldownPassed  = cooldownPassed(lastNtsBuy2100Bar,  int(math.round(ntsCooldown2100 * ntsCdScale)))
ntsSell2100CooldownPassed = cooldownPassed(lastNtsSell2100Bar, int(math.round(ntsCooldown2100 * ntsCdScale)))
ntsBuy2618_3000CooldownPassed  = cooldownPassed(lastNtsBuy2618_3000Bar,  int(math.round(ntsCooldown2618_3000 * ntsCdScale)))
ntsSell2618_3000CooldownPassed = cooldownPassed(lastNtsSell2618_3000Bar, int(math.round(ntsCooldown2618_3000 * ntsCdScale)))
ntsBuy4414_4764CooldownPassed  = cooldownPassed(lastNtsBuy4414_4764Bar,  int(math.round(ntsCooldown4414_4764 * ntsCdScale)))
ntsSell4414_4764CooldownPassed = cooldownPassed(lastNtsSell4414_4764Bar, int(math.round(ntsCooldown4414_4764 * ntsCdScale)))
ntsBuy6618_8618CooldownPassed  = cooldownPassed(lastNtsBuy6618_8618Bar,  int(math.round(ntsCooldown6618_8618 * ntsCdScale)))
ntsSell6618_8618CooldownPassed = cooldownPassed(lastNtsSell6618_8618Bar, int(math.round(ntsCooldown6618_8618 * ntsCdScale)))
ntsBuy10618CooldownPassed  = cooldownPassed(lastNtsBuy10618Bar,  int(math.round(ntsCooldown10618 * ntsCdScale)))
ntsSell10618CooldownPassed = cooldownPassed(lastNtsSell10618Bar, int(math.round(ntsCooldown10618 * ntsCdScale)))
ntsBuyFib1CooldownPassed  = cooldownPassed(lastNtsBuyFib1Bar, int(math.round(ntsCooldownFib1 * ntsCdScale)))
ntsSellFib1CooldownPassed = cooldownPassed(lastNtsSellFib1Bar, int(math.round(ntsCooldownFib1 * ntsCdScale)))
ntsBuyFib2CooldownPassed  = cooldownPassed(lastNtsBuyFib2Bar, int(math.round(ntsCooldownFib2 * ntsCdScale)))
ntsSellFib2CooldownPassed = cooldownPassed(lastNtsSellFib2Bar, int(math.round(ntsCooldownFib2 * ntsCdScale)))
ntsBuyFib3CooldownPassed  = cooldownPassed(lastNtsBuyFib3Bar, int(math.round(ntsCooldownFib3 * ntsCdScale)))
ntsSellFib3CooldownPassed = cooldownPassed(lastNtsSellFib3Bar, int(math.round(ntsCooldownFib3 * ntsCdScale)))
allowNtsSell = ntsSignalFilter == "همه سیگنال‌ها" or ntsSignalFilter == "فقط SELL فیبو"
allowNtsBuy  = ntsSignalFilter == "همه سیگنال‌ها" or ntsSignalFilter == "فقط BUY فیبو"
strongBullTrend = ntsTrend == 1 and adxForNts >= ntsStrongAdx and diPlusNts > diMinusNts
strongBearTrend = ntsTrend == -1 and adxForNts >= ntsStrongAdx and diMinusNts > diPlusNts
mildBullTrend = ntsTrend == 1 and adxForNts >= ntsMildAdx and not strongBullTrend
mildBearTrend = ntsTrend == -1 and adxForNts >= ntsMildAdx and not strongBearTrend
ntsRsiNow = ta.rsi(close, rsiLengthInput)
ntsCounterBuyConfirm = revBuyOk or ntsRsiNow <= 32
ntsCounterSellConfirm = revSellOk or ntsRsiNow >= 68
ntsBuyTrendOk =
     ntsTrend == 1 or
     (not strongBearTrend and (not mildBearTrend or ntsCounterBuyConfirm))
ntsSellTrendOk =
     ntsTrend == -1 or
     (not strongBullTrend and (not mildBullTrend or ntsCounterSellConfirm))
     // ============================================================================
// فیلتر اختصاصی سیگنال‌های بازگشتی اکستنشن
// اکستنشن‌های عمیق برخلاف Fib 0.300/1.470/2.100 ماهیت بازگشتی دارند.
// ============================================================================

// فروش بازگشتی در انتهای موج صعودی
extensionSellLocationOk =
     activeDirection == 1 and
     (
         inRevSellZone or
         revSellRecent
     )

extensionSellMomentumOk =
     ntsRsiNow >= 60 or
     ntsBearishChoch

extensionSellOk =
     extensionSellLocationOk and
     extensionSellMomentumOk

// خرید بازگشتی در انتهای موج نزولی
extensionBuyLocationOk =
     activeDirection == -1 and
     (
         inRevBuyZone or
         revBuyRecent
     )

extensionBuyMomentumOk =
     ntsRsiNow <= 40 or
     ntsBullishChoch

extensionBuyOk =
     extensionBuyLocationOk and
     extensionBuyMomentumOk

finalNtsBuy0300 = 
     showNtsMain and
     ntsShowReversal and
     allowNtsBuy and
     showNtsFib0300 and
     signalBuy0300 and
     ntsBuy0300CooldownPassed and xauTradeOk and ntsBuyTrendOk
finalNtsSell0300 = 
     showNtsMain and
     ntsShowReversal and
     allowNtsSell and
     showNtsFib0300 and
     signalSell0300 and
     ntsSell0300CooldownPassed and xauTradeOk and ntsSellTrendOk
finalNtsBuy1470 = 
     showNtsMain and
     ntsShowReversal and
     allowNtsBuy and
     showNtsFib1470 and
     signalBuy1470 and
     ntsBuy1470CooldownPassed and xauTradeOk and ntsBuyTrendOk
finalNtsSell1470 = 
     showNtsMain and
     ntsShowReversal and
     allowNtsSell and
     showNtsFib1470 and
     signalSell1470 and
     ntsSell1470CooldownPassed and xauTradeOk and ntsSellTrendOk
finalNtsBuy2100 = 
     showNtsMain and
     ntsShowReversal and
     allowNtsBuy and
     showNtsFib2100 and
     signalBuy2100 and
     ntsBuy2100CooldownPassed and xauTradeOk and ntsBuyTrendOk
finalNtsSell2100 = 
     showNtsMain and
     ntsShowReversal and
     allowNtsSell and
     showNtsFib2100 and
     signalSell2100 and
     ntsSell2100CooldownPassed and xauTradeOk and ntsSellTrendOk
finalNtsBuy2618_3000 = 
     showNtsMain and
     ntsShowReversal and
     allowNtsBuy and
     showNtsFib2618_3000 and
     signalBuy2618_3000 and
     ntsBuy2618_3000CooldownPassed and
     xauTradeOk and
     extensionBuyOk

finalNtsSell2618_3000 = 
     showNtsMain and
     ntsShowReversal and
     allowNtsSell and
     showNtsFib2618_3000 and
     signalSell2618_3000 and
     ntsSell2618_3000CooldownPassed and
     xauTradeOk and
     extensionSellOk


finalNtsBuy4414_4764 = 
     showNtsMain and
     ntsShowReversal and
     allowNtsBuy and
     showNtsFib4414_4764 and
     signalBuy4414_4764 and
     ntsBuy4414_4764CooldownPassed and
     xauTradeOk and
     extensionBuyOk

finalNtsSell4414_4764 = 
     showNtsMain and
