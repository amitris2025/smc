//@version=5
// ============================================================================
//  SMC + NTS Pro  —  نسخه نهایی و کامل (Pine Script v5)
//  پیاده‌سازیِ هر ۹ بهبود + هسته پایه، در یک فایل مستقل
// ============================================================================
//  نشانیِ بهبودها در کد:  M01 ... M09
//
//  ترتیب اجرا در Pine خطی است و در این فایل رعایت شده:
//    ورودی‌ها → M09a → M01 → ADX → M03 → M09b → M02 → هسته NTS → مشتقات
//    → M05 → M04 → M07a → M10 → M06 → M07b → نمایش/هشدار (M08)
//
//  خلاصه ۹ بهبود:
//    M01 تفکیک حالت تریدینگ از تایم‌فریم پایه (وزن‌دهی هوشمند)
//    M02 True Range دقیق‌تر با در نظر گرفتن گپ‌های قیمتی
//    M03 تشخیص رژیم رنج/روند با ترکیب ADX و ATR نرمال‌شده
//    M04 فیلتر سشن و نوسان مخصوص XAUUSD + امتیاز سشن طلایی
//    M05 Reversal Cloud پویا بر اساس نوسان
//    M06 امتیازدهی Confluence (حداکثر ۱۵۱ امتیاز) با آستانه پویا
//    M07 فیلترهای تکمیلی: خرید در تخفیف / فروش در پریمیوم
//    M08 پنل اطلاعات و هشدارهای دقیق
//    M09 تنظیم خودکار کامل بر اساس نوع نماد
//    M10 خطوط روندِ اصولیِ پرایس‌اکشن + ناحیهٔ Previous Daily Premium/Discount
//
//  نکته: کامپایلر رسمی تریدینگ‌ویو در این محیط در دسترس نیست؛
//  این فایل از نظر نحو و ساختار با tools/check_pine.py بررسی شده است،
//  اما تأیید نهایی با یک بار Add to chart در تریدینگ‌ویو انجام شود.
// ============================================================================
indicator("SMC + NTS Pro (Final)", shorttitle="SMC/NTS Pro",
     overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ============================================================================
//  ▍ورودی‌ها
// ============================================================================
gNTS  = "NTS — هسته"
gFilt = "NTS — فیلترها"
gKD   = "NTS — نوسان‌نما و میانگین"
gAuto = "تنظیم خودکار"
gDisp = "نمایش"
gTL   = "خطوط روند (Price Action)"

// --- هسته NTS ---
ntsTradingMode   = input.string("سوینگ تریدینگ", "حالت تریدینگ",
     options=["اسکالپینگ", "ترید روزانه", "سوینگ تریدینگ", "پوزیشن تریدینگ"], group=gNTS)
ntsBaseTimeframe = input.string("15", "تایم‌فریم پایه NTS",
     options=["1", "3", "5", "15", "30", "60", "240"], group=gNTS)
ntsTrailType     = input.string("modified", "نوع محاسبه True Range",
     options=["modified", "classic"], group=gNTS)
swingLen         = input.int(7, "طول سویینگ (پیوت)", minval=2, maxval=50, group=gNTS)
fibLo            = input.float(0.618, "فیب OTE پایین", step=0.001, group=gNTS)
fibHi            = input.float(0.786, "فیب OTE بالا",  step=0.001, group=gNTS)
adxLen           = input.int(14, "دوره ADX", minval=2, group=gNTS)
ntsMildAdx       = input.float(18.0, "آستانه ADX متوسط", step=0.5, group=gNTS)
ntsStrongAdx     = input.float(25.0, "آستانه ADX قوی",   step=0.5, group=gNTS)

// --- فیلترها ---
useSessionFilter       = input.bool(true,  "فیلتر سشن (لندن + نیویورک)", group=gFilt)
xauMinAtrPct           = input.float(0.06, "حداقل نوسان (ATR٪)", step=0.01, group=gFilt)
useReversalCloudFilter = input.bool(true,  "فیلتر ابر ریورسال", group=gFilt)
useDailyZoneFilter     = input.bool(true,  "فیلتر ناحیه روزانه (خرید در تخفیف / فروش در پریمیوم)", group=gFilt)
bandDev1               = input.float(0.5,   "انحراف ابر ۱", step=0.05, group=gFilt)
bandDev2               = input.float(1.0,   "انحراف ابر ۲", step=0.05, group=gFilt)
bandDev3               = input.float(1.618, "انحراف ابر ۳", step=0.05, group=gFilt)

// --- نوسان‌نماها ---
kdLen   = input.int(14, "دوره KD", minval=2, group=gKD)
kSmooth = input.int(3,  "همواری K", minval=1, group=gKD)
dSmooth = input.int(3,  "همواری D", minval=1, group=gKD)
rsiLen  = input.int(14, "دوره RSI", minval=2, group=gKD)

// --- تنظیم خودکار و نمایش ---
autoTuneThisChart = input.bool(false, "تنظیم خودکار بر اساس نماد", group=gAuto)
showAutoTunePanel = input.bool(true,  "نمایش پنل تنظیمات", group=gDisp)

// --- خطوط روند پرایس‌اکشن (M10) ---
showTrendlines = input.bool(true, "نمایش خطوط روند", group=gTL)
tlPivotLeft    = input.int(5, "کندل‌های چپِ پیوت (سقف/کف)", minval=1, maxval=50, group=gTL)
tlPivotRight   = input.int(3, "کندل‌های راستِ پیوت (تایید)", minval=1, maxval=25, group=gTL)
tlTouchBasis   = input.string("کلوز", "مبنای لمس و شکست",
     options=["کلوز", "سایه (High/Low)"], group=gTL)
tlMinTouches   = input.int(2, "حداقل لمس برای ترسیم", minval=2, maxval=5, group=gTL)
tlTolAtr       = input.float(0.35, "تلورانس لمس (ضریب ATR)", minval=0.0, step=0.05, group=gTL)
tlBreakAtr     = input.float(0.10, "تلورانس شکست (ضریب ATR)", minval=0.0, step=0.05, group=gTL)
tlReanchor     = input.bool(true,  "بازترسیم روی دو سقف/کف آخر در صورت لمس‌نشدن", group=gTL)
tlPdMode       = input.string("تاکید روی همسو", "نقش پریمیوم/دیسکانت روزانهٔ قبل",
     options=["بدون فیلتر", "تاکید روی همسو", "فقط همسو"], group=gTL)
showPdZones    = input.bool(true, "نمایش نواحی روزانهٔ قبل", group=gTL)
showTlLabels   = input.bool(true, "برچسب نقاط لمس و شکست", group=gTL)
tlMaxLines     = input.int(12, "حداکثر خطوط بایگانی‌شده", minval=2, maxval=100, group=gTL)
tlBonus        = input.int(5, "امتیاز Confluence برای لمس خط روند", minval=0, maxval=20, group=gTL)

// ============================================================================
//  ▍M09a — بهبود ۹ (الف): تشخیص خودکار نوع نماد
// ============================================================================
symU = str.upper(syminfo.ticker)

// اصلاح: بررسی کریپتو «قبل از» USD، وگرنه BTCUSD اشتباهاً forex شناسایی می‌شود
autoSymbolType =
     str.contains(symU, "XAU")  or str.contains(symU, "GOLD") ? "gold"   :
     str.contains(symU, "XAG")                                ? "silver" :
     str.contains(symU, "BTC")  or str.contains(symU, "ETH")  ? "crypto" :
     (str.contains(symU, "USD") and not str.contains(symU, "USDT")) or
     str.contains(symU, "EUR")  or str.contains(symU, "GBP")  or
     str.contains(symU, "JPY")                                ? "forex"  :
     "other"

autoPeriod = autoSymbolType == "gold"   ? 10 :
     autoSymbolType == "silver"         ? 12 :
     autoSymbolType == "forex"          ? 8  :
     autoSymbolType == "crypto"         ? 14 :
     10

autoFactor = autoSymbolType == "gold"   ? 3.5 :
     autoSymbolType == "silver"         ? 4.0 :
     autoSymbolType == "forex"          ? 3.0 :
     autoSymbolType == "crypto"         ? 5.0 :
     3.5

autoMinAtrPct = autoSymbolType == "gold"   ? 0.06 :
     autoSymbolType == "silver"            ? 0.08 :
     autoSymbolType == "forex"             ? 0.05 :
     autoSymbolType == "crypto"            ? 0.15 :
     0.06

// ورودی‌ها در Pine قابل بازنویسی نیستند → متغیر مؤثر
xauMinAtrPctEff = autoTuneThisChart ? autoMinAtrPct : xauMinAtrPct

// ============================================================================
//  ▍M01 — بهبود ۱: تفکیک حالت تریدینگ از تایم‌فریم پایه
// ============================================================================
// --- ۱.۱ از حالت تریدینگ ---
basePeriod = ntsTradingMode == "اسکالپینگ"      ? 5  :
     ntsTradingMode == "ترید روزانه"           ? 10 :
     ntsTradingMode == "سوینگ تریدینگ"         ? 15 :
     20   // پوزیشن تریدینگ

baseFactor = ntsTradingMode == "اسکالپینگ"      ? 2.0 :
     ntsTradingMode == "ترید روزانه"           ? 3.5 :
     ntsTradingMode == "سوینگ تریدینگ"         ? 5.0 :
     7.0  // پوزیشن تریدینگ

// --- ۱.۲ از تایم‌فریم پایه (مستقل از حالت تریدینگ) ---
ntsBasePeriod = ntsBaseTimeframe == "1"   ? 3  :
     ntsBaseTimeframe == "3"              ? 5  :
     ntsBaseTimeframe == "5"              ? 7  :
     ntsBaseTimeframe == "15"             ? 10 :
     ntsBaseTimeframe == "30"             ? 12 :
     ntsBaseTimeframe == "60"             ? 15 :
     ntsBaseTimeframe == "240"            ? 20 :
     10

ntsBaseFactor = ntsBaseTimeframe == "1"   ? 1.5 :
     ntsBaseTimeframe == "3"              ? 2.0 :
     ntsBaseTimeframe == "5"              ? 2.5 :
     ntsBaseTimeframe == "15"             ? 3.5 :
     ntsBaseTimeframe == "30"             ? 4.0 :
     ntsBaseTimeframe == "60"             ? 5.0 :
     ntsBaseTimeframe == "240"            ? 6.0 :
     3.5

// --- ۱.۳ وزن‌دهی هوشمند ---
// اگر تایم‌فریم پایه با حالت تریدینگ هماهنگ باشد، وزن حالت تریدینگ بیشتر است
ntsTfWeight = (ntsTradingMode == "اسکالپینگ"      and ntsBaseTimeframe == "5")  or
     (ntsTradingMode == "ترید روزانه"            and ntsBaseTimeframe == "15") or
     (ntsTradingMode == "سوینگ تریدینگ"          and ntsBaseTimeframe == "30") or
     (ntsTradingMode == "پوزیشن تریدینگ"         and ntsBaseTimeframe == "60") ? 0.7 : 0.4

// --- ۱.۴ مقدار نهایی با محدودسازی ---
ntsPeriod = int(math.round(basePeriod * ntsTfWeight + ntsBasePeriod * (1 - ntsTfWeight)))
ntsPeriod := math.max(4, math.min(40, ntsPeriod))

ntsFactor = baseFactor * ntsTfWeight + ntsBaseFactor * (1 - ntsTfWeight)
ntsFactor := math.max(1.5, math.min(20.0, ntsFactor))

// ============================================================================
//  ▍ADX / DI  (پیش‌نیاز M03)
// ============================================================================
[dmiPlus, dmiMinus, adxRaw] = ta.dmi(adxLen, adxLen)
adxVal    = adxRaw
adxSmooth = ta.sma(adxVal, 3)
adxForNts = adxVal

// ============================================================================
//  ▍M03 — بهبود ۳: تشخیص رژیم روند/رنج با ADX + ATR نرمال‌شده
// ============================================================================
atrSeed = ta.atr(14)
atrMean = ta.sma(atrSeed, 80)
atrNorm = atrMean > 0 ? atrSeed / atrMean : 1.0
atrNorm := math.max(0.50, math.min(2.20, atrNorm))

// رنج: ADX ضعیف و نوسان پایین
chopRegime = adxSmooth < ntsMildAdx and atrNorm < 1.2
// روند: ADX قوی، یا ADX متوسط همراه با نوسان بالا
trendRegime = adxSmooth >= ntsStrongAdx or (adxSmooth >= ntsMildAdx and atrNorm >= 1.5)

// رنج → دوره بلندتر (فیلتر نویز) | روند → دوره کوتاه‌تر (واکنش سریع‌تر)
if chopRegime
    ntsPeriod := math.max(4, int(ntsPeriod * 1.2))
else if trendRegime
    ntsPeriod := math.max(4, int(ntsPeriod * 0.85))
// از این نقطه به بعد ntsPeriod یک series int است و دیگر نمی‌توان آن را
// به عنوان طول (length) به توابع ta.* داد (آن‌ها simple int می‌خواهند).

// ============================================================================
//  ▍M09b — بهبود ۹ (ب): اعمال تنظیم خودکار روی هسته
// ============================================================================
ntsPeriodFinal = autoTuneThisChart ? autoPeriod : ntsPeriod
ntsPeriodFinal := math.max(4, math.min(40, ntsPeriodFinal))

ntsFactorFinal = autoTuneThisChart ? autoFactor : ntsFactor
ntsFactorFinal := math.max(1.5, math.min(20.0, ntsFactorFinal))

// ============================================================================
//  ▍M02 — بهبود ۲: True Range دقیق‌تر با در نظر گرفتن گپ‌ها
// ============================================================================
ntsHigh  = request.security(syminfo.tickerid, ntsBaseTimeframe, high,  barmerge.gaps_off, barmerge.lookahead_off)
ntsLow   = request.security(syminfo.tickerid, ntsBaseTimeframe, low,   barmerge.gaps_off, barmerge.lookahead_off)
ntsClose = request.security(syminfo.tickerid, ntsBaseTimeframe, close, barmerge.gaps_off, barmerge.lookahead_off)

ntsHiLo = ntsHigh - ntsLow
ntsHRef = math.abs(ntsHigh - ntsClose[1])
ntsLRef = math.abs(ntsLow  - ntsClose[1])

// گپ بین کندل قبلی و فعلی
ntsGapUp   = ntsLow  > ntsHigh[1]
ntsGapDown = ntsHigh < ntsLow[1]

ntsTrueRange = ntsTrailType == "modified" ?
     math.max(ntsHiLo, math.max(ntsHRef, ntsLRef)) :
     math.max(ntsHigh - ntsLow, math.max(math.abs(ntsHigh - ntsClose[1]),
                                         math.abs(ntsLow  - ntsClose[1])))

// فقط نیمی از اندازه گپ اضافه می‌شود (جلوگیری از بزرگ‌نمایی نویز)
ntsGapAdjustment = ntsGapUp   ? ntsLow - ntsHigh[1] :
     ntsGapDown              ? ntsLow[1] - ntsHigh  :
     0.0

ntsTrueRange := nz(ntsTrueRange, ntsHigh - ntsLow) + ntsGapAdjustment * 0.5

// ============================================================================
//  ▍هسته NTS: تریلینگ‌استاپ ATR روی داده‌های تایم‌فریم پایه
// ============================================================================
// هموارسازی وایلدر به‌صورت بازگشت دستی (RMA = EMA با آلفای ۱/دوره)؛
// چون ntsPeriodFinal یک series int است و ta.rma آن را نمی‌پذیرد.
var float ntsATR = na
ntsATRalpha = 1.0 / ntsPeriodFinal
ntsATR := na(ntsATR[1]) ? nz(ntsTrueRange) :
     ntsATR[1] + ntsATRalpha * (ntsTrueRange - ntsATR[1])

ntsSrc       = (ntsHigh + ntsLow) / 2
ntsUpBandRaw = ntsSrc - ntsFactorFinal * ntsATR
ntsDnBandRaw = ntsSrc + ntsFactorFinal * ntsATR

var float ntsUpBand = na
var float ntsDnBand = na
ntsUpBand := na(ntsUpBand[1]) ? ntsUpBandRaw :
     (ntsClose[1] > ntsUpBand[1] ? math.max(ntsUpBandRaw, ntsUpBand[1]) : ntsUpBandRaw)
ntsDnBand := na(ntsDnBand[1]) ? ntsDnBandRaw :
     (ntsClose[1] < ntsDnBand[1] ? math.min(ntsDnBandRaw, ntsDnBand[1]) : ntsDnBandRaw)

var int ntsTrend = 1
ntsTrend := ntsClose > nz(ntsDnBand[1], ntsDnBand) ? 1 :
     ntsClose < nz(ntsUpBand[1], ntsUpBand) ? -1 :
     ntsTrend[1]

ntsStopLine    = ntsTrend == 1 ? ntsUpBand : ntsDnBand
ntsBuyTrendOk  = ntsTrend == 1
ntsSellTrendOk = ntsTrend == -1

// ============================================================================
//  ▍مشتقات پایه: سویینگ، فیبوناچی، KD، واگرایی، نواحی، ابر
// ============================================================================
// --- پیوت‌های سویینگ (با تأخیر طبیعی swingLen کندل در تشخیص) ---
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow (low,  swingLen, swingLen)

var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

ntsSwingKaf   = not na(pl)   // کف سویینگ
ntsSwingSaghf = not na(ph)   // سقف سویینگ

// --- ناحیه فیبوناچی OTE ---
fibRangeRaw = nz(lastPH, close) - nz(lastPL, close)
fibRange    = fibRangeRaw > 0 ? fibRangeRaw : na
ntsFib1     = nz(lastPL, close) + nz(fibRange, 0) * fibLo
ntsFib2     = nz(lastPL, close) + nz(fibRange, 0) * fibHi

inNtsBuyFibBand  = not na(fibRange) and high >= ntsFib1 and low <= ntsFib2
inNtsSellFibBand = not na(fibRange) and high >= ntsFib1 and low <= ntsFib2
ntsFibTouchBuy   = inNtsBuyFibBand  and ntsBuyTrendOk
ntsFibTouchSell  = inNtsSellFibBand and ntsSellTrendOk

// --- KD (استوکاستیک) ---
kRaw         = ta.stoch(close, high, low, kdLen)
kVal         = ta.sma(kRaw, kSmooth)
dVal         = ta.sma(kVal, dSmooth)
kdBuySignal  = ta.crossover (kVal, dVal) and kVal < 45
kdSellSignal = ta.crossunder(kVal, dVal) and kVal > 55

// --- RSI و واگرایی ---
ntsRsiNow = ta.rsi(close, rsiLen)
plRsi     = ta.pivotlow (ntsRsiNow, swingLen, swingLen)
phRsi     = ta.pivothigh(ntsRsiNow, swingLen, swingLen)

var float prevPlPrice = na
var float prevPlRsi   = na
var float prevPhPrice = na
var float prevPhRsi   = na

ntsDivBuy  = false
ntsDivSell = false
if not na(pl)
    if not na(prevPlPrice) and pl < prevPlPrice and ntsRsiNow[swingLen] > prevPlRsi
        ntsDivBuy := true
    prevPlPrice := pl
    prevPlRsi   := ntsRsiNow[swingLen]
if not na(ph)
    if not na(prevPhPrice) and ph > prevPhPrice and ntsRsiNow[swingLen] < prevPhRsi
        ntsDivSell := true
    prevPhPrice := ph
    prevPhRsi   := ntsRsiNow[swingLen]

// --- تأییدیه جهت (BOS یا دیسپلیسمنت) ---
bosUp   = ta.crossover (close, nz(lastPH, close))
bosDown = ta.crossunder(close, nz(lastPL, close))
displacementUp   = close > open and close > high[1] + 0.5 * atrSeed
displacementDown = close < open and close < low[1]  - 0.5 * atrSeed
bullishConfirmation = bosUp   or displacementUp
bearishConfirmation = bosDown or displacementDown

// --- نواحی عرضه و تقاضا ---
supplyTop = nz(lastPH, high)
supplyBot = supplyTop - nz(fibRange, high * 0.001) * 0.10
demandBot = nz(lastPL, low)
demandTop = demandBot + nz(fibRange, low * 0.001) * 0.10
inSupplyZone = close >= supplyBot and close <= supplyTop
inDemandZone = close >= demandBot and close <= demandTop

// --- نوسان نسبی و سطح تعادلی روزانه ---
volatilityRatio = atrSeed / close * 100

dHighPrev = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_off)
dLowPrev  = request.security(syminfo.tickerid, "D", low[1],  barmerge.gaps_off, barmerge.lookahead_off)
eqLevel   = (nz(dHighPrev, high) + nz(dLowPrev, low)) / 2

// --- پایه ابر ریورسال ---
cloudBasis = ta.ema(close, 50)
cloudRange = ta.atr(20)

// ============================================================================
//  ▍M05 — بهبود ۵: Reversal Cloud پویا بر اساس نوسان
// ============================================================================
// نوسان بالا → ابر پهن‌تر (تا ۱.۲۴×) | نوسان پایین → ابر باریک‌تر (تا ۰.۹۰×)
bandDev1Dynamic = bandDev1 * (0.8 + atrNorm * 0.2)
bandDev2Dynamic = bandDev2 * (0.8 + atrNorm * 0.2)
bandDev3Dynamic = bandDev3 * (0.8 + atrNorm * 0.2)

upperCloud1 = cloudBasis + cloudRange * bandDev1Dynamic
upperCloud2 = cloudBasis + cloudRange * bandDev2Dynamic
upperCloud3 = cloudBasis + cloudRange * bandDev3Dynamic

lowerCloud1 = cloudBasis - cloudRange * bandDev1Dynamic
lowerCloud2 = cloudBasis - cloudRange * bandDev2Dynamic
lowerCloud3 = cloudBasis - cloudRange * bandDev3Dynamic

inRevSellZone = high  >= upperCloud1
inRevBuyZone  = low   <= lowerCloud1
inRevSellDeep = close >= upperCloud2
inRevBuyDeep  = close <= lowerCloud2

// تماس با ابر در ۱۲ کندل اخیر (نه الزاماً همان کندل سیگنال)
revBuyRecent  = ta.lowest (low,  12) <= lowerCloud1
revSellRecent = ta.highest(high, 12) >= upperCloud1

revBuyOk  = not useReversalCloudFilter or inRevBuyZone  or revBuyRecent
revSellOk = not useReversalCloudFilter or inRevSellZone or revSellRecent

// ============================================================================
//  ▍M04 — بهبود ۴: فیلتر سشن و نوسان برای XAUUSD
// ============================================================================
// لندن ۰۳:۰۰→۱۲:۰۰ | نیویورک ۱۲:۰۰→۱۷:۰۰ | سشن طلایی = همپوشانی ۱۲:۰۰→۱۷:۰۰
xauNyHour     = hour(time, "America/New_York")
xauInSession  = not useSessionFilter or (xauNyHour >= 3 and xauNyHour < 17)
xauGoldenHour = xauNyHour >= 12 and xauNyHour < 17
xauVolOk      = (autoTuneThisChart and atrNorm >= 0.62) or volatilityRatio >= xauMinAtrPctEff
xauTradeOk    = xauInSession and xauVolOk
ntsGoldenHourBonus = xauGoldenHour ? 8 : 0

// ============================================================================
//  ▍M07a — بهبود ۷ (الف): ناحیه روزانه و حجم
//  (باید «قبل از» M06 بیاید، چون امتیازدهی به این سه متغیر وابسته است)
// ============================================================================
inDailyDiscount = close <= eqLevel
inDailyPremium  = close >= eqLevel
ntsVolBoost     = volume > ta.sma(volume, 20) * 1.05
// اگر فید نماد شما حجم ندارد، این خط را به `ntsVolBoost = true` تغییر دهید.

// ============================================================================
//  ▍M10 — بهبود ۱۰: خطوط روندِ اصولیِ پرایس‌اکشن + Previous Daily Premium/Discount
//  محل درج: «بعد از» M07a و «قبل از» M06
//  دلیلِ ترتیب: امتیازدهیِ M06 به tlAtSupport / tlAtResistance وابسته است،
//  اما این ماژول به هیچ خروجیِ M06 نیاز ندارد و کاملاً خودکفاست.
// ============================================================================
//  بخش الف — ناحیهٔ روزانهٔ قبل : Previous Daily Premium / Discount
// ============================================================================
tlPdHighRaw = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_off)
tlPdLowRaw  = request.security(syminfo.tickerid, "D", low[1],  barmerge.gaps_off, barmerge.lookahead_off)
tlPdHigh    = nz(tlPdHighRaw, high)
tlPdLow     = nz(tlPdLowRaw,  low)
tlPdEq      = (tlPdHigh + tlPdLow) / 2

// بالای تعادل = پریمیوم (فروش) | پایین تعادل = دیسکانت (خرید)
pdInPremium  = close > tlPdEq
pdInDiscount = close < tlPdEq

// ناحیهٔ PD در «خودِ کندلِ پیوت» (نه کندل جاری) — چون تاخیرِ پیوت مقداری ثابت است،
// دسترسی به تاریخچه با اندیسِ ساده مجاز است و ناحیه دقیقاً همان لحظه سنجیده می‌شود
tlPdEqBar   = tlPdEq[tlPivotRight]
tlPdPremBar = close[tlPivotRight] > tlPdEqBar
tlPdDiscBar = close[tlPivotRight] < tlPdEqBar

// نمایش نواحی
pPdHi = plot(showPdZones ? tlPdHigh : na, "PDH — سقف روز قبل",
     color=color.new(color.gray, 20), style=plot.style_linebr, linewidth=1)
pPdEq = plot(showPdZones ? tlPdEq   : na, "تعادل روز قبل (50%)",
     color=color.new(color.orange, 10), style=plot.style_linebr, linewidth=1)
pPdLo = plot(showPdZones ? tlPdLow  : na, "PDL — کف روز قبل",
     color=color.new(color.gray, 20), style=plot.style_linebr, linewidth=1)
fill(pPdHi, pPdEq, color=color.new(color.red, 93),   title="پریمیوم روز قبل")
fill(pPdEq, pPdLo, color=color.new(color.green, 93), title="دیسکانت روز قبل")

// ============================================================================
//  بخش ب — سقف‌ها و کف‌ها (پیوت‌های تاییدشده)
// ============================================================================
// پیوت با tlPivotRight کندل تاخیر تایید می‌شود؛ یعنی خط هرگز بازترسیم نمی‌شود
tlPH        = ta.pivothigh(high, tlPivotLeft, tlPivotRight)
tlPL        = ta.pivotlow (low,  tlPivotLeft, tlPivotRight)
tlPhBar     = bar_index - tlPivotRight
tlPlBar     = bar_index - tlPivotRight
// منبعِ سنجش در کندلِ خودِ پیوت (کلوزِ کندل پیوت یا سایه‌ی آن)
tlPhSrc     = tlTouchBasis == "کلوز" ? close[tlPivotRight] : tlPH
tlPlSrc     = tlTouchBasis == "کلوز" ? close[tlPivotRight] : tlPL

tlAtr    = ta.atr(14)
tlTolVal = tlTolAtr   * tlAtr
tlBrkVal = tlBreakAtr * tlAtr

// منبعِ سنجش برای شکست روی کندل جاری
tlSrcUp = tlTouchBasis == "کلوز" ? close : high
tlSrcDn = tlTouchBasis == "کلوز" ? close : low

// مقدارِ خط در یک کندلِ دلخواه (درون‌یابی خطیِ دو نقطه)
fLineY(x1, y1, x2, y2, xTarget) =>
    tlDx = x2 - x1
    tlDx != 0 ? y1 + (y2 - y1) * (xTarget - x1) / tlDx : float(na)

// ============================================================================
//  بخش ج — حافظهٔ خطوط
// ============================================================================
// --- خط نزولی : اتصال سقف‌های پایین‌تر (مقاومت پویا) ---
var int[]   tlDnBarArr = array.new_int()
var float[] tlDnPxArr  = array.new_float()
var int     tlDnX1     = na
var float   tlDnY1     = na
var int     tlDnX2     = na
var float   tlDnY2     = na
var bool    tlDnLive   = false
var bool    tlDnAlign  = false
var int     tlDnKillX  = na
var float   tlDnKillY  = na
var line    tlDnObj    = na
var line[]  tlDnHist   = array.new_line()

// --- خط صعودی : اتصال کف‌های بالاتر (حمایت پویا) ---
var int[]   tlUpBarArr = array.new_int()
var float[] tlUpPxArr  = array.new_float()
var int     tlUpX1     = na
var float   tlUpY1     = na
var int     tlUpX2     = na
var float   tlUpY2     = na
var bool    tlUpLive   = false
var bool    tlUpAlign  = false
var int     tlUpKillX  = na
var float   tlUpKillY  = na
var line    tlUpObj    = na
var line[]  tlUpHist   = array.new_line()

var label[] tlLabHist  = array.new_label()

// رنگ‌ها
tlColDn     = color.new(color.red, 0)
tlColDnWeak = color.new(color.red, 70)
tlColUp     = color.new(color.teal, 0)
tlColUpWeak = color.new(color.teal, 70)
tlColDead   = color.new(color.gray, 50)

// رویدادهای یک‌کندلی (هر بار از نو)
tlDnBreakNow = false
tlUpBreakNow = false
tlDnNewTouch = false
tlUpNewTouch = false

tlDnHits = array.size(tlDnBarArr)
tlUpHits = array.size(tlUpBarArr)
// نکته: این دو بعد از پردازشِ پیوتِ همین کندل دوباره به‌روز می‌شوند (پایین‌تر)

// ============================================================================
//  بخش د — پردازشِ پیوتِ سقف جدید  →  خط روند نزولی
// ============================================================================
if showTrendlines and not na(tlPH)
    tlPx = tlPH                                   // anchor همیشه نوک سایه است
    tlBx = tlPhBar
    tlSc = tlPhSrc                                // منبع سنجش در کندل پیوت
    if tlDnHits == 0
        // اولین سقفِ چارچوب
        array.push(tlDnBarArr, tlBx)
        array.push(tlDnPxArr,  tlPx)
        tlDnX1   := tlBx
        tlDnY1   := tlPx
        tlDnLive := false
    else
        if tlDnHits == 1
            if tlPx < tlDnY1
                if tlPdMode != "فقط همسو" or tlPdPremBar
                    array.push(tlDnBarArr, tlBx)
                    array.push(tlDnPxArr,  tlPx)
                    tlDnX2      := tlBx
                    tlDnY2      := tlPx
                    tlDnLive    := true
                    tlDnAlign   := tlPdPremBar
                    tlDnNewTouch := true
            else
                // سقف بالاتر = ساختار نزولی نداریم؛ از نو شروع می‌کنیم
                array.clear(tlDnBarArr)
                array.clear(tlDnPxArr)
                array.push(tlDnBarArr, tlBx)
                array.push(tlDnPxArr,  tlPx)
                tlDnX1   := tlBx
                tlDnY1   := tlPx
                tlDnLive := false
        else
            tlYAt = fLineY(tlDnX1, tlDnY1, tlDnX2, tlDnY2, tlBx)
            if na(tlYAt)
                array.clear(tlDnBarArr)
                array.clear(tlDnPxArr)
                tlDnLive := false
            else
                if tlSc > tlYAt + tlBrkVal
                    // ============ ابطال: سقفِ جدید بالای خط بسته شد ============
                    tlDnKillX    := tlBx
                    tlDnKillY    := tlYAt
                    tlDnLive     := false
                    tlDnBreakNow := true
                    array.clear(tlDnBarArr)
                    array.clear(tlDnPxArr)
                    if tlPx >= tlDnY2
                        // سقفِ جدید از آخرین سقف بالاتر است: تک‌نقطه از نو
                        array.push(tlDnBarArr, tlBx)
                        array.push(tlDnPxArr,  tlPx)
                        tlDnX1 := tlBx
                        tlDnY1 := tlPx
                    else
                        // هنوز سقفِ پایین‌تر است: خطِ جدید از آخرین سقف تا این سقف
                        array.push(tlDnBarArr, tlDnX2)
                        array.push(tlDnPxArr,  tlDnY2)
                        array.push(tlDnBarArr, tlBx)
                        array.push(tlDnPxArr,  tlPx)
                        tlDnX1 := tlDnX2
                        tlDnY1 := tlDnY2
                        tlDnX2 := tlBx
                        tlDnY2 := tlPx
                        tlDnLive  := true
                        tlDnAlign := tlPdPremBar
                else
                    // ===================== بررسیِ لمسِ معتبر =====================
                    tlNeedRe = false
                    if tlPx <= tlYAt + tlTolVal
                        // شرطِ هال: هیچ سقفِ قبلی نباید بالاتر از خطِ کاندید بایستد
                        tlHullOk = tlPdMode != "فقط همسو" or tlPdPremBar
                        for tlI = 0 to array.size(tlDnBarArr) - 1
                            tlYY = fLineY(tlDnX1, tlDnY1, tlBx, tlPx, array.get(tlDnBarArr, tlI))
                            if not na(tlYY) and array.get(tlDnPxArr, tlI) > tlYY + tlTolVal
                                tlHullOk := false
                        if tlHullOk
                            array.push(tlDnBarArr, tlBx)
                            array.push(tlDnPxArr,  tlPx)
                            tlDnX2 := tlBx
                            tlDnY2 := tlPx
                            tlDnAlign := tlDnAlign or tlPdPremBar
                            tlDnNewTouch := true
                        else
                            tlNeedRe := true
                    else
                        tlNeedRe := true

                    if tlNeedRe and tlReanchor and tlPx < tlDnY2
                        // خطِ فعلی با ساختار هم‌خوان نیست: از دو سقفِ آخر بازترسیم می‌شود
                        // (اگر خط تاییدشده بود، ابتدا بایگانی می‌شود تا روی چارت بماند)
                        if array.size(tlDnBarArr) >= 3 and not na(tlDnObj)
                            line.set_extend(tlDnObj, extend.none)
                            line.set_xy2(tlDnObj, tlDnX2, tlDnY2)
                            line.set_color(tlDnObj, tlColDead)
                            line.set_style(tlDnObj, line.style_dotted)
                            line.set_width(tlDnObj, 1)
                            array.push(tlDnHist, tlDnObj)
                            if array.size(tlDnHist) > tlMaxLines
                                line.delete(array.shift(tlDnHist))
                            tlDnObj := na
                        array.clear(tlDnBarArr)
                        array.clear(tlDnPxArr)
                        array.push(tlDnBarArr, tlDnX2)
                        array.push(tlDnPxArr,  tlDnY2)
                        array.push(tlDnBarArr, tlBx)
                        array.push(tlDnPxArr,  tlPx)
                        tlDnX1 := tlDnX2
                        tlDnY1 := tlDnY2
                        tlDnX2 := tlBx
                        tlDnY2 := tlPx
                        tlDnAlign := tlPdPremBar

// ============================================================================
//  بخش هـ — پردازشِ پیوتِ کف جدید  →  خط روند صعودی
// ============================================================================
if showTrendlines and not na(tlPL)
    tlQx = tlPL
    tlQb = tlPlBar
    tlQs = tlPlSrc
    if tlUpHits == 0
        array.push(tlUpBarArr, tlQb)
        array.push(tlUpPxArr,  tlQx)
        tlUpX1   := tlQb
        tlUpY1   := tlQx
        tlUpLive := false
    else
        if tlUpHits == 1
            if tlQx > tlUpY1
                if tlPdMode != "فقط همسو" or tlPdDiscBar
                    array.push(tlUpBarArr, tlQb)
                    array.push(tlUpPxArr,  tlQx)
                    tlUpX2      := tlQb
                    tlUpY2      := tlQx
                    tlUpLive    := true
                    tlUpAlign   := tlPdDiscBar
                    tlUpNewTouch := true
            else
                array.clear(tlUpBarArr)
                array.clear(tlUpPxArr)
                array.push(tlUpBarArr, tlQb)
                array.push(tlUpPxArr,  tlQx)
                tlUpX1   := tlQb
                tlUpY1   := tlQx
                tlUpLive := false
        else
            tlUAt = fLineY(tlUpX1, tlUpY1, tlUpX2, tlUpY2, tlQb)
            if na(tlUAt)
                array.clear(tlUpBarArr)
                array.clear(tlUpPxArr)
                tlUpLive := false
            else
                if tlQs < tlUAt - tlBrkVal
                    // ============ ابطال: کفِ جدید زیر خط بسته شد ============
                    tlUpKillX    := tlQb
                    tlUpKillY    := tlUAt
                    tlUpLive     := false
                    tlUpBreakNow := true
                    array.clear(tlUpBarArr)
                    array.clear(tlUpPxArr)
                    if tlQx <= tlUpY2
                        array.push(tlUpBarArr, tlQb)
                        array.push(tlUpPxArr,  tlQx)
                        tlUpX1 := tlQb
                        tlUpY1 := tlQx
                    else
                        array.push(tlUpBarArr, tlUpX2)
                        array.push(tlUpPxArr,  tlUpY2)
                        array.push(tlUpBarArr, tlQb)
                        array.push(tlUpPxArr,  tlQx)
                        tlUpX1 := tlUpX2
                        tlUpY1 := tlUpY2
                        tlUpX2 := tlQb
                        tlUpY2 := tlQx
                        tlUpLive  := true
                        tlUpAlign := tlPdDiscBar
                else
                    // ===================== بررسیِ لمسِ معتبر =====================
                    tlNeedUp = false
                    if tlQx >= tlUAt - tlTolVal
                        // شرطِ هال: هیچ کفِ قبلی نباید پایین‌تر از خطِ کاندید بایستد
                        tlUHullOk = tlPdMode != "فقط همسو" or tlPdDiscBar
                        for tlJ = 0 to array.size(tlUpBarArr) - 1
                            tlUU = fLineY(tlUpX1, tlUpY1, tlQb, tlQx, array.get(tlUpBarArr, tlJ))
                            if not na(tlUU) and array.get(tlUpPxArr, tlJ) < tlUU - tlTolVal
                                tlUHullOk := false
                        if tlUHullOk
                            array.push(tlUpBarArr, tlQb)
                            array.push(tlUpPxArr,  tlQx)
                            tlUpX2 := tlQb
                            tlUpY2 := tlQx
                            tlUpAlign := tlUpAlign or tlPdDiscBar
                            tlUpNewTouch := true
                        else
                            tlNeedUp := true
                    else
                        tlNeedUp := true

                    if tlNeedUp and tlReanchor and tlQx > tlUpY2
                        if array.size(tlUpBarArr) >= 3 and not na(tlUpObj)
                            line.set_extend(tlUpObj, extend.none)
                            line.set_xy2(tlUpObj, tlUpX2, tlUpY2)
                            line.set_color(tlUpObj, tlColDead)
                            line.set_style(tlUpObj, line.style_dotted)
                            line.set_width(tlUpObj, 1)
                            array.push(tlUpHist, tlUpObj)
                            if array.size(tlUpHist) > tlMaxLines
                                line.delete(array.shift(tlUpHist))
                            tlUpObj := na
                        array.clear(tlUpBarArr)
                        array.clear(tlUpPxArr)
                        array.push(tlUpBarArr, tlUpX2)
                        array.push(tlUpPxArr,  tlUpY2)
                        array.push(tlUpBarArr, tlQb)
                        array.push(tlUpPxArr,  tlQx)
                        tlUpX1 := tlUpX2
                        tlUpY1 := tlUpY2
                        tlUpX2 := tlQb
                        tlUpY2 := tlQx
                        tlUpAlign := tlPdDiscBar

// ============================================================================
//  بخش و — مقدارِ لحظه‌ایِ خطوط و بررسی شکست روی کندل جاری
// ============================================================================
// بعد از پردازشِ پیوتِ همین کندل، شمارنده‌ها بازخوانی می‌شوند
tlDnHits := array.size(tlDnBarArr)
tlUpHits := array.size(tlUpBarArr)

tlDnYNow = (tlDnLive and tlDnHits >= 2) ? fLineY(tlDnX1, tlDnY1, tlDnX2, tlDnY2, bar_index) : float(na)
tlUpYNow = (tlUpLive and tlUpHits >= 2) ? fLineY(tlUpX1, tlUpY1, tlUpX2, tlUpY2, bar_index) : float(na)

if showTrendlines
    // شکستِ مقاومتِ پویا با کلوز (یا سایه) بالای خط
    if tlDnLive and not na(tlDnYNow) and bar_index > tlDnX2 and tlSrcUp > tlDnYNow + tlBrkVal
        tlDnKillX    := bar_index
        tlDnKillY    := tlDnYNow
        tlDnLive     := false
        tlDnBreakNow := true
        array.clear(tlDnBarArr)
        array.clear(tlDnPxArr)
        array.push(tlDnBarArr, bar_index)
        array.push(tlDnPxArr,  high)
        tlDnX1 := bar_index
        tlDnY1 := high
        tlDnX2 := bar_index
        tlDnY2 := high
    // شکستِ حمایتِ پویا با کلوز (یا سایه) زیر خط
    if tlUpLive and not na(tlUpYNow) and bar_index > tlUpX2 and tlSrcDn < tlUpYNow - tlBrkVal
        tlUpKillX    := bar_index
        tlUpKillY    := tlUpYNow
        tlUpLive     := false
        tlUpBreakNow := true
        array.clear(tlUpBarArr)
        array.clear(tlUpPxArr)
        array.push(tlUpBarArr, bar_index)
        array.push(tlUpPxArr,  low)
        tlUpX1 := bar_index
        tlUpY1 := low
        tlUpX2 := bar_index
        tlUpY2 := low

// ============================================================================
//  بخش ز — ترسیم و بایگانی
// ============================================================================
if showTrendlines
    // ---------- خط نزولی ----------
    if tlDnLive and array.size(tlDnBarArr) >= tlMinTouches
        tlColD = (tlPdMode == "بدون فیلتر" or tlDnAlign) ? tlColDn : tlColDnWeak
        tlStlD = array.size(tlDnBarArr) >= 3 ? line.style_solid : line.style_dashed
        tlWidD = array.size(tlDnBarArr) >= 3 ? 2 : 1
        if na(tlDnObj)
            tlDnObj := line.new(tlDnX1, tlDnY1, tlDnX2, tlDnY2, xloc=xloc.bar_index,
                 extend=extend.right, color=tlColD, style=tlStlD, width=tlWidD)
        else
            line.set_xy1(tlDnObj, tlDnX1, tlDnY1)
            line.set_xy2(tlDnObj, tlDnX2, tlDnY2)
            line.set_color(tlDnObj, tlColD)
            line.set_style(tlDnObj, tlStlD)
            line.set_width(tlDnObj, tlWidD)
            line.set_extend(tlDnObj, extend.right)
    else
        if not na(tlDnObj)
            // نقطهٔ پایانِ خط: محل شکست؛ اگر ثبت نشده بود، آخرین لنگر
            tlEndX = not na(tlDnKillX) ? tlDnKillX : tlDnX2
            tlEndY = not na(tlDnKillY) ? tlDnKillY : tlDnY2
            if not na(tlEndX) and not na(tlEndY)
                line.set_extend(tlDnObj, extend.none)
                line.set_xy2(tlDnObj, tlEndX, tlEndY)
                line.set_color(tlDnObj, tlColDead)
                line.set_style(tlDnObj, line.style_dotted)
                line.set_width(tlDnObj, 1)
                array.push(tlDnHist, tlDnObj)
                if array.size(tlDnHist) > tlMaxLines
                    line.delete(array.shift(tlDnHist))
            else
                line.delete(tlDnObj)
            tlDnObj   := na
            tlDnKillX := na
            tlDnKillY := na

    // ---------- خط صعودی ----------
    if tlUpLive and array.size(tlUpBarArr) >= tlMinTouches
        tlColU = (tlPdMode == "بدون فیلتر" or tlUpAlign) ? tlColUp : tlColUpWeak
        tlStlU = array.size(tlUpBarArr) >= 3 ? line.style_solid : line.style_dashed
        tlWidU = array.size(tlUpBarArr) >= 3 ? 2 : 1
        if na(tlUpObj)
            tlUpObj := line.new(tlUpX1, tlUpY1, tlUpX2, tlUpY2, xloc=xloc.bar_index,
                 extend=extend.right, color=tlColU, style=tlStlU, width=tlWidU)
        else
            line.set_xy1(tlUpObj, tlUpX1, tlUpY1)
            line.set_xy2(tlUpObj, tlUpX2, tlUpY2)
            line.set_color(tlUpObj, tlColU)
            line.set_style(tlUpObj, tlStlU)
            line.set_width(tlUpObj, tlWidU)
            line.set_extend(tlUpObj, extend.right)
    else
        if not na(tlUpObj)
            tlEndU = not na(tlUpKillX) ? tlUpKillX : tlUpX2
            tlEndV = not na(tlUpKillY) ? tlUpKillY : tlUpY2
            if not na(tlEndU) and not na(tlEndV)
                line.set_extend(tlUpObj, extend.none)
                line.set_xy2(tlUpObj, tlEndU, tlEndV)
                line.set_color(tlUpObj, tlColDead)
                line.set_style(tlUpObj, line.style_dotted)
                line.set_width(tlUpObj, 1)
                array.push(tlUpHist, tlUpObj)
                if array.size(tlUpHist) > tlMaxLines
                    line.delete(array.shift(tlUpHist))
            else
                line.delete(tlUpObj)
            tlUpObj   := na
            tlUpKillX := na
            tlUpKillY := na

    // ---------- برچسب‌ها ----------
    if showTlLabels
        if tlDnNewTouch
            tlLb = label.new(tlDnX2, tlDnY2 + tlAtr * 0.6,
                 "سقف " + str.tostring(array.size(tlDnBarArr)),
                 xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_center,
                 color=tlDnAlign ? color.new(color.red, 20) : color.new(color.gray, 30),
                 textcolor=color.white, size=size.tiny)
            array.push(tlLabHist, tlLb)
        if tlUpNewTouch
            tlLu = label.new(tlUpX2, tlUpY2 - tlAtr * 0.6,
                 "کف " + str.tostring(array.size(tlUpBarArr)),
                 xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_center,
                 color=tlUpAlign ? color.new(color.teal, 20) : color.new(color.gray, 30),
                 textcolor=color.white, size=size.tiny)
            array.push(tlLabHist, tlLu)
        if tlDnBreakNow
            tlLd = label.new(bar_index, high + tlAtr * 0.8, "شکست خط نزولی",
                 xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_center,
                 color=color.new(color.lime, 20), textcolor=color.black, size=size.tiny)
            array.push(tlLabHist, tlLd)
        if tlUpBreakNow
            tlLv = label.new(bar_index, low - tlAtr * 0.8, "شکست خط صعودی",
                 xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_center,
                 color=color.new(color.maroon, 20), textcolor=color.white, size=size.tiny)
            array.push(tlLabHist, tlLv)
        while array.size(tlLabHist) > 60
            label.delete(array.shift(tlLabHist))
else
    if not na(tlDnObj)
        line.delete(tlDnObj)
        tlDnObj := na
    if not na(tlUpObj)
        line.delete(tlUpObj)
        tlUpObj := na

// ============================================================================
//  بخش ح — خروجی‌های قابل‌استفاده در امتیازدهی Confluence
// ============================================================================
// نزدیکیِ قیمت به خطِ روندِ فعال (حمایت برای خرید، مقاومت برای فروش)
tlAtSupport    = not na(tlUpYNow) and tlSrcDn >= tlUpYNow - tlTolVal and tlSrcDn <= tlUpYNow + tlTolVal * 2.0
tlAtResistance = not na(tlDnYNow) and tlSrcUp <= tlDnYNow + tlTolVal and tlSrcUp >= tlDnYNow - tlTolVal * 2.0
tlDnConfirmed  = tlDnLive and array.size(tlDnBarArr) >= 3
tlUpConfirmed  = tlUpLive and array.size(tlUpBarArr) >= 3

// --- هشدارها ---
alertcondition(tlDnBreakNow, title="PA — شکست خط روند نزولی (BOS صعودی)",
     message="شکست خط روند نزولی روی {{ticker}} — کلوز {{close}}")
alertcondition(tlUpBreakNow, title="PA — شکست خط روند صعودی (BOS نزولی)",
     message="شکست خط روند صعودی روی {{ticker}} — کلوز {{close}}")
alertcondition(tlDnNewTouch, title="PA — لمس جدید روی خط روند نزولی",
     message="لمس جدید روی خط روند نزولی {{ticker}} — تعداد لمس ها افزایش یافت")
alertcondition(tlUpNewTouch, title="PA — لمس جدید روی خط روند صعودی",
     message="لمس جدید روی خط روند صعودی {{ticker}} — تعداد لمس ها افزایش یافت")

// ============================================================================
//  ▍M06 — بهبود ۶: سیستم امتیازدهی Confluence
//  حداکثر امتیاز ممکن: ۱۵۱ (۱۱۰ پایه + ۳۷ جدید + ۴ عمق ابر) + امتیاز خط روند (M10)
// ============================================================================
ntsBuyConfluencePts =
     (ntsFibTouchBuy      ? 32 : inNtsBuyFibBand ? 14 : 0) +
     (revBuyOk            ? 14 : 0) +
     (ntsDivBuy           ? 18 : ntsRsiNow <= 35 ? 11 : 0) +
     (kdBuySignal         ? 10 : 0) +
     (bullishConfirmation ? 14 : 0) +
     (ntsBuyTrendOk       ? 8  : 0) +
     (ntsSwingKaf         ? 10 : 0) +
     (ntsVolBoost         ? 4  : 0)

ntsBuyConfluencePts +=
     (inDailyDiscount ? 10 : 0) +                                            // ناحیه تخفیف روزانه
     (ntsGoldenHourBonus) +                                                  // سشن طلایی لندن/نیویورک
     (ntsTrend == 1 and adxForNts >= ntsStrongAdx ? 6 : 0) +                 // روند قوی هم‌راستا
     (close > ntsFib1 and close > ntsFib2 ? 5 : 0) +                         // بالای فیب‌های کلیدی
     (ta.crossover(close, ntsFib1) or ta.crossover(close, ntsFib2) ? 8 : 0) + // کراس‌اور لحظه‌ای
     (tlAtSupport ? tlBonus : 0) +                                           // روی حمایت پویا (خط روند صعودی)
     (inRevBuyDeep ? 4 : 0)                                                  // عمق قرارگیری در ابر

ntsSellConfluencePts =
     (ntsFibTouchSell      ? 32 : inNtsSellFibBand ? 14 : 0) +
     (revSellOk            ? 14 : 0) +
     (ntsDivSell           ? 18 : ntsRsiNow >= 65 ? 11 : 0) +
     (kdSellSignal         ? 10 : 0) +
     (bearishConfirmation  ? 14 : 0) +
     (ntsSellTrendOk       ? 8  : 0) +
     (ntsSwingSaghf        ? 10 : 0) +
     (ntsVolBoost          ? 4  : 0)

ntsSellConfluencePts +=
     (inDailyPremium ? 10 : 0) +                                             // ناحیه پریمیوم روزانه
     (ntsGoldenHourBonus) +                                                  // سشن طلایی لندن/نیویورک
     (ntsTrend == -1 and adxForNts >= ntsStrongAdx ? 6 : 0) +                // روند قوی هم‌راستا
     (close < ntsFib1 and close < ntsFib2 ? 5 : 0) +                         // پایین فیب‌های کلیدی
     (ta.crossunder(close, ntsFib1) or ta.crossunder(close, ntsFib2) ? 8 : 0) + // کراس‌آندر لحظه‌ای
     (tlAtResistance ? tlBonus : 0) +                                        // روی مقاومت پویا (خط روند نزولی)
     (inRevSellDeep ? 4 : 0)                                                 // عمق قرارگیری در ابر

// آستانه‌های پویا بر اساس حالت تریدینگ
ntsBuyThreshold = ntsTradingMode == "اسکالپینگ"      ? 55 :
     ntsTradingMode == "ترید روزانه"                 ? 58 :
     ntsTradingMode == "سوینگ تریدینگ"               ? 62 :
     65

ntsSellThreshold = ntsTradingMode == "اسکالپینگ"     ? 55 :
     ntsTradingMode == "ترید روزانه"                 ? 58 :
     ntsTradingMode == "سوینگ تریدینگ"               ? 62 :
     65

// ============================================================================
//  ▍M07b — بهبود ۷ (ب): سیگنال‌های نهایی
// ============================================================================
ntsKafSignal   = xauTradeOk and ntsFibTouchBuy  and ntsSwingKaf   and ntsBuyConfluencePts  >= ntsBuyThreshold
ntsSaghfSignal = xauTradeOk and ntsFibTouchSell and ntsSwingSaghf and ntsSellConfluencePts >= ntsSellThreshold

finalBuySignal =
     ntsTrend == 1           and
     bullishConfirmation     and
     kdBuySignal             and
     not inSupplyZone        and
     revBuyOk                and
     xauTradeOk              and
     (inNtsBuyFibBand or ntsFibTouchBuy) and
     (not useDailyZoneFilter or inDailyDiscount)

finalSellSignal =
     ntsTrend == -1          and
     bearishConfirmation     and
     kdSellSignal            and
     not inDemandZone        and
     revSellOk               and
     xauTradeOk              and
     (inNtsSellFibBand or ntsFibTouchSell) and
     (not useDailyZoneFilter or inDailyPremium)

// ============================================================================
//  ▍نمایش روی چارت
// ============================================================================
stopColor = ntsTrend == 1 ? color.new(color.teal, 0) : color.new(color.red, 0)
plot(ntsStopLine, "NTS Stop", color=stopColor, linewidth=2)

pc1 = plot(lowerCloud1, "Cloud −1", color=color.new(color.aqua, 70))
pc2 = plot(upperCloud1, "Cloud +1", color=color.new(color.fuchsia, 70))
pc3 = plot(lowerCloud2, "Cloud −2", color=color.new(color.aqua, 85))
pc4 = plot(upperCloud2, "Cloud +2", color=color.new(color.fuchsia, 85))
fill(pc1, pc3, color=color.new(color.aqua, 88),    title="ناحیه تقاضای ابر")
fill(pc2, pc4, color=color.new(color.fuchsia, 88), title="ناحیه عرضه ابر")

plot(eqLevel, "تعادل روزانه", color=color.new(color.gray, 40), style=plot.style_linebr)
plot(ntsFib1, "OTE پایین",    color=color.new(color.orange, 50), style=plot.style_linebr)
plot(ntsFib2, "OTE بالا",     color=color.new(color.orange, 50), style=plot.style_linebr)

plotshape(finalBuySignal,  title="خرید نهایی", style=shape.triangleup, location=location.belowbar,
     color=color.new(color.green, 0), size=size.normal, text="BUY")
plotshape(finalSellSignal, title="فروش نهایی", style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 0), size=size.normal, text="SELL")
plotshape(ntsKafSignal,   title="کف NTS", style=shape.labelup, location=location.belowbar,
     color=color.new(color.lime, 0), size=size.tiny, text="KAF", textcolor=color.black)
plotshape(ntsSaghfSignal, title="سقف NTS", style=shape.labeldown, location=location.abovebar,
     color=color.new(color.maroon, 0), size=size.tiny, text="SAGHF", textcolor=color.white)

// ============================================================================
//  ▍M08 — بهبود ۸: پنل اطلاعات و هشدارها
// ============================================================================
var table autoTunePanel = table.new(position.top_right, 2, 15,
     border_width=1, frame_color=color.new(color.gray, 60))

if barstate.islast and showAutoTunePanel
    table.cell(autoTunePanel, 0, 0,  "Mode",     text_color=color.gray,  text_size=size.tiny)
    table.cell(autoTunePanel, 1, 0,  ntsTradingMode, text_color=color.white, text_size=size.tiny)
    table.cell(autoTunePanel, 0, 1,  "Base TF",  text_color=color.gray,  text_size=size.tiny)
    table.cell(autoTunePanel, 1, 1,  ntsBaseTimeframe, text_color=color.white, text_size=size.tiny)
    table.cell(autoTunePanel, 0, 2,  "Symbol",   text_color=color.gray,  text_size=size.tiny)
    table.cell(autoTunePanel, 1, 2,  autoSymbolType, text_color=color.white, text_size=size.tiny)
    table.cell(autoTunePanel, 0, 3,  "Period",   text_color=color.gray,  text_size=size.tiny)
    table.cell(autoTunePanel, 1, 3,  str.tostring(ntsPeriodFinal, "#"), text_color=color.white, text_size=size.tiny)
    table.cell(autoTunePanel, 0, 4,  "Factor",   text_color=color.gray,  text_size=size.tiny)
    table.cell(autoTunePanel, 1, 4,  str.tostring(ntsFactorFinal, "#.#"), text_color=color.white, text_size=size.tiny)
    table.cell(autoTunePanel, 0, 5,  "ATR Norm", text_color=color.gray,  text_size=size.tiny)
    table.cell(autoTunePanel, 1, 5,  str.tostring(atrNorm, "#.##"), text_color=color.white, text_size=size.tiny)
    table.cell(autoTunePanel, 0, 6,  "Regime",   text_color=color.gray,  text_size=size.tiny)
    table.cell(autoTunePanel, 1, 6,  chopRegime ? "CHOP" : trendRegime ? "TREND" : "NEUTRAL",
         text_color = chopRegime ? color.orange : trendRegime ? color.lime : color.gray,
         text_size  = size.tiny)
    table.cell(autoTunePanel, 0, 7,  "Session",  text_color=color.gray,  text_size=size.tiny)
    table.cell(autoTunePanel, 1, 7,  xauGoldenHour ? "GOLDEN" : xauInSession ? "OPEN" : "CLOSED",
         text_color = xauGoldenHour ? color.lime : xauInSession ? color.white : color.gray,
         text_size  = size.tiny)
    table.cell(autoTunePanel, 0, 8,  "Vol OK",   text_color=color.gray,  text_size=size.tiny)
    table.cell(autoTunePanel, 1, 8,  xauVolOk ? "YES" : "NO",
         text_color = xauVolOk ? color.lime : color.red, text_size=size.tiny)

    table.cell(autoTunePanel, 0, 9,  "Buy Pts",  text_color=color.gray, text_size=size.tiny)
    table.cell(autoTunePanel, 1, 9,  str.tostring(ntsBuyConfluencePts, "#") + " / " + str.tostring(ntsBuyThreshold, "#"),
         text_color = ntsBuyConfluencePts >= ntsBuyThreshold ? color.lime : color.orange,
         text_size  = size.tiny)
    table.cell(autoTunePanel, 0, 10, "Sell Pts", text_color=color.gray, text_size=size.tiny)
    table.cell(autoTunePanel, 1, 10, str.tostring(ntsSellConfluencePts, "#") + " / " + str.tostring(ntsSellThreshold, "#"),
         text_color = ntsSellConfluencePts >= ntsSellThreshold ? color.red : color.orange,
         text_size  = size.tiny)
    table.cell(autoTunePanel, 0, 11, "Daily Zone", text_color=color.gray, text_size=size.tiny)
    table.cell(autoTunePanel, 1, 11, inDailyDiscount and not inDailyPremium ? "DISCOUNT" :
         inDailyPremium and not inDailyDiscount ? "PREMIUM" : "EQ",
         text_color = inDailyDiscount and not inDailyPremium ? color.green :
              inDailyPremium and not inDailyDiscount ? color.red : color.gray,
         text_size  = size.tiny)
    table.cell(autoTunePanel, 0, 12, "DI", text_color=color.gray, text_size=size.tiny)
    table.cell(autoTunePanel, 1, 12, dmiPlus > dmiMinus ? "BULL" : "BEAR",
         text_color = dmiPlus > dmiMinus ? color.lime : color.red, text_size=size.tiny)
    table.cell(autoTunePanel, 0, 13, "TL Down", text_color=color.gray, text_size=size.tiny)
    table.cell(autoTunePanel, 1, 13,
         tlDnLive ? str.tostring(tlDnHits, "#") + " touch" + (tlDnConfirmed ? " OK" : "") : "-",
         text_color = tlDnConfirmed ? color.red : color.gray, text_size = size.tiny)
    table.cell(autoTunePanel, 0, 14, "TL Up", text_color=color.gray, text_size=size.tiny)
    table.cell(autoTunePanel, 1, 14,
         tlUpLive ? str.tostring(tlUpHits, "#") + " touch" + (tlUpConfirmed ? " OK" : "") : "-",
         text_color = tlUpConfirmed ? color.teal : color.gray, text_size = size.tiny)

// --- پلات‌های کمکی برای پیام هشدار ---
// در Pine v5 تنها می‌توان به پلات‌های واقعی ارجاع داد؛
// بنابراین {{plot("inDailyDiscount")}} معتبر نیست و از این پلات‌ها استفاده می‌شود.
plot(inDailyDiscount and not inDailyPremium ? 1 : inDailyPremium and not inDailyDiscount ? -1 : 0,
     title="DailyZone", display=display.data_window)
plot(ntsBuyConfluencePts,  title="BuyPts",  display=display.data_window)
plot(ntsSellConfluencePts, title="SellPts", display=display.data_window)

// --- هشدارها ---
alertcondition(finalBuySignal,
     title   = "Final Confirmed BUY (Premium/Discount Filtered)",
     message = "Final BUY on {{ticker}} at {{close}} | Zone: {{plot(\"DailyZone\")}} | Pts: {{plot(\"BuyPts\")}}")
alertcondition(finalSellSignal,
     title   = "Final Confirmed SELL (Premium/Discount Filtered)",
     message = "Final SELL on {{ticker}} at {{close}} | Zone: {{plot(\"DailyZone\")}} | Pts: {{plot(\"SellPts\")}}")
alertcondition(ntsKafSignal,
     title   = "NTS Floor (Kaf) Confluence",
     message = "NTS KAF on {{ticker}} at {{close}} | Pts: {{plot(\"BuyPts\")}}")
alertcondition(ntsSaghfSignal,
     title   = "NTS Ceiling (Saghf) Confluence",
     message = "NTS SAGHF on {{ticker}} at {{close}} | Pts: {{plot(\"SellPts\")}}")
